{
  "name": "cassiancreed-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run analytics:check && npm run canon:check && npm run calendar:check && npm run archive:check && npm run intl:check && npm run missing:check && npm run posts:check && astro build && npm run site:check",
    "preview": "astro preview",
    "calendar:check": "node scripts/validate-court-calendar.mjs",
    "archive:check": "node scripts/validate-court-calendar-archive.mjs",
    "intl:check": "node scripts/validate-international-watch.mjs",
    "missing:check": "node scripts/validate-missing-persons.mjs",
    "posts:check": "node scripts/validate-post-archive.mjs",
    "site:check": "node scripts/validate-site.mjs",
    "canon:check": "node scripts/validate-case-handling-canon.mjs",
    "court-command:check": "node scripts/validate-court-command-bundle.mjs",
    "signup-webhook:test": "node --test scripts/test-signup-webhook.mjs",
    "analytics:check": "npm run signup-webhook:test"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^4.16.0",
    "leaflet": "^1.9.4",
    "svix": "^1.99.0"
  }
}
