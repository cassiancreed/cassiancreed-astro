---
// Public source-count label for one calendar row. Confirmed rows and rows
// whose sources do not clearly earn a tier render nothing.
// Badge sits inline beside nearby text — not a padded block.
import { CORRECTION_MAILTO } from '../data/court-calendar-corrections.mjs';
import { certaintyFor } from '../data/certainty.mjs';
import CertaintyBadge from './CertaintyBadge.astro';

const { entry } = Astro.props;
const label = entry?.sourceTierLabel;
const news = entry?.sourceTier === 'news-single';
const level = entry ? (entry.certainty || certaintyFor(entry)) : null;
---
{level && !label && (
  <p class="source-tier source-tier--badge"><CertaintyBadge level={level} checked={entry?.verified || ''} /></p>
)}
{label && (
  <p class="source-tier" data-source-tier={entry.sourceTier}>
    <CertaintyBadge level={level} checked={entry?.verified || ''} /> <strong class="source-tier__label">{label}</strong>
    {news && (
      <span class="source-tier__more">
        Source: <a href={entry.src} target="_blank" rel="noopener noreferrer">{entry.srcLabel}</a>.
        <a href={CORRECTION_MAILTO}>Know something? Tell us</a>
      </span>
    )}
  </p>
)}

<style>
  .source-tier{display:flex;flex-wrap:wrap;align-items:center;gap:4px 6px;margin:0 0 6px;padding:0;border-radius:0;background:transparent;font-size:12px;line-height:1.35;color:var(--ink, inherit)}
  .source-tier--badge{display:inline-flex;margin:0 0 4px}
  .source-tier__label{font-family:var(--mono, ui-monospace, monospace);font-size:10px;letter-spacing:.02em;font-weight:600}
  .source-tier__more{display:inline;margin:0;font-size:11px}
  .source-tier a{color:var(--accent, #A8503A)}
  @media (min-width:768px){
    .source-tier{font-size:13px;gap:5px 8px}
    .source-tier__label{font-size:11px}
    .source-tier__more{font-size:12px}
  }
</style>
