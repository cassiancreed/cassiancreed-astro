---
import calendarTsv from '../data/court-calendar.tsv?raw';
import { formatCalendarDate, parseCourtCalendar } from '../data/court-calendar-parser.mjs';
import internationalTsv from '../data/international-watch.tsv?raw';
import { parseInternationalWatch } from '../data/international-watch-parser.mjs';
import { calendarDisplayPriority, rankCalendarEntries } from '../data/calendar-display-priority.mjs';

interface Props {
  fullPage?: boolean;
}

const { fullPage = false } = Astro.props;
const CalendarHeading = fullPage ? 'h1' : 'h2';

const CALENDAR_ALERT_FORM_ID = '4d7c7c61-f04c-4870-bf20-f1af8a540e0f';
const CALENDAR_ALERT_URL = `https://subscribe-forms.beehiiv.com/v3/forms/${CALENDAR_ALERT_FORM_ID}?utm_source=website&utm_medium=calendar_alert&utm_campaign=court_calendar_updates`;
// Add a case only after its paid explainer has a verified public checkout URL.
const LIVE_EXPLAINER_IDS = new Set(['patterson-appeal', 'clancy-closings-tentative', 'clancy-trial']);
const CASE_BOOKS = new Map([
  ['clancy-closings-tentative', {
    title: 'The Lindsay Clancy Trial',
    price: '$2.99',
    eyebrow: 'New · Case Chess',
    tagline: 'The law, the medical evidence, and the decisions jurors must make—explained before the verdict.',
    format: 'Instant PDF',
    cover: '/covers/lindsay-clancy-trial.jpg',
    coverAlt: 'Book cover of The Lindsay Clancy Trial by Cassian Creed, showing chess pieces on a dark chessboard',
    url: 'https://cassiancreed.beehiiv.com/products/lindsay-clancy-trial-book?utm_source=cassiancreed.com&utm_medium=court_calendar&utm_campaign=lindsay_clancy_trial_book&utm_content=selected_case_banner',
    bookKey: 'lindsay-clancy-trial-book',
    placement: 'calendar_selected_case_banner',
  }],
  ['clancy-trial', {
    title: 'The Lindsay Clancy Trial',
    price: '$2.99',
    eyebrow: 'New · Case Chess',
    tagline: 'The law, the medical evidence, and the decisions jurors must make—explained before the verdict.',
    format: 'Instant PDF',
    cover: '/covers/lindsay-clancy-trial.jpg',
    coverAlt: 'Book cover of The Lindsay Clancy Trial by Cassian Creed, showing chess pieces on a dark chessboard',
    url: 'https://cassiancreed.beehiiv.com/products/lindsay-clancy-trial-book?utm_source=cassiancreed.com&utm_medium=court_calendar&utm_campaign=lindsay_clancy_trial_book&utm_content=selected_case_banner',
    bookKey: 'lindsay-clancy-trial-book',
    placement: 'calendar_selected_case_banner',
  }],
]);
const calendar = parseCourtCalendar(calendarTsv);
const international = parseInternationalWatch(internationalTsv);
const lastUpdated = formatCalendarDate(calendar.metadata.last_updated);
const localDateParts = Object.fromEntries(
  new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Los_Angeles',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  })
    .formatToParts(new Date())
    .filter((part) => part.type !== 'literal')
    .map((part) => [part.type, part.value]),
);
const buildDate = `${localDateParts.year}-${localDateParts.month}-${localDateParts.day}`;
const worldwideListed = international.listed.map((entry) => ({
  ...entry,
  proceeding: entry.matter,
  ongoing: false,
  groups: ['next'],
  link: null,
  linkText: null,
}));
const visibleEntries = rankCalendarEntries([
  ...calendar.entries.filter((entry) => entry.ongoing || entry.dateISO >= buildDate),
  ...worldwideListed.filter((entry) => entry.dateISO >= buildDate),
]);
const ongoingEntries = [...visibleEntries]
  .filter((entry) => entry.ongoing)
  .sort((a, b) => calendarDisplayPriority(b) - calendarDisplayPriority(a));
const preferredCalendarLabels = new Map([
  ['banks-federal-trial', 'Lil Durk trial evidence'],
  ['bridegan-fernandez-trial', 'Jared Bridegan case'],
  ['davis-tupac-openings', 'Tupac murder trial'],
  ['flynn-final-pretrial', 'Ashley Flynn case'],
  ['flynn-trial', 'Ashley Flynn case'],
  ['gardner-jury-selection', 'Jared Bridegan case'],
  ['gardner-trial', 'Jared Bridegan case'],
  ['lund-calcagni-trial', 'Mark Calcagni case'],
  ['peters-berger-resolution', 'Lily Peters case'],
  ['salazar-clinkunbroomer-trial', 'Deputy Ryan Clinkunbroomer case'],
]);
const conciseStatus = (status = '') => status
  .split(/(?<=[.!?])\s+/)
  .slice(0, 2)
  .join(' ');
const futureDatedCaseNames = new Set(
  visibleEntries
    .filter((entry) => !entry.ongoing && entry.dateISO >= buildDate)
    .map((entry) => entry.case),
);
// A rolling calendar hides past dates. Keep active trials visible in a slim,
// undated rail instead of moving them onto a day the source did not verify.
const ongoingNowEntries = ongoingEntries
  .filter((entry) => entry.dateISO < buildDate && !futureDatedCaseNames.has(entry.case))
  .slice(0, 3);
const selectedEntry = visibleEntries.find((entry) => !entry.ongoing && entry.dateISO >= buildDate) ?? ongoingEntries[0] ?? null;
const clientEntries = visibleEntries.map((entry) => ({
  id: entry.id,
  caseName: entry.case,
  calendarLabel: preferredCalendarLabels.get(entry.id) || entry.case.split(' — ')[0],
  proceeding: entry.proceeding,
  // Grid placement always uses the proceeding's verified date. Trend strength
  // controls prominence within a real date; it never supplies or moves a date.
  dateISO: entry.dateISO,
  dateText: entry.dateText,
  timeStatus: entry.timeStatus,
  court: entry.court,
  status: entry.status,
  agendaSummary: conciseStatus(entry.status),
  ongoing: entry.ongoing,
  displayPriority: calendarDisplayPriority(entry),
  hasExplainer: LIVE_EXPLAINER_IDS.has(entry.id),
  sourceUrl: entry.src,
  sourceLabel: entry.srcLabel,
  link: entry.link,
  linkText: entry.linkText,
  book: CASE_BOOKS.get(entry.id) || null,
}));

const searchCases = Array.from(new Map([
  ...clientEntries.map((entry) => [entry.id, { id: entry.id, caseName: entry.caseName, dateISO: entry.dateISO }]),
  ...calendar.appeals.map((entry) => [entry.id, { id: entry.id, caseName: entry.case }]),
  ...calendar.unconfirmed.map((entry) => [entry.id, { id: entry.id, caseName: entry.case }]),
  ...calendar.investigations.map((entry) => [entry.id, { id: entry.id, caseName: entry.case }]),
  ...calendar.completed.map((entry) => [entry.id, { id: entry.id, caseName: entry.case }]),
  ...international.monitoring.map((entry) => [entry.id, { id: entry.id, caseName: entry.case }]),
  ...international.concluded.map((entry) => [entry.id, { id: entry.id, caseName: entry.case }]),
]).values()).sort((a, b) => a.caseName.localeCompare(b.caseName));

const dateKey = (date) => date.toISOString().slice(0, 10);
const firstOfMonth = new Date(`${buildDate.slice(0, 7)}-01T00:00:00Z`);
// The live month is a rolling view: its first row contains today in the
// correct weekday column, then uses the remaining rows for future dates.
// This avoids spending most of the calendar on dates readers can no longer use.
const todayForGrid = new Date(`${buildDate}T00:00:00Z`);
const gridStart = new Date(todayForGrid);
gridStart.setUTCDate(todayForGrid.getUTCDate() - todayForGrid.getUTCDay());
const serverDays = Array.from({ length: 42 }, (_, index) => {
  const date = new Date(gridStart);
  date.setUTCDate(gridStart.getUTCDate() + index);
  const key = dateKey(date);
  return {
    key,
    day: date.getUTCDate(),
    inMonth: date.getUTCMonth() === firstOfMonth.getUTCMonth(),
    isPast: key < buildDate,
    entries: clientEntries.filter((entry) => entry.dateISO === key),
  };
});
const initialSelectedDate = selectedEntry?.dateISO ?? buildDate;
const initialSelectedEntries = clientEntries.filter((entry) => entry.dateISO === initialSelectedDate);
const initialSelectedLabel = new Intl.DateTimeFormat('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(new Date(`${initialSelectedDate}T00:00:00Z`));
const initialMonthLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(firstOfMonth);
const trendPresentation = (score, hasExplainer = false) => {
  const strength = Math.max(0, Math.min(1, score / 104));
  const mix = (low, high) => Math.round(low + ((high - low) * strength));
  return [
    `font-size:${(9.4 + (strength * 3)).toFixed(2)}px`,
    `font-weight:${Math.round(450 + (strength * 310))}`,
    hasExplainer ? 'color:rgb(78 214 190)' : `color:rgb(${mix(138, 255)} ${mix(132, 111)} ${mix(124, 79)})`,
  ].join(';');
};
const visibleDayEntries = (entries) => {
  const naturalTop = entries.slice(0, 4);
  const highestExplainer = entries.find((entry) => entry.hasExplainer);
  if (!highestExplainer || naturalTop.includes(highestExplainer)) return naturalTop;
  return [...naturalTop.slice(0, 3), highestExplainer];
};
---

<section class:list={['home-calendar', 'wrap', fullPage && 'home-calendar--full']} aria-labelledby="home-calendar-title" data-home-calendar data-build-date={buildDate}>
  <div class="home-calendar__top">
    <div class="home-calendar__heading">
      <div>
        <p class="evidence evidence--accent">Updated {lastUpdated}</p>
        <CalendarHeading id="home-calendar-title">Court Calendar</CalendarHeading>
        {!fullPage && <p>Verified hearings, trials, and rulings worth following. Dates can change; each entry connects back to the public record and our related coverage.</p>}
      </div>
      {!fullPage && <a class="home-calendar__full-link" href="/court-calendar/">View the full calendar &rarr;</a>}
    </div>

    <div class="home-calendar__controls" aria-label="Calendar controls">
      <div class="home-calendar__search-wrap">
        <input id={`calendar-case-search-${fullPage ? 'full' : 'home'}`} type="search" aria-label="Search cases" placeholder="Search cases" list={`calendar-case-list-${fullPage ? 'full' : 'home'}`} autocomplete="off" data-calendar-search />
        <datalist id={`calendar-case-list-${fullPage ? 'full' : 'home'}`}>
          {searchCases.map((entry) => <option value={entry.caseName}></option>)}
        </datalist>
      </div>
      <h3 data-calendar-month aria-live="polite">{initialMonthLabel}</h3>
      <div class="home-calendar__controls-right">
        <button type="button" class="home-calendar__month-button" data-calendar-prev aria-label="Previous month" disabled>&larr; <span>Previous</span></button>
        <button type="button" class="home-calendar__today" data-calendar-today>Today</button>
        <button type="button" class="home-calendar__month-button" data-calendar-next aria-label="Next month"><span>Next</span> &rarr;</button>
      </div>
    </div>
  </div>

  <div class="home-calendar__layout">
    <div class="home-calendar__month" role="grid" aria-labelledby="home-calendar-title">
      {ongoingNowEntries.length > 0 && (
        <div class="home-calendar__ongoing" aria-label="Trials currently underway">
          <span>Trials underway</span>
          {ongoingNowEntries.map((entry) => (
            <a href={`/court-calendar/#${entry.id}`}>{preferredCalendarLabels.get(entry.id) || entry.case.split(' — ')[0]}</a>
          ))}
        </div>
      )}
      <div class="home-calendar__weekdays" role="row">
        {['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'].map((day) => (
          <span role="columnheader"><span class="home-calendar__day-wide">{day}</span><span class="home-calendar__day-short">{day.charAt(0)}</span></span>
        ))}
      </div>
      <div class="home-calendar__days" data-calendar-days>
        {serverDays.map((day) => day.isPast ? (
          <span class="home-calendar__day is-past" aria-hidden="true"></span>
        ) : (
          <button
            type="button"
            class:list={[
              'home-calendar__day',
              !day.inMonth && 'is-outside',
              day.key === buildDate && 'is-today',
              day.key === initialSelectedDate && 'is-selected',
              day.entries.length > 0 && 'has-events',
            ]}
            data-calendar-date={day.key}
            aria-label={`${day.key}${day.entries.length ? `, ${day.entries.length} proceeding${day.entries.length > 1 ? 's' : ''}` : ''}`}
          >
            <span class="home-calendar__day-number">{day.day}</span>
            {visibleDayEntries(day.entries).map((entry) => (
              <span class:list={['home-calendar__event-label', entry.hasExplainer && 'is-explainer', entry.timeStatus === 'tentative' && 'is-tentative']} data-trend-score={entry.displayPriority} style={trendPresentation(entry.displayPriority, entry.hasExplainer)}>
                <span class="home-calendar__event-name">{entry.calendarLabel}</span>
                {entry.timeStatus === 'tentative' && <span class="home-calendar__event-status">tentative</span>}
              </span>
            ))}
          </button>
        ))}
      </div>
    </div>

    <aside class="home-calendar__agenda" aria-labelledby="home-calendar-agenda-title">
      <p class="evidence evidence--accent">Selected date</p>
      <h3 id="home-calendar-agenda-title" data-calendar-agenda-title>{initialSelectedLabel}</h3>
      <div data-calendar-agenda aria-live="polite">
        {initialSelectedEntries.length > 0 ? initialSelectedEntries.map((entry) => (
          <article class="home-calendar__agenda-item">
            <p class="home-calendar__agenda-time">{entry.dateText}</p>
            {entry.timeStatus === 'tentative' && <p class="home-calendar__tentative">Tentative &mdash; subject to confirmation</p>}
            <h4>{entry.calendarLabel}</h4>
            <p class="home-calendar__agenda-type">{entry.proceeding}</p>
            <p class="home-calendar__agenda-status">{entry.agendaSummary}</p>
            {entry.book && (
              <aside class="home-calendar__book-promo" aria-label={`Featured book: ${entry.book.title}`}>
                <img src={entry.book.cover} alt={entry.book.coverAlt} width="1200" height="1800" loading="lazy" />
                <div class="home-calendar__book-copy">
                  <p class="home-calendar__book-eyebrow">{entry.book.eyebrow}</p>
                  <h5>{entry.book.title}</h5>
                  <p class="home-calendar__book-tagline">{entry.book.tagline}</p>
                  <p class="home-calendar__book-offer"><strong>{entry.book.price}</strong><span>{entry.book.format}</span></p>
                  <a href={entry.book.url} target="_blank" rel="noopener noreferrer" data-book-key={entry.book.bookKey} data-cta-placement={entry.book.placement}>Get the trial guide <span aria-hidden="true">&rarr;</span></a>
                </div>
              </aside>
            )}
            <p class="home-calendar__agenda-court">{entry.court}</p>
            <p class="home-calendar__agenda-source"><span>Source:</span> <a href={entry.sourceUrl} target="_blank" rel="noopener noreferrer">{entry.sourceLabel}</a></p>
            <div class="home-calendar__agenda-actions">
              {entry.link && <a href={entry.link}>{entry.linkText || 'Read the case'} &rarr;</a>}
              <a href={`/court-calendar/#${entry.id}`}>Calendar details &rarr;</a>
              {fullPage ? (
                <a href="#court-updates">Get court calendar updates &rarr;</a>
              ) : (
                <>
                  <button type="button" data-calendar-alert>Get court calendar updates</button>
                  {/* NEP-FIX-0824: the alert form lives in a JS-opened <dialog>. Without
                      this no-JS anchor the calendar signup is unreachable when scripts
                      fail or are blocked. */}
                  <noscript><a class="home-calendar__alert-noscript" href={CALENDAR_ALERT_URL} target="_blank" rel="noopener noreferrer">Get court calendar updates &rarr;</a></noscript>
                </>
              )}
            </div>
          </article>
        )) : <p class="home-calendar__empty">No tracked proceeding is currently scheduled for this date.</p>}
      </div>
      <p class="home-calendar__agenda-disclaimer">All defendants are presumed innocent unless and until convicted. Court dates move&mdash;confirm with the court before traveling.</p>
    </aside>
  </div>

  <script type="application/json" data-calendar-json set:html={JSON.stringify(clientEntries)}></script>
  <script type="application/json" data-calendar-search-json set:html={JSON.stringify(searchCases)}></script>

  {!fullPage && (
    <dialog class="case-alert" data-calendar-alert-dialog aria-labelledby="calendar-alert-title">
      <div class="case-alert__inner">
        <form method="dialog" class="case-alert__close-form">
          <button type="submit" class="case-alert__close" aria-label="Close court calendar updates form">&times;</button>
        </form>
        <p class="evidence evidence--accent">Calendar alerts</p>
        <h2 id="calendar-alert-title">Get Court Calendar Updates</h2>
        <p class="case-alert__copy">Get a short email when we change a court date, time, location, or phase. No free guide. No daily emails.</p>
        <div class="case-alert__embed-window" data-case-alert-embed-window>
          <iframe
            class="case-alert__embed"
            data-calendar-alert-form
            data-nep-campaign="court_calendar_updates"
            data-nep-conversion-page={Astro.url.pathname}
            data-nep-cta-id="court_calendar_alert"
            data-nep-form-id={CALENDAR_ALERT_FORM_ID}
            data-nep-offer-id="court_calendar_updates"
            data-form-base={`https://subscribe-forms.beehiiv.com/v3/forms/${CALENDAR_ALERT_FORM_ID}?utm_source=website&utm_medium=calendar_alert&utm_campaign=court_calendar_updates`}
            title="Subscribe for court calendar updates"
            loading="lazy"
            scrolling="no"
            frameborder="0"
          ></iframe>
        </div>
        <p class="case-alert__fallback">Form not loading? <a data-calendar-alert-fallback data-nep-campaign="court_calendar_updates" data-nep-conversion-page={Astro.url.pathname} data-nep-cta-id="court_calendar_alert_fallback" data-nep-form-id={CALENDAR_ALERT_FORM_ID} data-nep-offer-id="court_calendar_updates" href={`https://subscribe-forms.beehiiv.com/v3/forms/${CALENDAR_ALERT_FORM_ID}?utm_source=website&amp;utm_medium=calendar_alert&amp;utm_campaign=court_calendar_updates`} target="_blank" rel="noopener noreferrer">Get court calendar updates &rarr;</a></p>
        <p class="case-alert__helper">You can unsubscribe from any email.</p>
        <p class="case-alert__success" data-calendar-alert-success role="status" hidden><strong>You&rsquo;re on the list.</strong> Watch your inbox for court calendar updates.</p>
      </div>
    </dialog>
  )}
</section>

<script>
  const root = document.querySelector('[data-home-calendar]');
  if (root) {
    const fullPage = root.classList.contains('home-calendar--full');
    const entries = JSON.parse(root.querySelector('[data-calendar-json]')?.textContent || '[]');
    const searchCases = JSON.parse(root.querySelector('[data-calendar-search-json]')?.textContent || '[]');
    const buildDate = root.getAttribute('data-build-date');
    const buildParts = buildDate.split('-').map(Number);
    let shown = new Date(buildParts[0], buildParts[1] - 1, 1);
    let selectedDate = entries.find((entry) => !entry.ongoing && entry.dateISO >= buildDate)?.dateISO || buildDate;
    const monthLabel = root.querySelector('[data-calendar-month]');
    const days = root.querySelector('[data-calendar-days]');
    const agendaTitle = root.querySelector('[data-calendar-agenda-title]');
    const agenda = root.querySelector('[data-calendar-agenda]');
    const alertDialog = root.querySelector('[data-calendar-alert-dialog]');
    const alertForm = root.querySelector('[data-calendar-alert-form]');
    const alertFallback = root.querySelector('[data-calendar-alert-fallback]');
    const alertSuccess = root.querySelector('[data-calendar-alert-success]');
    const alertEmbedWindow = root.querySelector('[data-case-alert-embed-window]');
    const previousButton = root.querySelector('[data-calendar-prev]');
    const searchInput = root.querySelector('[data-calendar-search]');
    const pad = (value) => String(value).padStart(2, '0');
    const keyFor = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
    const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' });
    const dateFormatter = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

    function trendPresentation(score, hasExplainer = false) {
      const strength = Math.max(0, Math.min(1, score / 104));
      const mix = (low, high) => Math.round(low + ((high - low) * strength));
      return [
        `font-size:${(9.4 + (strength * 3)).toFixed(2)}px`,
        `font-weight:${Math.round(450 + (strength * 310))}`,
        hasExplainer ? 'color:rgb(78 214 190)' : `color:rgb(${mix(138, 255)} ${mix(132, 111)} ${mix(124, 79)})`,
      ].join(';');
    }

    function visibleDayEntries(dateEntries) {
      const naturalTop = dateEntries.slice(0, 4);
      const highestExplainer = dateEntries.find((entry) => entry.hasExplainer);
      if (!highestExplainer || naturalTop.includes(highestExplainer)) return naturalTop;
      return [...naturalTop.slice(0, 3), highestExplainer];
    }

    function createActionLink(href, label) {
      const link = document.createElement('a');
      link.href = href;
      link.textContent = `${label} →`;
      return link;
    }

    function createBookPromo(book) {
      const promo = document.createElement('aside');
      promo.className = 'home-calendar__book-promo';
      promo.setAttribute('aria-label', `Featured book: ${book.title}`);
      const cover = document.createElement('img');
      cover.src = book.cover;
      cover.alt = book.coverAlt;
      cover.width = 1200;
      cover.height = 1800;
      cover.loading = 'lazy';
      const copy = document.createElement('div');
      copy.className = 'home-calendar__book-copy';
      const eyebrow = document.createElement('p');
      eyebrow.className = 'home-calendar__book-eyebrow';
      eyebrow.textContent = book.eyebrow;
      const title = document.createElement('h5');
      title.textContent = book.title;
      const tagline = document.createElement('p');
      tagline.className = 'home-calendar__book-tagline';
      tagline.textContent = book.tagline;
      const offer = document.createElement('p');
      offer.className = 'home-calendar__book-offer';
      const price = document.createElement('strong');
      price.textContent = book.price;
      const format = document.createElement('span');
      format.textContent = book.format;
      offer.append(price, format);
      const cta = document.createElement('a');
      cta.href = book.url;
      cta.target = '_blank';
      cta.rel = 'noopener noreferrer';
      cta.dataset.bookKey = book.bookKey;
      cta.dataset.ctaPlacement = book.placement;
      cta.textContent = 'Get the trial guide →';
      copy.append(eyebrow, title, tagline, offer, cta);
      promo.append(cover, copy);
      return promo;
    }

    function openAlert() {
      if (!alertDialog || !alertForm || !alertFallback) return;
      const formUrl = new URL(alertForm.getAttribute('data-form-base'));
      alertForm.src = formUrl.toString();
      alertSuccess.hidden = true;
      alertEmbedWindow.hidden = false;
      alertDialog.showModal();
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'calendar_alert_open', { page_path: location.pathname });
      }
    }

    function renderAgenda(key) {
      selectedDate = key;
      const date = new Date(`${key}T12:00:00`);
      agendaTitle.textContent = dateFormatter.format(date);
      agenda.replaceChildren();
      const selectedEntries = entries
        .filter((entry) => entry.dateISO === key)
        .sort((a, b) => b.displayPriority - a.displayPriority || a.caseName.localeCompare(b.caseName));
      if (!selectedEntries.length) {
        const empty = document.createElement('p');
        empty.className = 'home-calendar__empty';
        empty.textContent = 'No tracked proceeding is currently scheduled for this date.';
        agenda.append(empty);
        return;
      }
      selectedEntries.forEach((entry) => {
        const article = document.createElement('article');
        article.className = 'home-calendar__agenda-item';
        const dateText = document.createElement('p');
        dateText.className = 'home-calendar__agenda-time';
        dateText.textContent = entry.dateText;
        const tentative = document.createElement('p');
        tentative.className = 'home-calendar__tentative';
        tentative.textContent = 'Tentative — subject to confirmation';
        const title = document.createElement('h4');
        title.textContent = entry.calendarLabel;
        const type = document.createElement('p');
        type.className = 'home-calendar__agenda-type';
        type.textContent = entry.proceeding;
        const status = document.createElement('p');
        status.className = 'home-calendar__agenda-status';
        status.textContent = entry.agendaSummary;
        const court = document.createElement('p');
        court.className = 'home-calendar__agenda-court';
        court.textContent = entry.court;
        const source = document.createElement('p');
        source.className = 'home-calendar__agenda-source';
        const sourcePrefix = document.createElement('span');
        sourcePrefix.textContent = 'Source: ';
        const sourceLink = createActionLink(entry.sourceUrl, entry.sourceLabel);
        sourceLink.textContent = entry.sourceLabel;
        sourceLink.target = '_blank';
        sourceLink.rel = 'noopener noreferrer';
        source.append(sourcePrefix, sourceLink);
        const actions = document.createElement('div');
        actions.className = 'home-calendar__agenda-actions';
        if (entry.link) actions.append(createActionLink(entry.link, entry.linkText || 'Read the case'));
        actions.append(createActionLink(`/court-calendar/#${entry.id}`, 'Calendar details'));
        if (fullPage) {
          actions.append(createActionLink('#court-updates', 'Get court calendar updates'));
        } else {
          const alertButton = document.createElement('button');
          alertButton.type = 'button';
          alertButton.textContent = 'Get court calendar updates';
          alertButton.addEventListener('click', openAlert);
          actions.append(alertButton);
        }
        article.append(dateText);
        if (entry.timeStatus === 'tentative') article.append(tentative);
        article.append(title, type, status);
        if (entry.book) article.append(createBookPromo(entry.book));
        article.append(court, source, actions);
        agenda.append(article);
      });
    }

    function renderMonth() {
      monthLabel.textContent = monthFormatter.format(shown);
      const currentMonth = new Date(buildParts[0], buildParts[1] - 1, 1);
      if (previousButton) previousButton.disabled = shown <= currentMonth;
      const isCurrentMonth = shown.getFullYear() === buildParts[0] && shown.getMonth() === buildParts[1] - 1;
      const first = isCurrentMonth
        ? new Date(buildParts[0], buildParts[1] - 1, buildParts[2])
        : new Date(shown.getFullYear(), shown.getMonth(), 1);
      const start = new Date(first.getFullYear(), first.getMonth(), first.getDate() - first.getDay());
      days.replaceChildren();
      for (let index = 0; index < 42; index += 1) {
        const date = new Date(start);
        date.setDate(start.getDate() + index);
        const key = keyFor(date);
        const dateEntries = entries
          .filter((entry) => entry.dateISO === key)
          .sort((a, b) => b.displayPriority - a.displayPriority || a.caseName.localeCompare(b.caseName));
        if (key < buildDate) {
          const blank = document.createElement('span');
          blank.className = 'home-calendar__day is-past';
          blank.setAttribute('aria-hidden', 'true');
          days.append(blank);
          continue;
        }
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'home-calendar__day';
        button.setAttribute('data-calendar-date', key);
        if (date.getMonth() !== shown.getMonth()) button.classList.add('is-outside');
        if (key === keyFor(new Date())) button.classList.add('is-today');
        if (key === selectedDate) button.classList.add('is-selected');
        if (dateEntries.length) button.classList.add('has-events');
        button.setAttribute('role', 'gridcell');
        button.setAttribute('aria-label', `${dateFormatter.format(date)}${dateEntries.length ? `, ${dateEntries.length} proceeding${dateEntries.length > 1 ? 's' : ''}` : ''}`);
        const number = document.createElement('span');
        number.className = 'home-calendar__day-number';
        number.textContent = String(date.getDate());
        button.append(number);
        visibleDayEntries(dateEntries).forEach((entry) => {
          const label = document.createElement('span');
          label.className = 'home-calendar__event-label';
          if (entry.hasExplainer) label.classList.add('is-explainer');
          if (entry.timeStatus === 'tentative') label.classList.add('is-tentative');
          label.dataset.trendScore = String(entry.displayPriority);
          label.style.cssText = trendPresentation(entry.displayPriority, entry.hasExplainer);
          const eventName = document.createElement('span');
          eventName.className = 'home-calendar__event-name';
          eventName.textContent = entry.calendarLabel;
          label.append(eventName);
          if (entry.timeStatus === 'tentative') {
            const eventStatus = document.createElement('span');
            eventStatus.className = 'home-calendar__event-status';
            eventStatus.textContent = 'tentative';
            label.append(eventStatus);
          }
          button.append(label);
        });
        button.addEventListener('click', () => {
          renderAgenda(key);
          renderMonth();
        });
        days.append(button);
      }
    }

    function openSearchResult() {
      if (!searchInput) return;
      const query = searchInput.value.trim().toLocaleLowerCase();
      if (!query) return;
      const match = searchCases.find((entry) => entry.caseName.toLocaleLowerCase() === query)
        || searchCases.find((entry) => entry.caseName.toLocaleLowerCase().startsWith(query))
        || searchCases.find((entry) => entry.caseName.toLocaleLowerCase().includes(query));
      if (!match) {
        searchInput.setCustomValidity('No tracked case matches that search.');
        searchInput.reportValidity();
        return;
      }
      searchInput.setCustomValidity('');
      searchInput.value = match.caseName;
      if (match.dateISO && match.dateISO >= buildDate) {
        const [year, month] = match.dateISO.split('-').map(Number);
        shown = new Date(year, month - 1, 1);
        renderAgenda(match.dateISO);
        renderMonth();
        return;
      }
      document.getElementById(match.id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    previousButton?.addEventListener('click', () => {
      const currentMonth = new Date(buildParts[0], buildParts[1] - 1, 1);
      if (shown <= currentMonth) return;
      shown = new Date(shown.getFullYear(), shown.getMonth() - 1, 1);
      renderMonth();
    });
    root.querySelector('[data-calendar-next]')?.addEventListener('click', () => {
      shown = new Date(shown.getFullYear(), shown.getMonth() + 1, 1);
      renderMonth();
    });
    root.querySelector('[data-calendar-today]')?.addEventListener('click', () => {
      const today = new Date();
      shown = new Date(today.getFullYear(), today.getMonth(), 1);
      renderAgenda(keyFor(today));
      renderMonth();
    });
    searchInput?.addEventListener('input', () => searchInput.setCustomValidity(''));
    searchInput?.addEventListener('change', openSearchResult);
    searchInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        openSearchResult();
      }
    });
    if (!fullPage) {
      root.querySelectorAll('[data-calendar-alert]').forEach((button) => button.addEventListener('click', openAlert));
      alertDialog?.addEventListener('click', (event) => {
        if (event.target === alertDialog) alertDialog.close();
      });
      alertForm?.addEventListener('load', () => {
        let href;
        try { href = alertForm.contentWindow.location.href; } catch (error) { return; }
        if (!href || !href.includes('subscribed=1')) return;
        alertEmbedWindow.hidden = true;
        alertSuccess.hidden = false;
      });
    }
    renderMonth();
  }
</script>

