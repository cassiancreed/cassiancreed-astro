---
// ▼▼▼▼▼ OFFER COPY SWAP-POINT — AB replaces these 3 strings with 0716V isweat-certified copy ▼▼▼▼▼
// These are the ONLY strings to edit before merge. Leave the surrounding code untouched.
// Props of the same name (headline/subtext/button) override these per-placement if ever needed,
// but the DEFAULTS below are the canonical swap-point.
const DEFAULT_HEADLINE = 'Never Wonder What Happened Next.';
const DEFAULT_SUBTEXT  = 'Subscribe to Neural Edge Publishing’s case tracker — a weekly briefing that follows the forensic evidence, the courtroom proceedings, and the verdicts on the cases you’ve been reading about. Because the story doesn’t end when the article does.';
const DEFAULT_BUTTON   = 'Never Miss a Verdict';
// ▲▲▲▲▲ END OFFER COPY SWAP-POINT ▲▲▲▲▲

// ── FUTURE PAGE-MATCHED COPY (commented — no runtime effect yet) ──
// The DEFAULT_* strings above apply to every placement now: home, all posts, and baby_jacob.
// To slot page-specific copy LATER without rebuilding this component, uncomment the map
// below (keyed by the `campaign` prop each placement passes) and, in the resolver, prefer
// COPY_BY_CAMPAIGN[campaign] before the DEFAULT_* fallback. 1B forensic + 2A trial are
// pre-reserved so their AB-certified copy can drop straight in.
// const COPY_BY_CAMPAIGN = {
//   home:       { headline: DEFAULT_HEADLINE, subtext: DEFAULT_SUBTEXT, button: DEFAULT_BUTTON },
//   baby_jacob: { headline: DEFAULT_HEADLINE, subtext: DEFAULT_SUBTEXT, button: DEFAULT_BUTTON },
//   // '1B_forensic': { headline: '', subtext: '', button: '' },  // forensic-evidence page
//   // '2A_trial':    { headline: '', subtext: '', button: '' },  // trial / courtroom page
//   // 'post_<slug>': { ... },                                    // per-post override as needed
// };
// When enabled, resolve as:
//   const c = COPY_BY_CAMPAIGN[campaign] ?? {};
//   resolvedHeadline = headline ?? c.headline ?? DEFAULT_HEADLINE;  (same for subtext/button)

export interface Props {
  /** Required. Feeds utm_campaign so each placement is tracked distinctly. */
  campaign: string;
  /** Optional per-placement overrides. Leave unset to use the swap-point defaults above. */
  headline?: string;
  subtext?: string;
  button?: string;
}

const { campaign, headline, subtext, button } = Astro.props;

const resolvedHeadline = headline ?? DEFAULT_HEADLINE;
const resolvedSubtext  = subtext  ?? DEFAULT_SUBTEXT;
const resolvedButton   = button   ?? DEFAULT_BUTTON;

// Href is built from the prop. encodeURIComponent guards odd campaign strings.
const subscribeHref =
  `https://cassiancreed.beehiiv.com/subscribe?utm_source=website&utm_medium=capture&utm_campaign=${encodeURIComponent(campaign)}`;
---

<section class="capture" aria-label="Email newsletter sign-up">
  <div class="capture__inner">
    <h2 class="capture__headline">{resolvedHeadline}</h2>
    <p class="capture__subtext">{resolvedSubtext}</p>

    {/* Wrapper MUST keep class "capture-cta" — the site layout's GA4 handler
        fires subscribe_click on any <a> inside .capture-cta. CTA is an <a>, not a form. */}
    <div class="capture-cta">
      <a
        class="capture__button"
        href={subscribeHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        {resolvedButton}
      </a>
    </div>
  </div>
</section>

<style>
  /* Mobile-first: base rules target narrow screens. */
  .capture {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    margin: 2rem 0;
  }

  .capture__inner {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .capture__headline {
    font-family: var(--serif);
    color: var(--ink);          /* --ink on --bg-2 ≈ 15.9:1 — AA/AAA */
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0;
  }

  .capture__subtext {
    color: var(--ink-2);        /* --ink-2 on --bg-2 ≈ 8.6:1 — AA/AAA */
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  .capture-cta { margin-top: 0.35rem; }

  .capture__button {
    display: flex;               /* full-width, centered on mobile */
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;            /* accessible tap target */
    padding: 0.75rem 1.5rem;
    box-sizing: border-box;
    background: var(--accent);
    color: var(--bg);            /* near-black on --accent ≈ 4.98:1 — AA */
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-align: center;
    border-radius: 8px;
    transition: filter 0.15s ease, transform 0.05s ease;
  }

  .capture__button:hover { filter: brightness(1.08); }
  .capture__button:active { transform: translateY(1px); }
  .capture__button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

  @media (min-width: 640px) {
    .capture { padding: 2.25rem 2rem; }
    .capture__headline { font-size: 1.9rem; }
    .capture__button { width: auto; min-width: 240px; align-self: flex-start; }
  }
</style>
