---
// ─────────────────────────────────────────────────────────────────────────────
// CaptureBlock — per-page lead-magnet matching (NEP-REV-CWK-0717AF)
//
// Each PAGE passes an `offer` that matches WHO lands there. The OFFERS map below
// holds the matched headline/subtext/button, the Beehiiv form to embed, and a
// distinct utm_campaign so attribution stays clean per magnet.
//
// ⚠ BEEHIIV FORM REALITY (verified 2026-07-17): the publication has exactly ONE
// subscribe form — the Jury Chess form (4d0df7d0). No dedicated "How DNA
// Remembers" form and no Safety-guide form exist yet. Per standing rule we do
// NOT invent form IDs. So the `dna` and `safety` offers carry their own matched
// COPY + UTM but, until a real form+automation is built, they embed the single
// live form (formMatched:false marks this). When the owner creates a real form,
// drop its id into the offer's `formId` and set formMatched:true — delivery then
// matches with no other change.
// ─────────────────────────────────────────────────────────────────────────────

const JURY_FORM = '4d0df7d0-f274-4901-a457-091f80cecef0';

// ── Converged offers (isweat: all three ship ≥8.0, Rex+Banks PASS) ──
// The general/case segment magnet was SWITCHED from "The Jury Chess Game"
// (6.76, unresolvable Banks reader-value mismatch) to "How to Read a Case
// Like the Court Does" (8.56). `jury` is kept as an ALIAS → `case` so any
// page/post still passing offer="jury" resolves to the converged offer with
// no page edits; the voir-dire material is retired as a magnet and lives on
// as a standalone article.
const OFFERS = {
  case: {
    formId: JURY_FORM,        // reuses the single live subscribe form (copy+UTM matched)
    formMatched: true,
    campaign: 'lm_case_how-to-read-a-case',
    headline: 'Everyone has an opinion on a case. Here’s how to actually read one.',
    subtext: 'A charge isn’t a conviction. A theory isn’t proof. Subscribe free and we’ll send How to Read a Case Like the Court Does — a plain-language framework for weighing evidence instead of guessing, the real difference between proof and speculation, and what a verdict actually settles (and what it doesn’t) — plus how each new case’s evidence actually breaks down, using the same framework. No weekly blast; unsubscribe anytime.',
    button: 'Get the free guide',
  },
  dna: {
    formId: JURY_FORM,        // TODO: swap to the "How DNA Remembers" form when it exists
    formMatched: false,
    campaign: 'lm_dna_how-dna-remembers',
    headline: 'The science that gives cold cases a name.',
    subtext: 'A DNA match is a lead, not a verdict. Subscribe free and we’ll send the printable How DNA Remembers guide — how shared DNA narrows a family tree into a name, the real difference between a CODIS hit and forensic genetic genealogy, and exactly what a match can (and can’t) prove in court — plus the next real identification the moment it’s confirmed. No weekly blast; unsubscribe anytime.',
    button: 'Get the free guide',
  },
  safety: {
    formId: JURY_FORM,        // TODO: swap to the Stay-Safe guide form when it exists
    formMatched: false,
    campaign: 'lm_safety_stay-safe-field-guide',
    // Rex requirement: crisis hotlines must be visible ON-PAGE, ungated,
    // BEFORE any signup ask. Rendered via `safetyLine` below the subtext.
    safetyLine: 'If you’re in danger right now: call or text 988, call the National Domestic Violence Hotline at 1-800-799-7233, or text HOME to 741741. Free, confidential, 24/7 — no signup required.',
    headline: 'The warning signs repeat. So does the way out.',
    subtext: 'If you’re worried about your own safety or someone you love, you’re not alone — and what other cases have shown can help you see clearly. Subscribe free for the printable Stay Safe guide: the escalation patterns that recur across real, documented cases, how to document safely, and how to plan around someone who monitors or controls you — plus what each new case teaches about staying safe. This guide is not a substitute for a personalized safety plan from a trained advocate; the hotlines above can connect you to one, free. No weekly blast; unsubscribe anytime.',
    button: 'Get the free guide',
  },
};
// Back-compat alias: legacy pages/posts still pass offer="jury".
OFFERS.jury = OFFERS.case;

export interface Props {
  /** Topic-matched magnet: 'case' (cases/trials/home; 'jury' is a back-compat alias), 'dna' (genealogy), 'safety'. */
  offer?: 'case' | 'jury' | 'dna' | 'safety';
  /** Optional UTM override. Defaults to the offer's own campaign. */
  campaign?: string;
  /** Optional per-placement copy overrides (win over the offer defaults). */
  headline?: string;
  subtext?: string;
  button?: string;
  /** Optional per-placement id → utm_content (keeps per-post attribution while
      utm_campaign carries the matched offer). */
  content?: string;
  /** false → render the styled orange button CTA instead of an inline iframe.
      Use when a page already carries one inline embed (avoids duplicate same-form
      embeds colliding — the homepage bug this component fixes). Default true. */
  embed?: boolean;
}

const { offer = 'case', campaign, content, headline, subtext, button, embed = true } = Astro.props;
const o = OFFERS[offer] ?? OFFERS.case;

const camp             = campaign ?? o.campaign;
const utmContent       = content ? `&utm_content=${encodeURIComponent(content)}` : '';
const resolvedHeadline = headline ?? o.headline;
const resolvedSubtext  = subtext  ?? o.subtext;
const resolvedButton   = button   ?? o.button;
// Ungated crisis line (safety offer only). Always rendered before signup.
const safetyLine       = (o as { safetyLine?: string }).safetyLine;

// Fallback / non-embed link. encodeURIComponent guards odd campaign strings.
const subscribeHref =
  `https://cassiancreed.beehiiv.com/subscribe?utm_source=website&utm_medium=capture&utm_campaign=${encodeURIComponent(camp)}${utmContent}`;

// Beehiiv INLINE EMBED (direct-submit): visitor enters email ONCE, on-page.
// slim=true renders a compact email+button row. Per-placement UTM on the src.
const embedSrc =
  `https://embeds.beehiiv.com/${o.formId}?slim=true&utm_source=website&utm_medium=capture&utm_campaign=${encodeURIComponent(camp)}${utmContent}`;
---

<section class="capture" aria-label="Email newsletter sign-up">
  <div class="capture__inner">
    <h2 class="capture__headline">{resolvedHeadline}</h2>
    {safetyLine && (
      <p class="capture__safety" role="note">{safetyLine}</p>
    )}
    <p class="capture__subtext">{resolvedSubtext}</p>

    {/* .capture-cta wrapper keeps the GA4 subscribe_click handler firing on the
        <a> in either mode. */}
    <div class="capture-cta">
      {embed ? (
        <>
          <iframe
            class="capture__embed"
            src={embedSrc}
            title={resolvedButton}
            loading="lazy"
            scrolling="no"
            frameborder="0"
          ></iframe>
          <p class="capture__fallback">
            Form not loading? <a href={subscribeHref} target="_blank" rel="noopener noreferrer">{resolvedButton} &rarr;</a>
          </p>
        </>
      ) : (
        <a class="capture__button" href={subscribeHref} target="_blank" rel="noopener noreferrer">{resolvedButton} &rarr;</a>
      )}
    </div>
  </div>
</section>

<style>
  /* Mobile-first: base rules target narrow screens. */
  .capture {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    margin: 2rem 0;
  }

  .capture__inner {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .capture__headline {
    font-family: var(--serif);
    color: var(--ink);          /* --ink on --bg-2 ≈ 15.9:1 — AA/AAA */
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0;
  }

  .capture__subtext {
    color: var(--ink-2);        /* --ink-2 on --bg-2 ≈ 8.6:1 — AA/AAA */
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Ungated crisis line (safety offer). Deliberately prominent and visible
     BEFORE the signup ask — duty of care, not a marketing element. */
  .capture__safety {
    color: var(--ink);
    background: rgba(224, 86, 59, 0.10);
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 0.75rem 0.9rem;
    font-size: 0.95rem;
    line-height: 1.5;
    font-weight: 600;
    margin: 0;
  }

  .capture-cta { margin-top: 0.35rem; }

  .capture__embed {
    display: block;
    width: 100%;
    max-width: 460px;
    height: 64px;
    border: 0;
    margin: 0;
    background: transparent;
    color-scheme: light;
  }

  .capture__fallback {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .capture__fallback a { color: var(--accent); }

  .capture__button {
    display: flex;               /* full-width, centered on mobile */
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;            /* accessible tap target */
    padding: 0.75rem 1.5rem;
    box-sizing: border-box;
    background: var(--accent);
    color: var(--bg);            /* near-black on --accent ≈ 4.98:1 — AA */
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-align: center;
    border-radius: 8px;
    transition: filter 0.15s ease, transform 0.05s ease;
  }

  .capture__button:hover { filter: brightness(1.08); }
  .capture__button:active { transform: translateY(1px); }
  .capture__button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

  @media (min-width: 640px) {
    .capture { padding: 2.25rem 2rem; }
    .capture__headline { font-size: 1.9rem; }
    .capture__button { width: auto; min-width: 240px; align-self: flex-start; }
  }
</style>
