---
// ─────────────────────────────────────────────────────────────────────────────
// CaptureBlock — per-page lead-magnet matching (NEP-REV-CWK-0717AF)
//
// Each PAGE passes an `offer` that matches WHO lands there. The OFFERS map below
// holds the matched headline/subtext/button, the Beehiiv form to embed, and a
// distinct utm_campaign so attribution stays clean per magnet.
//
// ✅ BEEHIIV FORM REALITY (updated 2026-07-18, flight 0718M): the publication now
// has THREE live subscribe forms — case/Jury (4d0df7d0), How DNA Remembers
// (6102d20f) and Stay Safe Field Guide (32e7f9bd). Every offer is therefore
// formMatched:true and delivery matches the pitch. Never invent a form id.
// ─────────────────────────────────────────────────────────────────────────────

const JURY_FORM   = '4d0df7d0-f274-4901-a457-091f80cecef0';
const DNA_FORM    = '6102d20f-cfb4-46fa-88db-dbeae2d63094';  // "How DNA Remembers"      (0718M)
const SAFETY_FORM = '32e7f9bd-83d8-4945-a3c2-7b9cbc649bd1';  // "Stay Safe Field Guide"  (0718M)


// ── Converged offers (isweat: all three ship ≥8.0, Rex+Banks PASS) ──
// The general/case segment magnet was SWITCHED from "The Jury Chess Game"
// (6.76, unresolvable Banks reader-value mismatch) to "How to Read a Case
// Like the Court Does" (8.56). `jury` is kept as an ALIAS → `case` so any
// page/post still passing offer="jury" resolves to the converged offer with
// no page edits; the voir-dire material is retired as a magnet and lives on
// as a standalone article.
const OFFERS = {
  case: {
    formId: JURY_FORM,        // reuses the single live subscribe form (copy+UTM matched)
    formMatched: true,
    campaign: 'lm_case_how-to-read-a-case',
    headline: 'Everyone has an opinion on a case. Here’s how to actually read one.',
    subtext: 'A charge isn’t a conviction. A theory isn’t proof. Get the free guide — we’ll send How to Read a Case Like the Court Does — a plain-language framework for weighing evidence instead of guessing, the real difference between proof and speculation, and what a verdict actually settles (and what it doesn’t) — plus how each new case’s evidence actually breaks down, using the same framework. No weekly blast; unsubscribe anytime.',
    button: 'Get the free guide',
  },
  dna: {
    formId: DNA_FORM,         // dedicated form, live 2026-07-18 (0718M)
    formMatched: true,
    campaign: 'lm_dna_how-dna-remembers',
    headline: 'The science that gives cold cases a name.',
    subtext: 'A DNA match is a lead, not a verdict. Get the free guide — we’ll send the printable How DNA Remembers guide — how shared DNA narrows a family tree into a name, the real difference between a CODIS hit and forensic genetic genealogy, and exactly what a match can (and can’t) prove in court — plus the next real identification the moment it’s confirmed. No weekly blast; unsubscribe anytime.',
    button: 'Get the free guide',
  },
  safety: {
    formId: SAFETY_FORM,      // dedicated form, live 2026-07-18 (0718M)
    formMatched: true,
    campaign: 'lm_safety_stay-safe-field-guide',
    // Rex requirement: crisis hotlines must be visible ON-PAGE, ungated,
    // BEFORE any signup ask. Rendered via `safetyLine` below the subtext.
    safetyLine: 'Immediate physical danger: call 911 or local emergency services. Suicide, mental-health, or substance-use crisis support: call or text 988. No signup is required for help.',
    headline: 'Request the printable Stay Safe Field Guide.',
    subtext: 'Use this optional subscription form to request the printable Stay Safe Field Guide and receive NEP updates. Updates may include This Week in Court, plain-English explainers, and practical safety guidance—without sensationalism or victim blame. This email is not emergency support or a personalized safety plan. Unsubscribe anytime.',
    button: 'Get the free guide',
  },
};
// Back-compat alias: legacy pages/posts still pass offer="jury".
OFFERS.jury = OFFERS.case;

export interface Props {
  /** Topic-matched magnet: 'case' (cases/trials/home; 'jury' is a back-compat alias), 'dna' (genealogy), 'safety'. */
  offer?: 'case' | 'jury' | 'dna' | 'safety';
  /** Optional UTM override. Defaults to the offer's own campaign. */
  campaign?: string;
  /** Optional per-placement copy overrides (win over the offer defaults). */
  headline?: string;
  subtext?: string;
  button?: string;
  /** Optional per-placement id → utm_content (keeps per-post attribution while
      utm_campaign carries the matched offer). */
  content?: string;
  /** false → render the styled orange button CTA instead of an inline iframe.
      Use when a page already carries one inline embed (avoids duplicate same-form
      embeds colliding — the homepage bug this component fixes). Default true. */
  embed?: boolean;
}

const EMBED_BASE = 'https://subscribe-forms.beehiiv.com/v3/forms';

const { offer = 'case', campaign, content, headline, subtext, button, embed = true } = Astro.props;
const o = OFFERS[offer] ?? OFFERS.case;

const camp             = campaign ?? o.campaign;
const utmContent       = content ? `&utm_content=${encodeURIComponent(content)}` : '';
const resolvedHeadline = headline ?? o.headline;
const resolvedSubtext  = subtext  ?? o.subtext;
const resolvedButton   = button   ?? o.button;
// Ungated crisis line (safety offer only). Always rendered before signup.
const safetyLine       = (o as { safetyLine?: string }).safetyLine;
const safetyOffer      = offer === 'safety';

// Fallback / non-embed link. encodeURIComponent guards odd campaign strings.
const subscribeHref =
  `https://cassiancreed.beehiiv.com/subscribe?utm_source=website&utm_medium=capture&utm_campaign=${encodeURIComponent(camp)}${utmContent}`;

// SUPPORTED BEEHIIV TRANSPORT (NEP-FIX-CWK-0718R).
// subscribe-forms.beehiiv.com is the v2 form-builder embed: it renders the
// DASHBOARD styling (verified live 2026-07-18 — button #A8503A / text #F6F1EA,
// label "Get the free guide."). The legacy embeds.beehiiv.com/<id>?slim=true
// endpoint ignores the v2 theme, which is where the neon-green button came from.
// The native POST to /create that 0718L shipped is REJECTED by Beehiiv (403 for
// humans, Kasada wall for bots) and captured zero subscribers — never reinstate it.
const embedSrc =
  `${EMBED_BASE}/${o.formId}?utm_source=website&utm_medium=capture&utm_campaign=${encodeURIComponent(camp)}${utmContent}`;
---

<section class="capture" aria-label="Email newsletter sign-up">
  <div class="capture__inner">
    <h2 class="capture__headline">{resolvedHeadline}</h2>
    {safetyLine && (
      <p class="capture__safety" role="note">{safetyLine}</p>
    )}
    <p class="capture__subtext">{resolvedSubtext}</p>

    {/* .capture-cta wrapper keeps the GA4 subscribe_click handler firing on the
        <a> in either mode. */}
    <div class="capture-cta">
      {embed ? (
        <>
          {/* FORM VISIBILITY FIX — NEP-CWK-IRASEMA-FULL-FIX-DEPLOY-0726.
              The Beehiiv v2 theme wraps this form in 80px of padding on ALL
              FOUR sides (measured live 2026-07-26 on the form itself, not
              inferred). Two consequences, both live since 2026-07-18:
                · VERTICAL — the form's control row sits at y=80..127 inside a
                  207px document. The old iframe was height:64px with scrolling
                  off, so the only visible slice was the top padding: no email
                  field, no button, just the "Form not loading?" fallback. That
                  is the reported live breakage.
                · HORIZONTAL — 80px of padding each side eats the width. In a
                  298px-wide frame the email input collapsed to 65px.
              Fix: give the iframe a document 160px WIDER and 207px tall, then
              shift it up/left inside a clipping window so the padding is
              cropped and only the control row shows. The window keeps the old
              64px height, so nothing else on the page moves.
              Window max-width is 400px ON PURPOSE: the form's own max-width is
              400px and it centres inside the padded box once that box exceeds
              400px, which would reintroduce a left gap. Capping the window at
              400px keeps iframe width <= 560px, where the form still fills the
              box and starts at exactly x=80 — so the -80px crop stays exact at
              every width. Verified alignment at 342 / 502 / 620 / 760px.
              If the form ever looks off-centre or clipped again, re-measure the
              theme padding FIRST — that is the number this crop depends on. */}
          <div class="capture__embed-window">
            <iframe
              class="capture__embed"
              data-nep-campaign={camp}
              src={embedSrc}
              title={resolvedButton}
              loading="lazy"
              scrolling="no"
              frameborder="0"
            ></iframe>
          </div>
          <p class="capture__fallback">
            Form not loading? <a href={subscribeHref} target="_blank" rel="noopener noreferrer">{resolvedButton} &rarr;</a>
          </p>
          <p class="capture__helper">After submitting, follow Beehiiv&rsquo;s on-screen confirmation instructions and check the email address you provided.</p>
          <div class="capture__success" role="status" hidden>
            <strong>Submission received.</strong> Follow the confirmation instructions shown by Beehiiv and check your inbox or spam folder.
          </div>
        </>
      ) : (
        <a class="capture__button" data-nep-campaign={camp} href={subscribeHref} target="_blank" rel="noopener noreferrer">{resolvedButton} &rarr;</a>
      )}
    </div>
  </div>
</section>

<script>
  // DG4 (NEP-OPS-CWK-0718DG): honest capture success feedback.
  // The Beehiiv form's success behaviour is a redirect to a SAME-ORIGIN url
  // (cassiancreed.com/?subscribed=1). The iframe starts cross-origin (beehiiv) and
  // is unreadable, so we do nothing on that first load. After a REAL submit the
  // iframe lands same-origin and becomes readable -- that is the genuine success
  // signal, not a guess. On detection we reveal our own success note and hide the
  // now-redundant embed (which would otherwise render our homepage inside itself).
  function wireCapture(iframe){
    iframe.addEventListener('load', function(){
      var href;
      try { href = iframe.contentWindow.location.href; } catch (e) { return; } // cross-origin => pre-submit
      if (!href || href.indexOf('subscribed=1') === -1) return;
      var cta = iframe.closest('.capture-cta'); if (!cta) return;
      var ok = cta.querySelector('.capture__success'); if (ok) ok.hidden = false;
      iframe.hidden = true;
      // Hide the clipping window too, or a 64px empty box is left behind
      // (0726 full-fix: the iframe is now absolutely positioned inside it).
      var win = cta.querySelector('.capture__embed-window'); if (win) win.hidden = true;
      var fb = cta.querySelector('.capture__fallback'); if (fb) fb.hidden = true;
      var hp = cta.querySelector('.capture__helper');  if (hp) hp.hidden = true;
      // NEP-CWK-IRASEMA-CONVERSION-RESCUE-0726 — attributable success.
      // The in-iframe success page loads Base.astro and fires its own GA4
      // sign_up, but attributed to page "/" (the iframe's URL), NOT the case
      // page the visitor actually converted on. This parent-side event carries
      // the true page_path and the campaign origin, so a signup can be traced
      // back to the post AND to Spotify.
      fire('capture_success', iframe);
    });
  }

  // ── Shared helpers (0726) ────────────────────────────────────────────────
  function origin(){ try { return window.NEP_ORIGIN || null; } catch(e){ return null; } }
  function fire(name, el){
    if (typeof window.gtag !== 'function') return;
    var o = origin() || {};
    window.gtag('event', name, {
      page_path: location.pathname,
      origin_source:   o.s || '(direct)',
      origin_medium:   o.m || '(none)',
      origin_campaign: o.c || '(none)',
      capture_offer: (el && el.getAttribute('data-nep-campaign')) || '(unknown)'
    });
  }

  // ORIGIN FORWARDING. The form URL's utm_source/medium/campaign are LEFT
  // ALONE so every existing Beehiiv report keeps working; the visitor's
  // first-touch origin is folded into utm_content, which is already
  // per-placement and therefore free to extend. Result: a Beehiiv subscription
  // record reads e.g.
  //   utm_content = post_<slug>.src-spotify.mdm-podcast.cmp-irasema_chavez_update
  // which is a recoverable, greppable Spotify-origin signup.
  function clean(v){ return String(v||'').toLowerCase().replace(/[^a-z0-9_-]/g,'').slice(0,32); }
  function originSuffix(){
    var o = origin(); if (!o) return '';
    var s = clean(o.s); if (!s) return '';
    return '.src-' + s + (clean(o.m) ? '.mdm-' + clean(o.m) : '') + (clean(o.c) ? '.cmp-' + clean(o.c) : '');
  }
  function stamp(el, attr){
    var sfx = originSuffix(); if (!sfx) return;
    var raw = el.getAttribute(attr); if (!raw) return;
    try {
      var u = new URL(raw, location.origin);
      var c = u.searchParams.get('utm_content') || '';
      if (c.indexOf('.src-') !== -1) return;       // already stamped
      u.searchParams.set('utm_content', c + sfx);
      el.setAttribute(attr, u.toString());
    } catch(e){}
  }

  document.querySelectorAll('section.capture').forEach(function(sec){
    var ifr = sec.querySelector('iframe.capture__embed');
    // Stamp BEFORE the lazy iframe fetches (the capture block sits low on the
    // page, so on a real visit this runs well ahead of the load).
    if (ifr) stamp(ifr, 'src');
    sec.querySelectorAll('.capture__fallback a, a.capture__button').forEach(function(a){ stamp(a, 'href'); });

    // PRIMARY-CTA VIEW. Fires once, when at least half the capture block has
    // actually been on screen — the missing denominator for "did anyone even
    // reach the CTA?" on a page whose CTA sits at ~87% scroll depth.
    var seen = false;
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(es){
        es.forEach(function(en){
          if (en.isIntersecting && !seen) { seen = true; fire('capture_view', ifr || sec); io.disconnect(); }
        });
      }, { threshold: 0.5 });
      io.observe(sec);
    }

    // FORM INTERACTION (proxy, and labelled as one). The form is a
    // cross-origin iframe, so clicks inside it are unreadable by design. When
    // a visitor clicks into it, focus leaves this document and lands on the
    // iframe element — that transition is the closest honest signal available
    // that someone engaged the form rather than merely scrolled past it.
    var engaged = false;
    if (ifr) {
      window.addEventListener('blur', function(){
        if (engaged) return;
        if (document.activeElement === ifr) { engaged = true; fire('capture_form_engage', ifr); }
      });
    }
  });

  // IN-PAGE CTA ROUTE (0726). global.css sets html{scroll-behavior:smooth}; a
  // default anchor jump would therefore smooth-scroll ~11,700px on this post —
  // long enough to read as a runaway page on a phone. Jump instantly instead,
  // move focus to the CTA for keyboard/screen-reader users, and record the
  // route being used as a CTA interaction.
  document.querySelectorAll('a[href="#free-guide"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var wrap = document.getElementById('free-guide'); if (!wrap) return; // no anchor here -> let the link behave normally
      // Aim at the capture block itself, not its wrapper: the wrapper's top
      // edge can leave the actual email CTA just below the fold on a phone.
      var t = wrap.querySelector('section.capture') || wrap;
      e.preventDefault();
      // behavior:'auto' RESOLVES TO THE CSS VALUE (which is smooth here), so it
      // does not force an instant jump — verified: the page was still mid-glide
      // when measured. An inline style beats the stylesheet, so override, jump,
      // restore.
      var root = document.documentElement, prev = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';
      t.scrollIntoView({ block: 'start' });
      setTimeout(function(){ root.style.scrollBehavior = prev; }, 0);
      if (history.replaceState) history.replaceState(null,'','#free-guide'); else location.hash = 'free-guide';
      var f = t.querySelector('.capture__headline');
      if (f) { f.setAttribute('tabindex','-1'); f.focus({ preventScroll: true }); }
      fire('capture_cta_nav', t.querySelector('iframe.capture__embed'));
    });
  });

  document.querySelectorAll('iframe.capture__embed').forEach(wireCapture);
</script>

<style>
  /* Mobile-first: base rules target narrow screens. */
  .capture {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    margin: 2rem 0;
    /* Sticky site header must not cover the CTA on an anchor jump (0726). */
    scroll-margin-top: 84px;
  }

  .capture__inner {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .capture__headline {
    font-family: var(--serif);
    color: var(--ink);          /* --ink on --bg-2 ≈ 15.9:1 — AA/AAA */
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0;
  }

  .capture__subtext {
    color: var(--ink-2);        /* --ink-2 on --bg-2 ≈ 8.6:1 — AA/AAA */
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Ungated crisis line (safety offer). Deliberately prominent and visible
     BEFORE the signup ask — duty of care, not a marketing element. */
  .capture__safety {
    color: var(--ink);
    background: rgba(224, 86, 59, 0.10);
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 0.75rem 0.9rem;
    font-size: 0.95rem;
    line-height: 1.5;
    font-weight: 600;
    margin: 0;
  }

  .capture-cta { margin-top: 0.35rem; }

  /* Clipping window — see the comment beside the markup above. Keeps the old
     64px height so the rest of the page does not move; max-width 400px keeps
     the crop exact. */
  .capture__embed-window {
    position: relative;
    display: block;
    width: 100%;
    max-width: 400px;
    height: 64px;
    overflow: hidden;
    margin: 0;
    border-radius: 8px;
  }

  /* Deliberately two classes deep. `global.css` carries its own unscoped
     `.capture__embed { max-width:460px; height:220px }` rule serving the
     hand-pasted iframes in older post bodies. At equal specificity that rule
     was clamping this crop's width (calc resolved, then got capped at 460px)
     and only lost the height fight on source order — which is not something to
     rely on. `.capture__embed-window .capture__embed` outranks it outright, and
     `max-width:none` explicitly releases the clamp. The global rule is left
     alone so the older pages that depend on it do not change. */
  .capture__embed-window .capture__embed {
    position: absolute;
    top: -72px;          /* crops the theme's 80px top padding, leaving 8px */
    left: -80px;         /* crops the theme's 80px left padding exactly */
    width: calc(100% + 160px);   /* +160 = the left AND right padding */
    max-width: none;     /* releases global.css's 460px clamp */
    height: 207px;       /* the form document's full natural height */
    border: 0;
    margin: 0;
    background: transparent;
    color-scheme: light;
  }

  .capture__fallback {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .capture__fallback a { color: var(--accent); }

  .capture__helper {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* Shown only after a genuine same-origin success redirect (see script). */
  .capture__success {
    margin: 0.35rem 0 0;
    padding: 0.85rem 1rem;
    background: rgba(95, 174, 126, 0.14);
    border: 1px solid rgba(95, 174, 126, 0.55);
    border-radius: 8px;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
  }
  .capture__success strong { color: var(--ink); }

  .capture__button {
    display: flex;               /* full-width, centered on mobile */
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;            /* accessible tap target */
    padding: 0.75rem 1.5rem;
    box-sizing: border-box;
    background: var(--accent);
    color: var(--bg);            /* near-black on --accent ≈ 4.98:1 — AA */
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-align: center;
    border-radius: 8px;
    transition: filter 0.15s ease, transform 0.05s ease;
  }

  .capture__button:hover { filter: brightness(1.08); }
  .capture__button:active { transform: translateY(1px); }
  .capture__button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

  @media (min-width: 640px) {
    .capture { padding: 2.25rem 2rem; }
    .capture__headline { font-size: 1.9rem; }
    .capture__button { width: auto; min-width: 240px; align-self: flex-start; }
  }
</style>
