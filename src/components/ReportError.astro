---
// Site-wide "Report an error" link (Oct 20, 2026).
// A plain mailto link. No form, no tracking, no third-party service.
// Mirrors the Court Calendar correction template on /court-calendar-policy/,
// and adds the page title (subject) and the page address (first body line).
export interface Props {
  pageTitle: string;
  pageUrl?: string;
  class?: string;
}
const {
  pageTitle,
  pageUrl = new URL(Astro.url.pathname, Astro.site).href,
  class: className,
} = Astro.props;
const CORRECTIONS_EMAIL = 'cassiancreed@cassiancreed.com';
const subject = `Site correction: ${pageTitle.replace(/\s+/g, ' ').trim()}`;
const body = [
  `Page: ${pageUrl}`,
  'Case or person name:',
  'What is wrong:',
  'What the correct information is:',
  'Official record or source (link or citation):',
  'Your name and role (optional):',
  '',
].join('\r\n');
const href = `mailto:${CORRECTIONS_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---
<a class:list={['report-error', className]} href={href}>Spot an error? Report it</a>

<style>
  .report-error{color:var(--ink);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}
  .report-error:hover{color:var(--accent)}
  .report-error:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:2px}
</style>
