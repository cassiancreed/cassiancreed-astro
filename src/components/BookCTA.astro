---
export interface RelatedBook {
  key: 'jury-chess';
  midCopy: string;
  endCopy: string;
}

export interface Props {
  book: RelatedBook;
  placement: 'mid' | 'end';
}

const { book, placement } = Astro.props;
const catalog = {
  'jury-chess': {
    title: 'Jury Chess: How Criminal Jury Trials Actually Work',
    price: '$3.99',
    cover: '/covers/jury-chess.jpg',
    coverAlt: 'Cover of Jury Chess: How Criminal Jury Trials Actually Work by Cassian Creed',
    detailsUrl: '/books/#jury-chess',
    buyUrl: 'https://cassiancreed.beehiiv.com/products/jury-chess',
  },
};
const selected = catalog[book.key];
const copy = placement === 'mid' ? book.midCopy : book.endCopy;
const pageKey = Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? 'unknown';
const buyParams = new URLSearchParams({
  utm_source: 'website',
  utm_medium: 'book_cta',
  utm_campaign: 'melgar_cluster',
  utm_content: `${pageKey}_${placement}`,
});
const buyUrl = `${selected.buyUrl}?${buyParams}`;
---

<aside class:list={['book-cta', `book-cta--${placement}`]} aria-label={`Related book: ${selected.title}`}>
  <a class="book-cta__cover" href={selected.detailsUrl} aria-label={`Learn more about ${selected.title}`}>
    <img src={selected.cover} alt={selected.coverAlt} width="600" height="900" loading="lazy" decoding="async" />
  </a>
  <div class="book-cta__body">
    <p class="book-cta__eyebrow">Read the courtroom process</p>
    <h2 class="book-cta__title">{selected.title}</h2>
    <p class="book-cta__copy">{copy}</p>
    <div class="book-cta__actions">
      <a class="btn book-cta__buy" href={buyUrl} target="_blank" rel="noopener noreferrer" data-book-key={book.key} data-cta-placement={placement}>Get the ebook — {selected.price} →</a>
      <a class="book-cta__details" href={selected.detailsUrl}>Book details</a>
    </div>
  </div>
</aside>

<style>
  .book-cta{display:grid;grid-template-columns:120px minmax(0,1fr);gap:20px;align-items:center;margin:32px 0;padding:20px;background:var(--bg-3,#15110e);border:1px solid rgba(95,174,126,.5);border-radius:12px;contain:layout paint}
  .book-cta__cover{display:block;width:120px;aspect-ratio:2/3;border-radius:6px;overflow:hidden;background:#242329;box-shadow:0 8px 18px rgba(0,0,0,.28)}
  .book-cta__cover img{display:block;width:100%;height:100%;object-fit:cover}
  .book-cta__body{min-width:0}
  .book-cta__eyebrow{font-family:var(--mono,'JetBrains Mono',monospace);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#5fae7e;margin:0 0 6px}
  .book-cta__title{font-family:var(--serif);font-weight:600;font-size:clamp(20px,3vw,25px);line-height:1.16;margin:0 0 8px}
  .book-cta__copy{font-size:15px;line-height:1.5;color:var(--ink-2);margin:0 0 14px}
  .book-cta__actions{display:flex;align-items:center;flex-wrap:wrap;gap:10px 14px}
  .book-cta__buy{text-decoration:none;text-align:center}
  .book-cta__details{color:var(--ink-2);font-size:14px;text-underline-offset:3px}
  @media(max-width:560px){
    .book-cta{grid-template-columns:84px minmax(0,1fr);gap:14px;padding:16px;margin:26px 0;align-items:start}
    .book-cta__cover{width:84px}
    .book-cta__title{font-size:19px}
    .book-cta__copy{font-size:14px}
    .book-cta__actions{display:grid;grid-template-columns:1fr;text-align:center}
    .book-cta__details{padding:7px}
  }
</style>
