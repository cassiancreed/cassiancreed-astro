---
// One short line under a buy button: "Also available on Amazon, Apple Books
// and Google Play." Links come from src/data/retail-store-links.mjs and only
// stores with a checked listing are shown. Renders nothing for other books.
import '../styles/retail-store-line.css';
import { retailStoreLinks } from '../data/retail-store-links.mjs';
const { bookKey, placement = 'retail' } = Astro.props;
const stores = retailStoreLinks(bookKey);
---
{stores.length > 0 && (
  <p class="retail-line" data-retail-for={bookKey}>Also available on {stores.map((s, i) => (
    <>{i > 0 && (i === stores.length - 1 ? ' and ' : ', ')}<a href={s.url} target="_blank" rel="noopener noreferrer" data-retail-store={s.id} data-cta-placement={`${placement}_${s.id}`}>{s.name}</a></>
  ))}.</p>
)}
