---
// NEP-20261019-GUIDE-BUTTONS: shared paid-guide button for free case explainers.
// Data and wording live in src/data/post-guide-ctas.mjs (prices from LIVE_PRODUCTS).
import '../styles/calendar-explainer-links.css';
import '../styles/post-guide-cta.css';
import { postGuideCta } from '../data/post-guide-ctas.mjs';
const { slug, placement = 'bottom' } = Astro.props;
const cta = postGuideCta(slug, placement);
---
{cta && (
  <aside class="post-guide-cta" aria-label="Paid case guide">
    <p class="post-guide-cta__k">The full case in one place</p>
    <div class="guide-offer">
      <a class="guide-btn" data-link-type="paid" href={cta.href} target="_blank" rel="noopener noreferrer" data-book-key={cta.bookKey} data-cta-placement={cta.placement}><span class="calendar-badge" data-link-type="paid" aria-hidden="true">{cta.badge}</span><span>{cta.label}</span></a>
      {cta.preview && <a class="calendar-resource" data-link-type="free" href={cta.preview.href} target="_blank" rel="noopener" data-preview-for={cta.bookKey} data-cta-placement={cta.preview.placement}><span class="calendar-badge" data-link-type="free">FREE</span><span>{cta.preview.text} →</span></a>}
    </div>
  </aside>
)}
