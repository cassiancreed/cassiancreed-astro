---
import Base from '../layouts/Base.astro';
// NE003 flagship landing page — "The Trail: The Murder of Rachel Morin"
// GREEN tier: Victor Martinez-Hernandez convicted on all counts (April 2025), two consecutive
// life terms without parole; appeal intended, no ruling (verified 2026-06-03). Rachel named first.
// PRIMARY goal: email capture (Beehiiv free dossier). SECONDARY: NE003 $1.99 on Beehiiv.
// Buy path: Beehiiv only (top sale banner). Identity: Cassian Creed, PO #1039.
const jsonld = {
  "@context": "https://schema.org",
  "@type": "Book",
  "name": "The Trail: The Murder of Rachel Morin",
  "author": { "@type": "Organization", "name": "Cassian Creed" },
  "publisher": { "@type": "Organization", "name": "Neural Edge Publishing" },
  "about": "The genetic-genealogy investigation that identified Rachel Morin's killer.",
    "offers": { "@type": "Offer", "price": "1.99", "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://cassiancreed.beehiiv.com/products/the-trail?utm_source=website&utm_medium=landing&utm_campaign=the_trail" }
};
---
<Base title="The Trail: The Murder of Rachel Morin — a sourced, victim-first case file" description="The Trail: The Murder of Rachel Morin — a victim-first case file by Cassian Creed. Read free on the site, or get the complete $1.99 case file." jsonld={jsonld}>
  <article class="lp">
    <div class="lp-sale" style="background:#e0563b;color:#fff;border-radius:10px;padding:14px 18px;margin:0 0 18px;text-align:center;font-size:15px;line-height:1.5" role="note">
<strong>The Trail is $1.99</strong> — Rachel Morin's story, told with care. <a href="https://cassiancreed.beehiiv.com/products/the-trail?utm_source=website&utm_medium=trail_sale_block&utm_campaign=the_trail_sale" style="color:#fff;font-weight:600;text-decoration:underline" target="_blank" rel="noopener noreferrer">Read it here →</a>
</div>

    <!-- HERO — single dominant CTA = email capture -->
    <section class="lp-hero" aria-labelledby="lp-h1">
      <img class="lp-hero__img" src="/covers/hero-16x9.png" alt="The Trail: The Murder of Rachel Morin — a wooded trail marked with an evidence pin" width="1672" height="941" loading="eager" />
      <p class="evidence evidence--accent">A Cassian Creed case file · sourced · victim-first</p>
      <h1 id="lp-h1">She walked a trail she had walked a hundred times. She did not come home.</h1>
      <p class="lp-sub">Rachel Morin — thirty-seven, a mother of five — was killed on a familiar Maryland trail in August 2023. Her killer had left no name in any database on earth. <strong>This is the full, sourced account of how genetic genealogy found him anyway</strong> — told with care, centered on Rachel, without gratuitous detail.</p>

      <form class="lp-capture" action="https://cassiancreed.beehiiv.com/subscribe" method="get" aria-label="Subscribe free to the Cassian Creed newsletter">
        <label class="lp-capture__label" for="lp-email">Subscribe free — we'll send you our field guide <em>The Jury Chess Game</em>, and you'll be first to each new case file.</label>
        <div class="lp-capture__row">
          <input id="lp-email" type="email" name="email" required autocomplete="email" placeholder="you@email.com" aria-label="Your email address" />
          <input type="hidden" name="utm_source" value="website" />
          <input type="hidden" name="utm_medium" value="landing_the_trail" />
          <input type="hidden" name="utm_campaign" value="jury_chess_game_guide" />
          <button class="btn" type="submit">Send me the free guide →</button>
        </div>
        <p class="lp-capture__fine">Free forever · no spam · unsubscribe anytime.</p>
      </form>

      <ul class="lp-badges" aria-label="Our standard">
        <li>✓ Sourced from the public record</li>
        <li>✓ Victims named in life first</li>
        <li>✓ AI-assisted analysis, human-verified</li>
        <li>✓ No gore, no filler</li>
      </ul>
    </section>

    <!-- WHY THIS CASE -->
    <section class="lp-block" aria-labelledby="lp-why">
      <h2 id="lp-why">A perfect DNA profile — attached to no one</h2>
      <p>Investigators built a genetic fingerprint of Rachel's attacker and ran it against CODIS, the national database of known offenders. It matched no one. For decades, that was where cases like this died. What happened next — a forensic-grade genome, a family tree built from a distant cousin's DNA, a nine-month chain of inference, and a multi-state manhunt — is one of the most consequential investigations of the decade. We lay it out step by step, from the record.</p>
    </section>

    <!-- WHAT YOU GET -->
    <section class="lp-block" aria-labelledby="lp-get">
      <h2 id="lp-get">What's inside the case file</h2>
      <ul class="lp-list">
        <li><strong>The complete timeline</strong> — the last ordinary afternoon through the verdict, built only from court filings, official statements, and contemporaneous reporting.</li>
        <li><strong>The forensic spine, in plain English</strong> — CODIS vs. investigative genetic genealogy, Othram's genome sequencing, and how a lead becomes a courtroom-grade match.</li>
        <li><strong>"The Solve: law enforcement vs A.I. AL"</strong> — our signature, honest read of what the investigators did and where an analytical lens could (and could not) have helped. We don't pretend the AI would have won.</li>
        <li><strong>A trail &amp; solo-exercise safety guide</strong> — the real, validated steps that turn this story into something that protects you and the people you love.</li>
      </ul>
    </section>

    <!-- CREDIBILITY / social proof (trust standard, honestly) -->
    <section class="lp-trust" aria-labelledby="lp-trust-h">
      <h2 id="lp-trust-h">Why you can trust this account</h2>
      <p>Every claim is tied to a primary source. Legal status is re-verified before we publish and again when a case moves. We separate what is proven from what is argued, we name the people at the center in life first, and the AI is a disclosed, human-overseen analytical lens — never the narrator or the author. When we get something wrong, we correct it. <a href="/about/">Read our full standard &amp; corrections policy →</a></p>
    </section>

    <!-- HONEST LEGAL STATUS -->
    <aside class="lp-status" aria-label="Where the case stands">
      <p><strong>Where it stands.</strong> On April 14, 2025, a Maryland jury found Victor Martinez-Hernandez guilty on all counts; he was sentenced to two consecutive life terms without the possibility of parole. He has indicated an intention to appeal; as of this writing that appeal is unresolved and the conviction stands. We note it for honesty, not because it casts doubt on the verdict.</p>
    </aside>

    <!-- FINAL capture repeat (single CTA, repeated) -->
    <section class="lp-final" aria-labelledby="lp-final-h">
      <h2 id="lp-final-h">Start with the free guide</h2>
      <p>Subscribe and we&rsquo;ll send you <em>The Jury Chess Game</em> &mdash; our free field guide to how lawyers really pick the twelve people who decide guilt or innocence. After that, we only email when we&rsquo;ve shipped something new: a fresh case file or a book. No weekly blast; unsubscribe anytime.</p>
      <form class="lp-capture" action="https://cassiancreed.beehiiv.com/subscribe" method="get" aria-label="Subscribe free to the Cassian Creed newsletter">
        <div class="lp-capture__row">
          <input id="lp-email2" type="email" name="email" required autocomplete="email" placeholder="you@email.com" aria-label="Your email address" />
          <input type="hidden" name="utm_source" value="website" />
          <input type="hidden" name="utm_medium" value="landing_the_trail_footer" />
          <input type="hidden" name="utm_campaign" value="jury_chess_game_guide" />
          <button class="btn" type="submit">Send me the free guide →</button>
        </div>
      </form>
      <p class="lp-crisis"><strong>If you need support.</strong> 988 Suicide &amp; Crisis Lifeline (call or text 988) · National Domestic Violence Hotline 1-800-799-7233 · RAINN 1-800-656-HOPE. Cassian Creed · Neural Edge Publishing · PO Box 1039.</p>
    </section>

  </article>
</Base>

<style>
  .lp{max-width:760px;margin:0 auto}
  .lp h1, .lp h2{font-family:var(--serif)}
  .lp-hero{padding:8px 0 8px}
    .lp-hero__img{display:block;width:100%;height:auto;border-radius:12px;margin-bottom:18px;box-shadow:0 16px 36px -18px rgba(0,0,0,.6)}
  #lp-h1{font-weight:600;font-size:clamp(30px,5vw,48px);line-height:1.1;margin:10px 0 16px;max-width:20ch}
  .lp-sub{color:var(--ink-2);font-size:18px;line-height:1.65;max-width:60ch;margin:0 0 24px}
  .lp-capture{background:var(--bg-2);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:0 10px 10px 0;padding:18px 20px;margin:0 0 18px}
  .lp-capture__label{display:block;color:var(--ink);font-size:15px;margin:0 0 12px}
  .lp-capture__row{display:flex;flex-wrap:wrap;gap:10px}
  .lp-capture input[type=email]{flex:1 1 220px;background:var(--bg);border:1px solid var(--line);border-radius:6px;color:var(--ink);padding:12px 14px;font-size:15px}
  .lp-capture input[type=email]:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
  .lp-capture .btn{border:0;cursor:pointer}
  .lp-capture__fine{color:var(--ink-3);font-size:12px;margin:10px 0 0}
  .lp-badges{list-style:none;display:flex;flex-wrap:wrap;gap:8px 18px;padding:0;margin:6px 0 0;color:var(--ink-2);font-size:13px}
  .lp-block{padding:26px 0;border-top:1px solid var(--line)}
  .lp-block h2, .lp-trust h2, .lp-buy h2, .lp-final h2{font-weight:600;font-size:clamp(22px,3vw,30px);margin:0 0 14px}
  .lp-block p{color:var(--ink-2);line-height:1.7;max-width:64ch}
  .lp-list{margin:0;padding:0;list-style:none;display:grid;gap:14px}
  .lp-list li{color:var(--ink-2);line-height:1.6;border-left:2px solid var(--accent);padding-left:14px;max-width:64ch}
  .lp-list strong, .lp-block strong{color:var(--ink)}
  .lp-trust{padding:26px 0;border-top:1px solid var(--line)}
  .lp-trust p{color:var(--ink-2);line-height:1.7;max-width:64ch}
  .lp-trust a, .lp-block a{color:var(--accent)}
  .lp-buy{padding:26px 0;border-top:1px solid var(--line)}
  .lp-buy__lead{color:var(--ink-2);margin:0 0 18px}
  .lp-buy__cards{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .lp-buy__card{background:var(--bg-3);border:1px solid var(--line);border-radius:10px;padding:20px;display:flex;flex-direction:column;gap:8px}
  .lp-buy__card--bundle{border-color:rgba(224,86,59,.45)}
  .lp-buy__k{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin:0}
  .lp-buy__price{font-family:var(--serif);font-size:30px;font-weight:600;margin:0;color:var(--ink)}
  .lp-buy__was{font-size:16px;color:var(--ink-3);text-decoration:line-through;font-family:var(--sans);font-weight:400}
  .lp-buy__cardsub{color:var(--ink-2);font-size:14px;margin:0}
  .lp-buy .btn{align-self:flex-start;border:0;margin-top:4px}
  .lp-buy__alt{font-size:13px;color:var(--ink-2)}
  .lp-buy__alt:hover{color:var(--accent)}
  .lp-status{background:var(--bg-2);border:1px solid var(--line);border-radius:8px;padding:16px 18px;margin:26px 0 0}
  .lp-status p{color:var(--ink-2);font-size:14px;line-height:1.6;margin:0;max-width:70ch}
  .lp-final{padding:30px 0 10px;border-top:1px solid var(--line);margin-top:26px}
  .lp-final p{color:var(--ink-2);max-width:60ch}
  .lp-crisis{color:var(--ink-3);font-size:13px;line-height:1.6;margin-top:18px}
  .lp-crisis strong{color:var(--ink-2)}
  @media(max-width:640px){.lp-buy__cards{grid-template-columns:1fr}}
</style>
