---
// MOCKUP v2 (Nov 20, 2026): cable-guide MATRIX (channels down the left, days across the top, shows as blocks). Earlier v1 was a day list.
// (was) TV-guide layout for upcoming true crime on TV and streaming.
// Preview only. Every row below was reported by a research seat and NOT yet opened by us,
// so each shows "Unconfirmed" or "2 sources" as the seats reported. Plain channel names, no logos yet.
import Base from '../layouts/Base.astro';
import CertaintyBadge from '../components/CertaintyBadge.astro';
import CertaintyLegend from '../components/CertaintyLegend.astro';
const rows = [
  { d:'2026-11-21', t:'9:00 PM', ch:'Oxygen', show:'Prosecuting Evil with Kelly Siegler: "Blood Against Blood" (new)', src:1 },
  { d:'2026-11-21', t:'10:00 PM', ch:'Oxygen', show:'Homicide for the Holidays: "Season of Secrets" (new)', src:1 },
  { d:'2026-11-21', t:'8:00 PM', ch:'CBS', show:'48 Hours: no episode, football-style preemption listed (NWSL Championship)', src:2, note:true },
  { d:'2026-11-22', t:'All day', ch:'Peacock', show:'Homicide for the Holidays, season 6A arrives', src:2 },
  { d:'2026-11-22', t:'9:00 PM', ch:'Oxygen', show:'Snapped: Killer Moms: "Sarah Hartsfield" (new)', src:1 },
  { d:'2026-11-23', t:'All day', ch:'Netflix', show:'The Trials of Karen Read (docuseries)', case:'Karen Read', link:'/post/karen-read-was-acquitted-of-killing-john-o-keefe-his-family-is-still-waiting-for-answers/', spike:'One day before the O’Keefe family civil-case hearing (Nov. 24, on our Court Calendar).', calId:'read-okeefe-wrongful-death-rule56-2026-11-24', src:3 },
  { d:'2026-11-23', t:'10:00 PM', ch:'Investigation Discovery', show:'Murder University: "Screams in the Snow" (new)', src:1 },
  { d:'2026-11-24', t:'9:00 PM', ch:'Investigation Discovery', show:'Deadly Women 2.0: "Fantasy Land" (new)', src:1 },
  { d:'2026-11-24', t:'10:00 PM', ch:'Investigation Discovery', show:'I Want to Kill My Boss: "Top Gunned" (series premiere)', src:1 },
  { d:'2026-11-26', t:'All day', ch:'Netflix', show:'Toos: The Van der Valk Kidnapping (scripted, based on a real case)', src:2 },
  { d:'2026-11-28', t:'9:00 PM', ch:'CBS', show:'48 Hours: "Jade Benning’s Final Call" (repeat)', src:1 },
  { d:'2026-11-28', t:'10:00 PM', ch:'CBS', show:'48 Hours: "Sarah Mattered" (new)', src:2 },
  { d:'2026-11-28', t:'10:00 PM', ch:'Oxygen', show:'Homicide for the Holidays: "Murder Under the Christmas Tree" (new)', src:1 },
  { d:'2026-11-30', t:'All day', ch:'Prime Video', show:'The Boy Who Stole Billions?', src:1 },
  { d:'2026-12-01', t:'10:00 PM', ch:'Investigation Discovery', show:'I Want to Kill My Boss: "Terror in the Toy Store" (new)', src:2 },
  { d:'2026-12-03', t:'9:00 PM', ch:'Investigation Discovery', show:'My Brother’s Killer (TV premiere; 1990 West Hollywood murder)', src:2 },
  { d:'2026-12-03', t:'All day', ch:'Hulu', show:'Meet, Marry, Murder, season 2 arrives (older show)', src:2 },
  { d:'2026-12-04', t:'All day', ch:'Netflix', show:'Who Killed the Banker’s Widow? (documentary, Spain)', src:2 },
  { d:'2026-12-04', t:'10:16 PM', ch:'NBC', show:'Dateline NBC (title not yet announced)', src:2, tba:true },
  { d:'2026-12-12', t:'All day', ch:'Netflix', show:'Phoenix Jones: The Rise and Fall of a Real Life Superhero (Seattle)', src:2 },
  { d:'2026-12-16', t:'All day', ch:'Netflix', show:'A Deadly Affair: The Pamela Smart Story (documentary)', case:'Pamela Smart', src:2 },
  { d:'2026-12-28', t:'All day', ch:'Prime Video', show:'One Night in Idaho: Catching a Killer', case:'The Idaho student murders', link:'/post/what-happened-in-the-idaho-student-murders-the-bryan-kohberger-case-explained/', src:2, later:true },
];
const CH = ['Oxygen','Investigation Discovery','NBC','CBS','Netflix','Peacock','Hulu','Prime Video'];
const chans = CH.filter(c => rows.some(r => r.ch === c));
const iso = d => d.toISOString().slice(0,10);
const addDays = (s,n) => { const d = new Date(s+'T12:00:00Z'); d.setUTCDate(d.getUTCDate()+n); return iso(d); };
const weeks = [];
for (let s='2026-11-21'; s <= '2026-12-28'; s = addDays(s,7)) weeks.push({ start:s, days:[0,1,2,3,4,5,6].map(i => addDays(s,i)) });
const fmt = (s,o) => new Date(s+'T12:00:00Z').toLocaleDateString('en-US',{timeZone:'UTC',...o});
const weekHas = w => rows.some(r => w.days.includes(r.d));
// Certainty (checked Nov 21, 2026 against the Court Date Watcher schedule): air dates are seat-reported, so every row starts Unconfirmed.
// A row is Reported only where that schedule lists two independent sources for it.
const REPORTED = ['Sarah Mattered','Terror in the Toy Store','Jade Benning'];
const level = r => REPORTED.some(t => r.show.includes(t)) ? 'reported' : 'unconfirmed';
const timeKey = r => r.t==='All day' ? 0 : (()=>{const m=r.t.match(/(\d+):(\d+) (AM|PM)/);return ((+m[1]%12)+(m[3]==='PM'?12:0))*60+ +m[2];})();
---
<Base title="Watch Guide | Cassian Creed" description="Upcoming true crime on TV and streaming, laid out like a cable guide.">
  <section class="wrap wg">
    <header>
      <h1>Watch Guide</h1>
      <p>Upcoming true crime on TV and streaming, laid out like the cable guide: channels down the left, days across the top, each show a block. Times are Eastern. Schedules change, and TV lists only about two weeks ahead.</p>
      <p class="wg-note">Each block carries a badge for how sure we are. "1 source" means we have not yet seen a second listing. Names and logos belong to their owners; this site is not affiliated with these channels. People who are charged or accused are presumed innocent unless and until proven guilty.</p>
      <CertaintyLegend />
      <nav class="wg-jump" aria-label="Jump to a week">
        {weeks.map(w => <a href={`#w-${w.start}`}>{fmt(w.start,{month:'short',day:'numeric'})} &ndash; {fmt(w.days[6],{month:'short',day:'numeric'})}</a>)}
      </nav>
    </header>

    {weeks.map(w => (
      <section class="wg-week" id={`w-${w.start}`} aria-labelledby={`wh-${w.start}`}>
        <h2 id={`wh-${w.start}`}>Week of {fmt(w.start,{month:'long',day:'numeric'})}</h2>
        {weekHas(w) ? (
          <div class="wg-scroll" tabindex="0" role="region" aria-label={`Guide for the week of ${fmt(w.start,{month:'long',day:'numeric'})}, scrolls sideways`}>
            <table class="wg-matrix">
              <thead><tr><th scope="col" class="wg-corner">Channel</th>{w.days.map(d => <th scope="col"><span>{fmt(d,{weekday:'short'})}</span> {fmt(d,{month:'short',day:'numeric'})}</th>)}</tr></thead>
              <tbody>
                {chans.map(c => (
                  <tr>
                    <th scope="row" class="wg-chan">{c}</th>
                    {w.days.map(d => {
                      const cell = rows.filter(r => r.ch===c && r.d===d).sort((a,b)=>timeKey(a)-timeKey(b));
                      return <td>{cell.length ? cell.map(r => (
                        <div class="wg-block" data-n={r.src}>
                          <span class="wg-t">{r.t}</span>
                          <strong>{r.show}</strong>
                          {r.case && <em class="wg-case">Case: {r.link ? <a href={r.link}>{r.case}</a> : r.case}</em>}
                          {r.spike && <em class="wg-spike">{r.spike} <a href={`/court-calendar/#${r.calId}`}>Court date &rarr;</a></em>}
                          <span class="wg-src"><CertaintyBadge level={level(r)} checked="Nov. 21" /></span>
                        </div>
                      )) : <span class="wg-none" aria-label="nothing listed">&ndash;</span>}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="wg-note">Networks and services have not posted this week yet. We check again each week.</p>
        )}
      </section>
    ))}

    <p class="wg-note">This is a schedule, not a review. See also: <a href="/court-calendar/">Court Calendar</a>.</p>
  </section>
</Base>

<style>
  .wg{max-width:1200px;padding-top:36px;padding-bottom:56px}
  .wg h1{font-family:var(--serif);font-size:clamp(36px,6vw,58px);line-height:1.1;margin:12px 0 20px}
  .wg header>p{max-width:72ch}
  .wg-note{font-size:14px;color:var(--ink-2)}
  .wg-jump{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 0}
  .wg-jump a{border:1px solid var(--line-strong,var(--line));border-radius:999px;padding:6px 12px;font-size:14px}
  .wg-week{margin-top:34px;scroll-margin-top:24px}
  .wg-week h2{font-family:var(--serif);font-size:30px;margin:0 0 12px}
  .wg-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--bg-2)}
  .wg-matrix{border-collapse:collapse;width:100%;min-width:1080px;table-layout:fixed}
  .wg-matrix th,.wg-matrix td{border:1px solid var(--line);padding:8px;vertical-align:top;text-align:left;font-size:14px}
  .wg-matrix thead th{background:var(--bg-3);font-weight:600;position:sticky;top:0}
  .wg-matrix thead th span{color:var(--accent-2,var(--ink-2));text-transform:uppercase;font-size:12px;letter-spacing:.05em;margin-right:4px}
  .wg-corner,.wg-chan{width:132px;position:sticky;left:0;background:var(--bg-3);z-index:1}
  .wg-chan{font-weight:700;color:var(--accent-2,var(--ink));font-size:14px}
  .wg-block{border-left:3px solid var(--accent);background:var(--bg-3);border-radius:4px;padding:6px 8px;margin-bottom:6px}
  .wg-block[data-n="1"]{border-left-color:var(--ink-3)}
  .wg-block:last-child{margin-bottom:0}
  .wg-t{display:block;font-size:12px;color:var(--ink-2);font-variant-numeric:tabular-nums}
  .wg-block strong{display:block;font-weight:600;line-height:1.3;overflow-wrap:anywhere}
  .wg-block em{display:block;font-style:normal;font-size:12px;color:var(--ink-2);margin-top:3px}
  .wg-src{display:inline-flex;align-items:center;font-size:inherit;color:var(--ink-3);margin:2px 0 0}
  .wg-none{color:var(--ink-3)}
</style>
