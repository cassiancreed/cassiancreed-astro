---
// MOCKUP (Nov 20, 2026): TV-guide layout for upcoming true crime on TV and streaming.
// Preview only. Every row below was reported by a research seat and NOT yet opened by us,
// so each shows "Unconfirmed" or "2 sources" as the seats reported. Plain channel names, no logos yet.
import Base from '../layouts/Base.astro';
const rows = [
  { d:'2026-11-21', t:'9:00 PM', ch:'Oxygen', show:'Prosecuting Evil with Kelly Siegler: "Blood Against Blood" (new)', src:1 },
  { d:'2026-11-21', t:'10:00 PM', ch:'Oxygen', show:'Homicide for the Holidays: "Season of Secrets" (new)', src:1 },
  { d:'2026-11-21', t:'8:00 PM', ch:'CBS', show:'48 Hours: no episode, football-style preemption listed (NWSL Championship)', src:2, note:true },
  { d:'2026-11-22', t:'All day', ch:'Peacock', show:'Homicide for the Holidays, season 6A arrives', src:2 },
  { d:'2026-11-22', t:'9:00 PM', ch:'Oxygen', show:'Snapped: Killer Moms: "Sarah Hartsfield" (new)', src:1 },
  { d:'2026-11-23', t:'All day', ch:'Netflix', show:'The Trials of Karen Read (docuseries)', case:'Karen Read', link:'/post/karen-read-was-acquitted-of-killing-john-o-keefe-his-family-is-still-waiting-for-answers/', spike:'One day before the O’Keefe family civil-case hearing (Nov. 24, on our Court Calendar).', calId:'read-okeefe-wrongful-death-rule56-2026-11-24', src:3 },
  { d:'2026-11-23', t:'10:00 PM', ch:'Investigation Discovery', show:'Murder University: "Screams in the Snow" (new)', src:1 },
  { d:'2026-11-24', t:'9:00 PM', ch:'Investigation Discovery', show:'Deadly Women 2.0: "Fantasy Land" (new)', src:1 },
  { d:'2026-11-24', t:'10:00 PM', ch:'Investigation Discovery', show:'I Want to Kill My Boss: "Top Gunned" (series premiere)', src:1 },
  { d:'2026-11-26', t:'All day', ch:'Netflix', show:'Toos: The Van der Valk Kidnapping (scripted, based on a real case)', src:2 },
  { d:'2026-11-28', t:'9:00 PM', ch:'CBS', show:'48 Hours: "Jade Benning’s Final Call" (repeat)', src:1 },
  { d:'2026-11-28', t:'10:00 PM', ch:'CBS', show:'48 Hours: "Sarah Mattered" (new)', src:2 },
  { d:'2026-11-28', t:'10:00 PM', ch:'Oxygen', show:'Homicide for the Holidays: "Murder Under the Christmas Tree" (new)', src:1 },
  { d:'2026-11-30', t:'All day', ch:'Prime Video', show:'The Boy Who Stole Billions?', src:1 },
  { d:'2026-12-01', t:'10:00 PM', ch:'Investigation Discovery', show:'I Want to Kill My Boss: "Terror in the Toy Store" (new)', src:2 },
  { d:'2026-12-03', t:'9:00 PM', ch:'Investigation Discovery', show:'My Brother’s Killer (TV premiere; 1990 West Hollywood murder)', src:2 },
  { d:'2026-12-03', t:'All day', ch:'Hulu', show:'Meet, Marry, Murder, season 2 arrives (older show)', src:2 },
  { d:'2026-12-04', t:'All day', ch:'Netflix', show:'Who Killed the Banker’s Widow? (documentary, Spain)', src:2 },
  { d:'2026-12-04', t:'10:16 PM', ch:'NBC', show:'Dateline NBC (title not yet announced)', src:2, tba:true },
  { d:'2026-12-12', t:'All day', ch:'Netflix', show:'Phoenix Jones: The Rise and Fall of a Real Life Superhero (Seattle)', src:2 },
  { d:'2026-12-16', t:'All day', ch:'Netflix', show:'A Deadly Affair: The Pamela Smart Story (documentary)', case:'Pamela Smart', src:2 },
  { d:'2026-12-28', t:'All day', ch:'Prime Video', show:'One Night in Idaho: Catching a Killer', case:'The Idaho student murders', link:'/post/what-happened-in-the-idaho-student-murders-the-bryan-kohberger-case-explained/', src:2, later:true },
];
const days = [...new Set(rows.map(r => r.d))];
const dayLabel = d => new Date(d+'T12:00:00-08:00').toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',timeZone:'America/Los_Angeles'});
const dayShort = d => new Date(d+'T12:00:00-08:00').toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',timeZone:'America/Los_Angeles'});
const badge = r => r.src>=3 ? '3 sources' : r.src===2 ? '2 sources' : '1 source';
---
<Base title="Watch Guide (mockup) | Cassian Creed" description="Upcoming true crime on TV and streaming, laid out like a TV guide." noindex={true}>
  <section class="wrap wg">
    <header>
      <p class="evidence evidence--accent">Mockup preview, not live</p>
      <h1>Watch Guide</h1>
      <p>Upcoming true crime on TV and streaming, day by day, like the guide you grew up with. Times are Eastern. Schedules change, and TV lists only about two weeks ahead.</p>
      <p class="wg-note">Each row shows how many sources list it. "1 source" means we have not yet seen a second listing. Names and logos belong to their owners; this site is not affiliated with these channels. People who are charged or accused are presumed innocent unless and until proven guilty.</p>
      <nav class="wg-jump" aria-label="Jump to a day">
        {days.map(d => <a href={`#d-${d}`}>{dayShort(d)}</a>)}
      </nav>
    </header>

    {days.map(d => (
      <section class="wg-day" id={`d-${d}`} aria-labelledby={`h-${d}`}>
        <h2 id={`h-${d}`}>{dayLabel(d)}</h2>
        <div class="wg-grid" role="table" aria-label={`Shows on ${dayLabel(d)}`}>
          <div class="wg-head" role="row"><span role="columnheader">Channel</span><span role="columnheader">Time</span><span role="columnheader">Show</span><span role="columnheader">Check</span></div>
          {rows.filter(r => r.d===d).map(r => (
            <div class="wg-row" role="row">
              <span class="wg-ch" role="cell">{r.ch}</span>
              <span class="wg-time" role="cell">{r.t}</span>
              <span class="wg-show" role="cell">
                <strong>{r.show}</strong>
                {r.case && <em class="wg-case">The case: {r.link ? <a href={r.link}>{r.case}</a> : r.case}</em>}
                {r.spike && <em class="wg-spike">{r.spike} <a href={`/court-calendar/#${r.calId}`}>Court date &rarr;</a></em>}
                {r.later && <em class="wg-spike">Farthest-out title we have seen.</em>}
              </span>
              <span class="wg-src" role="cell" data-n={r.src}>{badge(r)}</span>
            </div>
          ))}
        </div>
      </section>
    ))}

    <p class="wg-note">Dates after about two weeks are thin because networks have not posted them yet. We check again each week. This is a schedule, not a review. See also: <a href="/court-calendar/">Court Calendar</a>.</p>
  </section>
</Base>

<style>
  .wg{max-width:1000px;padding-top:36px;padding-bottom:56px}
  .wg h1{font-family:var(--serif);font-size:clamp(36px,6vw,58px);line-height:1.1;margin:12px 0 20px}
  .wg header>p{max-width:72ch}
  .wg-note{font-size:14px;color:var(--ink-2)}
  .wg-jump{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 0}
  .wg-jump a{border:1px solid var(--line-strong,var(--line));border-radius:999px;padding:6px 12px;font-size:14px}
  .wg-day{margin-top:34px;scroll-margin-top:24px}
  .wg-day h2{font-family:var(--serif);font-size:30px;margin:0 0 12px}
  .wg-grid{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--bg-2)}
  .wg-head,.wg-row{display:grid;grid-template-columns:170px 90px minmax(0,1fr) 100px;gap:14px;padding:12px 16px;align-items:start}
  .wg-head{background:var(--bg-3);font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-3)}
  .wg-row{border-top:1px solid var(--line)}
  .wg-ch{font-weight:700;color:var(--accent-2,var(--ink))}
  .wg-time{font-variant-numeric:tabular-nums}
  .wg-show strong{display:block;font-weight:600}
  .wg-show em{display:block;font-style:normal;font-size:14px;color:var(--ink-2);margin-top:4px}
  .wg-spike{border-left:3px solid var(--accent);padding-left:8px}
  .wg-src{font-size:13px;color:var(--ink-2)}
  .wg-src[data-n="1"]{color:var(--ink-3)}
  @media(max-width:700px){
    .wg-head{display:none}
    .wg-row{grid-template-columns:1fr auto;grid-template-areas:"ch time" "show show" "src src";gap:6px 12px}
    .wg-ch{grid-area:ch}.wg-time{grid-area:time;text-align:right}.wg-show{grid-area:show}.wg-src{grid-area:src}
  }
</style>
