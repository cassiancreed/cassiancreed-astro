  "name": "Forensic Tools — Cassian Creed",
  "description": "How A.I. AL analyzes crime: the interdisciplinary methods behind how cases get solved and how the missing are found — aimed at the truth, never at impugning the innocent.",
  "url": "https://cassiancreed.com/forensic-tools/"
};
const tools = [
  { href: "/ai-al/", tag: "A.I. AL", title: "Meet A.I. AL", blurb: "The forensic mind behind every case file — and the one rule it won't break: never name the wrong person. How it converges on the guilty, refuses a false confession, and withholds when no one can honestly be named, shown on three real cases." },
  { href: "/post/how-are-missing-people-found-the-science-of-the-search/", tag: "The Search", title: "The Science of the Search", blurb: "The math that found a sunken submarine — used to find missing people. Plus lost-person-behavior data, grave-detection science, and the database that reunites the missing with the unidentified." },
  { href: "/post/how-investigators-search-for-a-victims-remains/", tag: "The Remains", title: "Finding the Remains", blurb: "When a body is hidden, the search becomes a problem of time and space — rebuilt from timelines, cell-site pings, vehicle movement, and geography. Why some searches, like Harmony Montgomery's, remain agonizingly unfinished." },
  { href: "/post/reading-the-crime-scene-what-forensics-reveals/", tag: "The Scene", title: "Reading the Crime Scene", blurb: "A scene is a record of what happened — if you can read it. From Locard's 'every contact leaves a trace' to DNA, and the honest line between the methods that hold up and the ones that have jailed the innocent." },
  { href: "/post/how-investigators-weigh-evidence-plain-english/", tag: "The Logic", title: "How Investigators Weigh Evidence", blurb: "The quiet logic under every solved case, in plain English: how a clue 'nudges' the odds, why one amazing piece of evidence still isn't enough, and why the reasoning that catches the guilty is what protects the innocent. No math degree required." },
  { href: "/post/warning-signs-the-science-validates-a-safety-system/", tag: "Protect", title: "The Warning Signs That Are Real", blurb: "Our forensics turned into prevention: the danger signs the research actually validates — intimate-partner lethality, strangulation, coercive control, stalking — and exactly what to do about each. The science, pointed at keeping you safe." },
  { href: "/how-forensic-genetic-genealogy-works/", tag: "DNA", title: "Investigative Genetic Genealogy", blurb: "How DNA and family trees crack cold cases that were unsolvable a decade ago — the science behind the Golden State Killer and Rachel Morin arrests." },
  { href: "/post/why-do-some-murders-go-unsolved-linkage-blindness/", tag: "Linkage", title: "Linkage Blindness", blurb: "Why related cases go unconnected across jurisdictions, why overlooked victims fall through the cracks, and how public data is starting to catch what humans miss." },
