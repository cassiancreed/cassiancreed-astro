---
import Base from '../layouts/Base.astro';
import HomeCourtCalendar from '../components/HomeCourtCalendar.astro';
import CaptureBlock from '../components/CaptureBlock.astro';

import calendarTsv from '../data/court-calendar.tsv?raw';
import { formatCalendarDate, parseCourtCalendar } from '../data/court-calendar-parser.mjs';
import internationalTsv from '../data/international-watch.tsv?raw';
import { parseInternationalWatch } from '../data/international-watch-parser.mjs';
import { rankByTrend, rankCalendarEntries } from '../data/calendar-display-priority.mjs';

// All editable calendar content lives in one spreadsheet-style TSV file.
// Replace or edit src/data/court-calendar.tsv; the parser validates every row
// before Astro can build or publish the page.
const calendar = parseCourtCalendar(calendarTsv);
const international = parseInternationalWatch(internationalTsv);
const toScheduled = (entry) => ({
  id: entry.id,
  case: entry.case,
  proceeding: entry.matter,
  dateISO: entry.dateISO,
  dateText: entry.dateText,
  timezone: entry.timezone,
  timeStatus: entry.timeStatus,
  court: entry.court,
  docket: entry.docket,
  verified: entry.verified,
  ongoing: false,
  groups: ['next'],
  status: entry.status,
  detail: entry.detail,
  nextNote: entry.nextNote,
  src: entry.src,
  srcLabel: entry.srcLabel,
  srcType: entry.srcType,
  src2: entry.src2,
  srcLabel2: entry.srcLabel2,
  link: entry.link,
  linkText: entry.linkText,
  link2: null,
  linkText2: null,
  faqQuestion: entry.faqQuestion,
  country: entry.country,
});
const toPassive = (entry, section) => ({
  id: entry.id,
  case: entry.case,
  type: section === 'appeal' ? entry.matter : null,
  proceeding: entry.matter,
  where: entry.court ? `${entry.court}, ${entry.country}` : `${entry.country} — no court proceeding`,
  timezone: entry.timezone,
  timeStatus: entry.timeStatus,
  docket: entry.docket,
  verified: entry.verified,
  status: entry.status,
  note: entry.detail,
  nextNote: entry.nextNote,
  src: entry.src,
  srcLabel: entry.srcLabel,
  srcType: entry.srcType,
  src2: entry.src2,
  srcLabel2: entry.srcLabel2,
  link: entry.link,
  linkText: entry.linkText,
  faqQuestion: entry.faqQuestion,
  country: entry.country,
});
const internationalAppeals = international.monitoring.filter((entry) => /appeal|decision reserved/i.test(entry.matter));
const internationalUndated = international.monitoring.filter((entry) => !internationalAppeals.includes(entry));
const entries = [...calendar.entries, ...international.listed.map(toScheduled)];
const appeals = rankByTrend([...calendar.appeals, ...internationalAppeals.map((entry) => toPassive(entry, 'appeal'))]);
const unconfirmed = rankByTrend([
  ...calendar.unconfirmed,
  ...internationalUndated.filter((entry) => entry.court).map((entry) => toPassive(entry, 'unconfirmed')),
]);
const investigations = rankByTrend([
  ...calendar.investigations,
  ...internationalUndated.filter((entry) => !entry.court).map((entry) => toPassive(entry, 'investigation')),
]);
const completed = rankByTrend([
  ...calendar.completed,
  ...international.concluded.map((entry) => toPassive(entry, 'completed')),
]);
const latestReview = [calendar.metadata.last_updated, international.metadata.last_updated].sort().at(-1);
const LAST_UPDATED = formatCalendarDate(latestReview);
const PAGE_TITLE = calendar.metadata.page_title;
const PAGE_DESCRIPTION = calendar.metadata.page_description;
const localDateParts = Object.fromEntries(
  new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Los_Angeles',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  })
    .formatToParts(new Date())
    .filter((part) => part.type !== 'literal')
    .map((part) => [part.type, part.value]),
);
const BUILD_DATE = `${localDateParts.year}-${localDateParts.month}-${localDateParts.day}`;

const CORRECTION_EMAIL = 'cassiancreed@cassiancreed.com';

const NO_DATE = 'No confirmed upcoming court date found.';
const TIME_NOT_VERIFIED = 'The time has not been publicly verified.';

// An entry disappears only when it is finished, never merely because its start
// date has passed. `ongoing: true` pins a proceeding that is actively running;
// finished matters are moved by hand into `completed`, never dropped silently.
const isUpcoming = (e) => e.ongoing === true || e.dateISO >= BUILD_DATE;
const byGroup = (g) => entries.filter((e) => e.groups.includes(g) && isUpcoming(e));
const nextDates = rankCalendarEntries(byGroup('next'));
// Readers arrive asking one of two questions: what is happening in a courtroom
// right now, and what is on a calendar next. `ongoing` splits the two.
const inCourtNow = nextDates.filter((e) => e.ongoing === true);
const upcomingDates = nextDates.filter((e) => e.ongoing !== true);

const faqRows = [
  ...entries.map((row) => ({ ...row, section: 'scheduled' })),
  ...unconfirmed.map((row) => ({ ...row, section: 'unconfirmed' })),
  ...appeals.map((row) => ({ ...row, section: 'appeal' })),
  ...investigations.map((row) => ({ ...row, section: 'investigation' })),
  ...completed.map((row) => ({ ...row, section: 'completed' })),
];
// Every proceeding is written out once, in its own entry. A FAQ answer is a
// pointer to that one entry, not a second copy of it: it carries the date, the
// court, and the legal posture, and then links to the canonical entry for the
// rest. The posture is never trimmed, because that is where the presumption of
// innocence and the charged-is-not-convicted language live.
const faqAnswer = (row) => {
  if (row.section === 'scheduled') return `${row.dateText} at ${row.court}. ${row.status}`;
  return row.status;
};
// Ids only resolve for entries the page actually renders, so a FAQ never links
// to an anchor that is not there.
const renderedIds = new Set([
  ...nextDates.map((e) => e.id),
  ...unconfirmed.map((e) => e.id),
  ...appeals.map((e) => e.id),
  ...investigations.map((e) => e.id),
  ...completed.map((e) => e.id),
]);
const caseFaqs = faqRows
  .filter((row) => row.faqQuestion)
  .map((row) => ({
    question: row.faqQuestion,
    answer: faqAnswer(row),
    anchor: renderedIds.has(row.id) ? `#${row.id}` : null,
    caseName: row.case,
  }));
const genericFaqs = [
  {
    question: 'Can these dates change?',
    answer: 'Yes, and they often do. Hearings get continued, trials get pushed, and courts reschedule with little notice. Treat every date here as the best current information, not a promise.',
  },
  {
    question: 'How are these dates verified?',
    answer: "Each one traces to a court filing, a prosecutor's office, a state agency record, or courtroom reporting. We review the calendar daily, and each entry names its source.",
  },
];
const allFaqs = [...caseFaqs, ...genericFaqs];

const CASE_GUIDES = {
  'patterson-appeal': {
    url: 'https://cassiancreed.beehiiv.com/products/case-chess-erin-patterson',
    text: 'Read the Erin Patterson case explainer — $2.99',
    bookKey: 'case-chess-erin-patterson',
    placement: 'court_calendar_case_guide',
  },
};

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://cassiancreed.com/#org' },
    {
      '@type': 'WebSite',
      '@id': 'https://cassiancreed.com/#website',
      url: 'https://cassiancreed.com/',
      name: 'Cassian Creed',
      publisher: { '@id': 'https://cassiancreed.com/#org' },
    },
    {
      '@type': 'CollectionPage',
      '@id': 'https://cassiancreed.com/court-calendar#page',
      url: 'https://cassiancreed.com/court-calendar',
      name: PAGE_TITLE,
      description: PAGE_DESCRIPTION,
      isPartOf: { '@id': 'https://cassiancreed.com/#website' },
      publisher: { '@id': 'https://cassiancreed.com/#org' },
      dateModified: latestReview,
      mainEntity: { '@id': 'https://cassiancreed.com/court-calendar#schedule' },
    },
    {
      '@type': 'ItemList',
      '@id': 'https://cassiancreed.com/court-calendar#schedule',
      name: 'Scheduled court proceedings',
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: nextDates.length,
      itemListElement: nextDates.map((e, i) => {
        const parts = e.court.split(', ');
        const locality = parts.length > 2 ? parts[parts.length - 2] : parts[1];
        const region = parts.length > 2 ? parts[parts.length - 1] : parts[2];
        const caseUrl = e.link ? (e.link.startsWith('http') ? e.link : 'https://cassiancreed.com' + e.link) : null;
        return {
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'Event',
            '@id': 'https://cassiancreed.com/court-calendar#' + e.id,
            name: e.case + ' — ' + e.proceeding,
            startDate: e.dateISO,
            eventStatus: 'https://schema.org/EventScheduled',
            eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
            location: {
              '@type': 'Place',
              name: parts[0],
              address: {
                '@type': 'PostalAddress',
                addressLocality: locality,
                addressRegion: region,
                addressCountry: e.country || 'US',
              },
            },
            description: e.status,
            url: 'https://cassiancreed.com/court-calendar#' + e.id,
            about: { '@type': 'Thing', name: e.case },
            isAccessibleForFree: true,
            ...(caseUrl ? { subjectOf: { '@type': 'WebPage', url: caseUrl } } : {}),
          },
        };
      }),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://cassiancreed.com/court-calendar#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cassiancreed.com/' },
        { '@type': 'ListItem', position: 2, name: 'True Crime Court Calendar', item: 'https://cassiancreed.com/court-calendar' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://cassiancreed.com/court-calendar#faq',
      mainEntity: allFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---
<Base
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  jsonld={jsonld}
  internalLinksOnly
>
  <HomeCourtCalendar fullPage />

  <nav class="wrap cal-quick-links" aria-label="Court calendar resources">
    <a href="#in-court-now">In court now</a>
    <a href="#next-dates">Detailed entries</a>
    <a href="/court-calendar/archive/">Closed cases</a>
    <a href="/support/">Report a correction</a>
  </nav>

  <section class="wrap cal-sec" aria-labelledby="in-court-now">
    <h2 id="in-court-now">In Court Now</h2>
    <p class="cal-sub">Trials and proceedings actively underway, including matters where a verdict could come at any time.</p>
    <div class="cards">
      {inCourtNow.map((e) => (
        <article class="card card--live" id={e.id}>
          <p class="card__type">{e.proceeding}</p>
          <h3 class="card__case">{e.case}</h3>
          <p class="card__when"><span class="card__k">Proceeding began</span><time datetime={e.dateISO}>{e.dateText}</time></p>
          <p class="card__court">{e.court}</p>
          {e.docket && <p class="card__docket">{e.docket}</p>}
          <p class="card__status"><span class="card__k">Status</span> {e.status}</p>
          <p class="card__detail">{e.detail}</p>
          {e.nextNote && <p class="card__nodate"><span class="card__k">Next development</span> {e.nextNote}</p>}
          <p class="card__meta">
            <span class="card__change">All dates are subject to change by the court.</span>
          </p>
          <p class="card__src">
            <span class="card__k">Source</span>
            <span>{e.srcLabel}</span>
            <span class="card__srctype">{e.srcType}</span>
            {e.src2 && <span class="card__src2">{e.srcLabel2}</span>}
          </p>
          <p class="card__links">
            {e.link ? (
              <a class="card__read" href={e.link}>{e.linkText} &rarr;</a>
            ) : (
              <span class="card__soon">Our case file on this is in progress.</span>
            )}
            {e.link2 && <a class="card__read" href={e.link2}>{e.linkText2} &rarr;</a>}
            <a class="card__help" href="/support/">Victim &amp; Reader Resources</a>
            <a class="card__help" href="/support/">Report a correction</a>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap cal-sec" aria-labelledby="next-dates">
    <h2 id="next-dates">Upcoming Dates</h2>
    <p class="cal-sub">Hard dates ahead, in date order. Every date traces to a named source.</p>
    <div class="cards">
      {upcomingDates.map((e) => (
        <article class="card" id={e.id}>
          <p class="card__type">{e.proceeding}</p>
          <h3 class="card__case">{e.case}</h3>
          <p class="card__when"><time datetime={e.dateISO}>{e.dateText}</time></p>
          {e.timeStatus === 'tentative' && <p class="card__nodate"><strong>Tentative:</strong> This expected date is sourced but not yet confirmed by the court.</p>}
          {e.timeStatus === 'not publicly verified' && <p class="card__nodate">{TIME_NOT_VERIFIED}</p>}
          <p class="card__court">{e.court}</p>
          {e.docket && <p class="card__docket">{e.docket}</p>}
          <p class="card__status"><span class="card__k">Status</span> {e.status}</p>
          <p class="card__detail">{e.detail}</p>
          {e.nextNote && <p class="card__nodate"><span class="card__k">Next court date</span> {e.nextNote}</p>}
          <p class="card__meta">
            <span class="card__change">All dates are subject to change by the court.</span>
          </p>
          <p class="card__src">
            <span class="card__k">Source</span>
            <span>{e.srcLabel}</span>
            <span class="card__srctype">{e.srcType}</span>
            {e.src2 && <span class="card__src2">{e.srcLabel2}</span>}
          </p>
          <p class="card__links">
            {e.link ? (
              <a class="card__read" href={e.link}>{e.linkText} &rarr;</a>
            ) : (
              <span class="card__soon">Our case file on this is in progress.</span>
            )}
            {e.link2 && <a class="card__read" href={e.link2}>{e.linkText2} &rarr;</a>}
            <a class="card__help" href="/support/">Victim &amp; Reader Resources</a>
            <a class="card__help" href="/support/">Report a correction</a>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap cal-sec" id="court-updates">
    <CaptureBlock offer="calendar" content="court_calendar_page" />
  </section>

  <section class="wrap cal-sec">
    <div class="capture-cta" aria-label="Learn how criminal jury trials actually work">
      <p class="capture-cta__eyebrow">Following a major trial?</p>
      <h2 class="capture-cta__head">Understand what the jury is actually watching.</h2>
      <p class="capture-cta__body">
        Headlines tell you what happened. <em>Jury Chess: How Criminal Jury Trials Actually Work</em> explains the machinery underneath &mdash; jury selection, evidence disputes, cross-examination, jury instructions, deliberations, and the verdict.
      </p>
      <a class="capture-cta__btn" href="/books/" id="jury-chess-court-calendar">
        Get <em>Jury Chess</em>
      </a>
    </div>
  </section>

  <section class="wrap cal-sec" aria-labelledby="awaiting-decision">
    <h2 id="awaiting-decision">Awaiting Decision</h2>
    <p class="cal-sub">Argued, filed, or fully briefed &mdash; now waiting on a court. Courts rarely announce when a reserved ruling will land.</p>
    {appeals.map((e) => (
      <div class="row" id={e.id}>
        <p class="row__type">{e.type || 'Post-conviction motions'}</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when">{e.where}</p>
        {e.docket && <p class="row__docket">{e.docket}</p>}
        <p class="row__status">{e.status}</p>
        <p class="row__nodate"><strong>Expected development:</strong> {e.nextNote || NO_DATE}</p>
        <p class="row__note">{e.note}</p>
        <p class="row__meta">Subject to change by the court &middot; Source: {e.srcLabel} ({e.srcType}){e.src2 && <span class="row__src2"> &middot; Also: {e.srcLabel2}</span>}</p>
        <p class="row__links">{e.link ? <a href={e.link}>{e.linkText} &rarr;</a> : !CASE_GUIDES[e.id] && <span class="card__soon">Our case file on this is in progress.</span>} {CASE_GUIDES[e.id] && <a class="row__explainer" href={CASE_GUIDES[e.id].url} target="_blank" rel="noopener noreferrer" data-book-key={CASE_GUIDES[e.id].bookKey} data-cta-placement={CASE_GUIDES[e.id].placement}>{CASE_GUIDES[e.id].text} &rarr;</a>} <a class="row__help" href="/support/">Victim &amp; Reader Resources</a> <a class="row__help" href="/support/">Report a correction</a></p>
      </div>
    ))}
  </section>

  <section class="wrap cal-sec" aria-labelledby="investigations">
    <h2 id="investigations">Active Investigations &mdash; No Court Proceeding</h2>
    <p class="cal-sub">These matters are under investigation. No court has scheduled anything, and in several no one has been charged. They are listed here because readers look for them, and separated so nothing on this page implies a proceeding that does not exist.</p>
    {investigations.map((e) => (
      <div class="row row--muted" id={e.id}>
        <p class="row__type">Investigation &middot; no court proceeding</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when">{e.where}</p>
        <p class="row__status">{e.status}</p>
        <p class="row__nodate"><strong>Next development to verify:</strong> {e.nextNote || 'Not yet identified.'}</p>
        <p class="row__note">{e.note}</p>
        <p class="row__meta">No court date exists for this matter &middot; Source: {e.srcLabel} ({e.srcType}){e.src2 && <span class="row__src2"> &middot; Also: {e.srcLabel2}</span>}</p>
        <p class="row__links">{e.link ? <a href={e.link}>{e.linkText} &rarr;</a> : <span class="card__soon">Our case file on this is in progress.</span>} <a class="row__help" href="/support/">Victim &amp; Reader Resources</a> <a class="row__help" href="/support/">Report a correction</a></p>
      </div>
    ))}
  </section>

  <section class="wrap cal-sec" aria-labelledby="unconfirmed">
    <h2 id="unconfirmed">Dates Not Yet Confirmed</h2>
    <p class="cal-sub">These cases are being tracked, but no date is on a public calendar. We do not publish a date until we can point to where it came from.</p>
    {unconfirmed.map((e) => (
      <div class="row row--muted" id={e.id}>
        <p class="row__type">No date set</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when">{e.where}</p>
        {e.docket && <p class="row__docket">{e.docket}</p>}
        <p class="row__nodate"><strong>Next court date:</strong> {NO_DATE}</p>
        <p class="row__status">{e.status}</p>
        {e.nextNote && <p class="row__nodate"><strong>Expected next step:</strong> {e.nextNote}</p>}
        <p class="row__note">{e.note}</p>
        <p class="row__meta">Subject to change by the court &middot; Source: {e.srcLabel} ({e.srcType}){e.src2 && <span class="row__src2"> &middot; Also: {e.srcLabel2}</span>}</p>
        <p class="row__links">
          {e.link ? <a href={e.link}>{e.linkText} &rarr;</a> : <span class="card__soon">Our case file on this is in progress.</span>}
          <a class="row__help" href="/support/">Victim &amp; Reader Resources</a> <a class="row__help" href="/support/">Report a correction</a>
        </p>
      </div>
    ))}
  </section>

  <section class="wrap cal-sec" aria-labelledby="completed">
    <h2 id="completed">Recently Completed</h2>
    <p class="cal-sub">Matters that finished recently. Nothing is deleted when it ages out of this list &mdash; it moves, in full and with its sources, to the <a href="/court-calendar/archive/">court calendar archive</a>.</p>
    {completed.map((e) => (
      <div class="row row--done" id={e.id}>
        <p class="row__type">Concluded</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when">{e.where}</p>
        {e.docket && <p class="row__docket">{e.docket}</p>}
        <p class="row__nodate"><strong>Next court date:</strong> {NO_DATE}</p>
        <p class="row__status">{e.status}</p>
        {e.nextNote && <p class="row__nodate"><strong>Expected next step:</strong> {e.nextNote}</p>}
        <p class="row__note">{e.note}</p>
        <p class="row__meta">Source: {e.srcLabel} ({e.srcType}){e.src2 && <span class="row__src2"> &middot; Also: {e.srcLabel2}</span>}</p>
        <p class="row__links">{e.link ? <a href={e.link}>{e.linkText} &rarr;</a> : <span class="card__soon">Our case file on this is in progress.</span>} <a class="row__help" href="/support/">Victim &amp; Reader Resources</a> <a class="row__help" href="/support/">Report a correction</a></p>
      </div>
    ))}
  </section>

  <section class="wrap cal-sec" aria-labelledby="case-by-case">
    <h2 id="case-by-case">Case-by-Case Schedule</h2>
    <p class="cal-sub">One row per matter, as an index only. The legal posture, the detail and the source live in the full entry, which each row links to, so there is one authoritative version of every case and not two that can drift apart.</p>
    <div class="cal-scroll">
      <table class="cal-table">
        <thead>
          <tr>
            <th scope="col">Case</th>
            <th scope="col">Proceeding</th>
            <th scope="col">Date</th>
            <th scope="col">Court</th>
            <th scope="col">Full entry</th>
          </tr>
        </thead>
        <tbody>
          {nextDates.map((e) => (
            <tr>
              <td class="t-case">{e.case}</td>
              <td>{e.proceeding}</td>
              <td><time datetime={e.dateISO}>{e.dateText}</time></td>
              <td>{e.court}</td>
              <td><a href={`#${e.id}`}>Status and source &rarr;</a></td>
            </tr>
          ))}
          {appeals.map((e) => (
            <tr>
              <td class="t-case">{e.case}</td>
              <td>{e.type || 'Post-conviction motions'}</td>
              <td class="t-none">{NO_DATE}</td>
              <td>{e.where}</td>
              <td><a href={`#${e.id}`}>Status and source &rarr;</a></td>
            </tr>
          ))}
          {investigations.map((e) => (
            <tr>
              <td class="t-case">{e.case}</td>
              <td>Investigation &mdash; no court proceeding</td>
              <td class="t-none">None; no court proceeding exists.</td>
              <td>{e.where}</td>
              <td><a href={`#${e.id}`}>Status and source &rarr;</a></td>
            </tr>
          ))}
          {unconfirmed.map((e) => (
            <tr>
              <td class="t-case">{e.case}</td>
              <td>{e.proceeding || '\u2014'}</td>
              <td class="t-none">{NO_DATE}</td>
              <td>{e.where}</td>
              <td><a href={`#${e.id}`}>Status and source &rarr;</a></td>
            </tr>
          ))}
          {completed.map((e) => (
            <tr>
              <td class="t-case">{e.case}</td>
              <td>Concluded</td>
              <td class="t-none">{NO_DATE}</td>
              <td>{e.where}</td>
              <td><a href={`#${e.id}`}>Status and source &rarr;</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="cal-note evidence">Updated: {LAST_UPDATED}. All dates are subject to change by the court. Corrections: {CORRECTION_EMAIL}.</p>
    <p class="cal-note evidence">This calendar tracks cases worldwide in one view. Cases that have finished and aged out of this page are kept in full in the <a href="/court-calendar/archive/">archive</a>.</p>
  </section>

  <section class="wrap cal-sec" aria-labelledby="how-we-verify">
    <h2 id="how-we-verify">How We Verify Court Dates</h2>
    <div class="prose">
      <p>A wrong date is not a small mistake. It sends a victim's family to an empty courtroom, and it puts a scheduled proceeding in a defendant's name that may not exist. So we hold every line on this page to the same rule.</p>
      <p>Cassian Creed maintains this Neural Edge Publishing calendar as a verification index, not a source of record: every published date must trace to a court, prosecutor, state agency, or identified courtroom report. When a date cannot be tied to a public source, Neural Edge Publishing leaves it unconfirmed rather than turning an expectation into a scheduled proceeding.</p>
      <ol>
        <li><strong>The source is never us.</strong> Each date traces to a court filing, a prosecutor's office, a state agency record, or a reporter who was in the room. We do not cite our own articles as the source for a date.</li>
        <li><strong>We name the source type.</strong> A district attorney's announcement and a news report are not the same thing, so we label which one you are looking at.</li>
        <li><strong>No sourced date, no dated entry.</strong> If a case is active but nothing is scheduled or credibly expected on a specific date, it goes in <a href="#unconfirmed">Dates Not Yet Confirmed</a>. A sourced expectation may appear as <em>Tentative</em>, but it is never presented as confirmed.</li>
        <li><strong>We review the calendar daily.</strong> We re-check every entry before publishing the page's Updated date. Each entry also carries its own verification date, and we do not move that date forward unless we actually re-checked the entry against a source that day.</li>
        <li><strong>Nothing is quietly deleted.</strong> When a matter is finished and has been closed long enough to leave <a href="#completed">Recently Completed</a>, it moves to the <a href="/court-calendar/archive/">archive</a> with its text and sources intact, so a page that once carried a claim still shows it.</li>
        <li><strong>Each proceeding appears once.</strong> A hearing is written out in one entry, indexed once in the <a href="#case-by-case">case-by-case table</a>, and referenced from the FAQ by link. We do not restate the same proceeding in several places, because copies drift apart and one of them ends up wrong.</li>
        <li><strong>Legal status is stated exactly.</strong> Charged is not convicted. A plea is not a verdict. An appeal is not a retrial.</li>
        <li><strong>Worldwide cases share one display.</strong> Jurisdiction changes how we verify and describe a proceeding, but it does not determine prominence. Court and country appear as factual details; current worldwide interest determines which tracked cases receive the most visible positions.</li>
        <li><strong>An investigation is not a case in court.</strong> Matters where police are still working and no court has scheduled anything are kept in <a href="#investigations">Active Investigations</a>, labelled as having no court proceeding. Several involve no charged person at all, and the page says so rather than implying a docket exists.</li>
        <li><strong>A press conference is not a hearing.</strong> Briefings and announcements do not go on the calendar. Confirmed court proceedings and clearly labelled, sourced tentative court events do.</li>
      </ol>
      <p>Even so: courts continue courts. If you plan to attend, call the clerk's office first.</p>
      <p>The full <a href="/court-calendar-policy/">Court Calendar and Case-Tracking Policy</a> sets out what inclusion on this page does and does not mean, what every entry must show before it is published, and how to report a correction. If something here is wrong, email {CORRECTION_EMAIL} and we will fix it.</p>
      <p>Want to feel why seating twelve takes days? <a href="/voir-dire-simulator/">Play our free Voir Dire Simulator</a> &mdash; question the pool, argue cause, and try to survive a Batson challenge.</p>
    </div>
  </section>

  <section class="wrap cal-sec" aria-labelledby="faq">
    <h2 id="faq">FAQ</h2>
    <div class="prose faq">
      {caseFaqs.map((faq) => (
        <>
          <h3>{faq.question}</h3>
          <p>
            {faq.answer}
            {faq.anchor && <> <a href={faq.anchor}>Read the full {faq.caseName} entry &rarr;</a></>}
          </p>
        </>
      ))}

      <h3>Can these dates change?</h3>
      <p>Yes, and they often do. Hearings get continued, trials get pushed, and courts reschedule with little notice. Treat every date here as the best current information, not a promise.</p>

      <h3>How are these dates verified?</h3>
      <p>Each one traces to a court filing, a prosecutor's office, a state agency record, or courtroom reporting. We review the calendar daily, and each entry names its source. See <a href="#how-we-verify">How We Verify Court Dates</a>.</p>
    </div>
  </section>

  <section class="wrap cal-sec">
    <p class="cal-help">
      True crime is about real people. If a case on this page touches something in your own life, our <a href="/support/">Victim &amp; Reader Resources</a> page lists free, confidential help.
    </p>
  </section>

