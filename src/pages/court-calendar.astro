  // LW (2026-07-21): softened. Press phrasing is "end of August"; NO primary source
  // states a hard 8/31. dateISO below is a SORT KEY ONLY — dateText carries the truth.
  // Publish a hard date only when the Bristol County docket confirms one.
  {
    id: 'peck-pretrial',
    case: 'Dianne Curry Peck',
    proceeding: 'Pretrial conference (expected)',
    dateISO: '2026-08-24',
    dateText: 'Expected late August 2026 (date not yet confirmed by court records)',
