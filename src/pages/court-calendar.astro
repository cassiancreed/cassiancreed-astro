---
import Base from '../layouts/Base.astro';

// DATE-VERIFICATION POLICY: every date on this page is verified DAILY against
// live outside coverage — a court filing, a prosecutor's office, or courtroom
// reporting. We never cite our own articles as the source for a date, and we
// never guess. If a date cannot be confirmed against an outside source of
// record, it is pulled, not estimated. Bump LAST_VERIFIED on each sweep.
const LAST_VERIFIED = 'July 16, 2026';
const BUILD_DATE = new Date().toISOString().slice(0, 10);

// Every entry below is tied to an outside source of record — a court filing, a
// prosecutor's office, or courtroom reporting. We never cite our own articles as
// the source for a date. `srcType` states plainly what kind of source it is.
const entries = [
  {
    id: 'clancy-pretrial',
    case: 'Lindsay Clancy',
    proceeding: 'Pretrial hearing',
    dateISO: '2026-07-13',
    dateText: 'Monday, July 13, 2026',
    court: 'Plymouth County Superior Court, Plymouth, MA',
    status: 'Pleaded not guilty; charged with three counts of first-degree murder after prosecutors dropped duplicative strangulation counts.',
    detail: 'HELD. At the final pretrial hearing on July 13, the judge denied the defense request to sequester the jury, barred lay witnesses from testifying about their own experience with postpartum depression or psychosis, and set the panel at 18 jurors. Jury questionnaires and trial procedure were also settled.',
    src: 'https://www.boston.com/news/crime/2026/07/13/lindsay-clancy-final-pretrial-hearing/',
    srcLabel: 'Boston.com, courtroom reporting (July 13, 2026)',
    srcType: 'Court reporting',
    link: '/post/the-lindsay-clancy-case-three-children-one-trial-and-the-questions-massachusetts-must-answer/',
    linkText: 'Read our Lindsay Clancy case primer',
    groups: ['next', 'hearings'],
  },
  {
    id: 'clancy-trial',
    case: 'Lindsay Clancy',
    proceeding: 'Trial begins (jury selection)',
    dateISO: '2026-07-20',
    dateText: 'Monday, July 20, 2026',
    court: 'Plymouth County Superior Court, Plymouth, MA',
    status: 'Pleaded not guilty; charged with three counts of first-degree murder after prosecutors dropped duplicative strangulation counts.',
    detail: 'Jury selection opens the trial; the court intends to seat 18 jurors. Rulings at the July 13 final pretrial hearing denied jury sequestration and barred lay witnesses from testifying about their own experience with postpartum depression or psychosis. Attorneys estimate four to six weeks. She is presumed innocent unless and until a jury says otherwise.',
    src: 'https://www.boston.com/news/crime/2025/11/18/lindsay-clancy-murder-trial-pushed-back-to-july-2026/',
    srcLabel: 'Boston.com, reporting the court’s scheduling order',
    srcType: 'Court reporting',
    link: '/post/the-lindsay-clancy-case-three-children-one-trial-and-the-questions-massachusetts-must-answer/',
    linkText: 'Read our Lindsay Clancy case primer',
    groups: ['next', 'trials'],
  },
  {
    id: 'hernandez-melgar-sentencing',
    case: 'Nestor Hernandez Melgar',
    proceeding: 'Sentencing',
    dateISO: '2026-07-22',
    dateText: 'Wednesday, July 22, 2026',
    court: 'Snohomish County Superior Court, Everett, WA',
    status: 'Convicted by jury of first-degree murder, first-degree burglary, and violation of a court order.',
    detail: 'This is a sentencing hearing, not a trial. The jury returned its verdict on June 22, 2026.',
    src: 'https://www.heraldnet.com/2026/06/22/jury-convicts-man-in-everett-murder-staged-as-suicide/',
    srcLabel: 'The Everett Herald, courtroom reporting (June 22, 2026)',
    srcType: 'Court reporting',
    link: '/post/anatomy-of-a-murder-trial-hernandez-melgar/',
    linkText: 'Read our explainer on the Hernandez Melgar trial',
    groups: ['next', 'sentencing'],
  },
  {
    id: 'peck-pretrial',
    case: 'Dianne Curry Peck',
    proceeding: 'Pretrial hearing',
    dateISO: '2026-08-31',
    dateText: 'Monday, August 31, 2026',
    court: 'Bristol County Superior Court, Fall River, MA',
    status: 'Pleaded not guilty; released on $10,000 cash bail. No trial date set.',
    detail: 'The 1985 Mansfield newborn case — known for four decades as Baby Boy Doe, or the Mansfield Baby Boy Doe case — was reopened using forensic genetic genealogy.',
    src: 'https://www.bostonglobe.com/2026/06/30/metro/dianne-curry-newborn-mansfield-arraignment/',
    srcLabel: 'The Boston Globe, arraignment reporting (June 30, 2026)',
    srcType: 'Court reporting',
    link: 'https://cassiancreed.beehiiv.com/p/baby-boy-doe-mansfield-1985',
    linkText: 'Read our Baby Boy Doe case file',
    groups: ['next', 'hearings'],
  },
];

const unconfirmed = [
  {
    case: 'Brooke George',
    where: 'United Arab Emirates',
    status: 'Detained pending proceedings. No publicly verified court date.',
    note: 'Details of the allegation come from an advocacy organization, not from UAE authorities or any court. No charge has been confirmed on the public record, and she is presumed innocent.',
    src: 'https://www.cbsnews.com/news/brooke-george-british-influencer-dubai-execution-stabbing-man-death-self-defense/',
    srcLabel: 'CBS News (reporting an advocacy group’s account)',
    srcType: 'News report — not officially confirmed',
    link: null,
    linkText: null,
  },
  {
    case: 'Taylor Parker',
    where: 'Texas',
    status: 'Direct appeal exhausted; case is in habeas review. No dated proceeding and no execution date.',
    note: 'Habeas review moves without a public calendar. There is nothing to attend.',
    src: 'https://www.tdcj.texas.gov/death_row/dr_info/parkertaylor.html',
    srcLabel: 'Texas Department of Criminal Justice, offender record',
    srcType: 'Primary — state agency record',
    link: '/post/maternal-instinct-netflix-forensic-evidence-taylor-parker/',
    linkText: 'Read our analysis of the forensic evidence',
  },
  {
    case: 'Pedro Hernandez (Etan Patz)',
    where: 'New York',
    status: 'Conviction reinstated by the U.S. Supreme Court on June 22, 2026, and the case remanded to the Second Circuit. No dated proceeding.',
    note: 'A remand does not put a hearing on a public calendar. Nothing is currently scheduled.',
    src: 'https://www.supremecourt.gov/opinions/25pdf/25-748_4g1o.pdf',
    srcLabel: 'Supreme Court of the United States, slip opinion No. 25-748',
    srcType: 'Primary — court opinion',
    link: '/post/etan-patz-supreme-court-2026-conviction-reinstated/',
    linkText: 'Read what the Supreme Court actually decided',
  },
];

const appeals = [
  {
    case: 'Karmelo Anthony',
    where: 'Collin County, Texas',
    status: 'Convicted and sentenced June 2026; new-trial and recusal motions filed July 7; no hearing date publicly confirmed.',
    note: 'A recusal motion is referred to a regional administrative judge before any hearing is set, so no date exists to publish yet.',
    src: 'https://collincountyda.com/da-greg-willis-announces-first-degree-murder-indictment-in-frisco-track-meet-stabbing-death-of-austin-metcalf-karmelo-anthony-charged/',
    srcLabel: 'Collin County District Attorney, case announcement',
    srcType: 'Primary — prosecutor’s office',
    link: '/post/a-jury-convicted-a-family-still-grieves-karmelo-anthony-verdict-austin-metcalf/',
    linkText: 'Read our coverage of the verdict and what it left unresolved',
  },
];

const completed = [
  {
    case: 'Rex Heuermann',
    where: 'Suffolk County, New York',
    status: 'Case concluded by guilty plea (April 2026) and sentencing (June 2026).',
    note: 'There is no upcoming court date in this case. He waived his right to appeal as part of the plea.',
    src: 'https://www.suffolkcountyda.org/gilgo-serial-killer-sentenced-to-three-consecutive-life-sentences-plus-100-years-for-murdering-eight-women/',
    srcLabel: 'Suffolk County District Attorney, sentencing announcement',
    srcType: 'Primary — prosecutor’s office',
    link: '/post/rex-heuermann-sentencing-june-17-what-the-plea-established/',
    linkText: 'Read what the plea established — and what it did not',
  },
];

// A date that has passed is not a "next court date." Nothing filtered these out, so a
// hearing kept rendering as upcoming the day after it was held. BUILD_DATE is recomputed
// every build, so this now self-heals: past entries drop out of every section automatically.
const isUpcoming = (e) => e.dateISO >= BUILD_DATE;
const byGroup = (g) => entries.filter((e) => e.groups.includes(g) && isUpcoming(e));
const nextDates = byGroup('next').sort((a, b) => a.dateISO.localeCompare(b.dateISO));

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://cassiancreed.com/#org' },
    {
      '@type': 'WebSite',
      '@id': 'https://cassiancreed.com/#website',
      url: 'https://cassiancreed.com/',
      name: 'Cassian Creed',
      publisher: { '@id': 'https://cassiancreed.com/#org' },
    },
    {
      '@type': 'CollectionPage',
      '@id': 'https://cassiancreed.com/court-calendar#page',
      url: 'https://cassiancreed.com/court-calendar',
      name: 'True Crime Court Calendar: Trial Dates & Hearings 2026',
      description:
        'Track verified 2026 true-crime trial dates, hearings, sentencing proceedings, and appeals, including Lindsay Clancy, Dianne Curry Peck, and other major cases.',
      isPartOf: { '@id': 'https://cassiancreed.com/#website' },
      publisher: { '@id': 'https://cassiancreed.com/#org' },
      dateModified: BUILD_DATE,
      mainEntity: { '@id': 'https://cassiancreed.com/court-calendar#schedule' },
    },
    {
      '@type': 'ItemList',
      '@id': 'https://cassiancreed.com/court-calendar#schedule',
      name: 'Scheduled court proceedings',
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: nextDates.length,
      itemListElement: nextDates.map((e, i) => {
        const parts = e.court.split(', ');
        const caseUrl = e.link ? (e.link.startsWith('http') ? e.link : 'https://cassiancreed.com' + e.link) : null;
        return {
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'Event',
            '@id': 'https://cassiancreed.com/court-calendar#' + e.id,
            name: e.case + ' — ' + e.proceeding,
            startDate: e.dateISO,
            eventStatus: 'https://schema.org/EventScheduled',
            eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
            location: {
              '@type': 'Place',
              name: parts[0],
              address: {
                '@type': 'PostalAddress',
                addressLocality: parts[1],
                addressRegion: parts[2],
                addressCountry: 'US',
              },
            },
            description: e.status,
            url: 'https://cassiancreed.com/court-calendar#' + e.id,
            about: { '@type': 'Thing', name: e.case },
            isAccessibleForFree: true,
            ...(caseUrl ? { subjectOf: { '@type': 'WebPage', url: caseUrl } } : {}),
          },
        };
      }),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://cassiancreed.com/court-calendar#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cassiancreed.com/' },
        { '@type': 'ListItem', position: 2, name: 'True Crime Court Calendar', item: 'https://cassiancreed.com/court-calendar' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://cassiancreed.com/court-calendar#faq',
      mainEntity: [
        { '@type': 'Question', name: 'When does the Lindsay Clancy trial start?', acceptedAnswer: { '@type': 'Answer', text: 'Jury selection is scheduled to begin Monday, July 20, 2026, in Plymouth County Superior Court. The final pretrial hearing was held on July 13, where the judge denied jury sequestration, barred lay witnesses from testifying about their own experience with postpartum depression or psychosis, and set the panel at 18 jurors. She has pleaded not guilty and is presumed innocent.' } },
        { '@type': 'Question', name: 'What is the next court date for Dianne Curry Peck?', acceptedAnswer: { '@type': 'Answer', text: 'August 31, 2026, in Bristol County Superior Court in Fall River. She pleaded not guilty and was released on $10,000 cash bail. No trial date has been set.' } },
        { '@type': 'Question', name: 'Does Brooke George have a trial date?', acceptedAnswer: { '@type': 'Answer', text: 'No. There is no publicly verified court date. She is reported to be detained pending proceedings, but the details of the allegation come from an advocacy group rather than from UAE authorities or any court, and no charge has been confirmed on the public record.' } },
        { '@type': 'Question', name: 'Is Karmelo Anthony still facing an upcoming court date?', acceptedAnswer: { '@type': 'Answer', text: 'Not one that has been publicly scheduled. He was convicted and sentenced in June 2026, and new-trial and recusal motions were filed on July 7. No hearing date on those motions has been confirmed.' } },
        { '@type': 'Question', name: 'Is Rex Heuermann still going to trial?', acceptedAnswer: { '@type': 'Answer', text: 'No. That case is over. It concluded with a guilty plea in April 2026 and sentencing in June 2026. There is no upcoming court date.' } },
        { '@type': 'Question', name: 'Can these dates change?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, and they often do. Hearings get continued, trials get pushed, and courts reschedule with little notice. Treat every date here as the best current information, not a promise.' } },
        { '@type': 'Question', name: 'How are these dates verified?', acceptedAnswer: { '@type': 'Answer', text: 'Each one traces to a court filing, a prosecutor\'s office, a state agency record, or courtroom reporting, and each card names its source and the date we last checked it.' } },
      ],
    },
  ],
};
---
<Base
  title="True Crime Court Calendar: Trial Dates & Hearings 2026"
  description="Track verified 2026 true-crime trial dates, hearings, sentencing proceedings, and appeals, including Lindsay Clancy, Dianne Curry Peck, and other major cases."
  jsonld={jsonld}
>
  <section class="hero wrap">
    <p class="evidence evidence--accent">Court Calendar</p>
    <h1>True Crime Court Calendar: Trial Dates &amp; Hearings 2026</h1>
    <p class="cal-answer">
      Three court dates are confirmed. Lindsay Clancy&rsquo;s trial begins <strong>July 20</strong> with jury selection in Plymouth County Superior Court. Nestor Hernandez Melgar is sentenced <strong>July 22</strong> in Snohomish County. Dianne Curry Peck is due back in Bristol County Superior Court on <strong>August 31</strong>.
    </p>
    <p class="cal-fresh">
      <strong>Last verified: {LAST_VERIFIED}.</strong> Court dates move. Every entry below is checked against the public record, and each one carries its source. Confirm with the court before you travel.
    </p>
  </section>

  <section class="wrap cal-sec" aria-labelledby="next-dates">
    <h2 id="next-dates">Next Court Dates</h2>
    <p class="cal-sub">Everything currently on a calendar, in date order.</p>
    <div class="cards">
      {nextDates.map((e) => (
        <article class="card" id={e.id}>
          <p class="card__type">{e.proceeding}</p>
          <h3 class="card__case">{e.case}</h3>
          <p class="card__when"><time datetime={e.dateISO}>{e.dateText}</time></p>
          <p class="card__court">{e.court}</p>
          <p class="card__status"><span class="card__k">Status</span> {e.status}</p>
          <p class="card__detail">{e.detail}</p>
          <p class="card__meta">
            <span class="card__verified">Last verified: {LAST_VERIFIED}</span>
            <span class="card__change">All dates are subject to change by the court.</span>
          </p>
          <p class="card__src">
            <span class="card__k">Source</span>
            <a href={e.src} target="_blank" rel="noopener noreferrer">{e.srcLabel}</a>
            <span class="card__srctype">{e.srcType}</span>
          </p>
          <p class="card__links">
            {e.link ? (
              <a class="card__read" href={e.link}>{e.linkText} &rarr;</a>
            ) : (
              <span class="card__soon">Our case file on this is in progress.</span>
            )}
            <a class="card__help" href="/support/">Victim &amp; Reader Resources</a>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap cal-sec">
    <div class="capture-cta" aria-label="Stay current on this court calendar and get the free Jury Chess Game guide">
      <p class="capture-cta__eyebrow">Came here for a date?</p>
      <h2 class="capture-cta__head">We&rsquo;ll keep you current on the calendar.</h2>
      <p class="capture-cta__body">
        Court dates move. Subscribe and we&rsquo;ll send you <em>The Jury Chess Game</em> &mdash; our free field guide to how lawyers really pick the twelve people who decide guilt or innocence. After that, we only email when we&rsquo;ve shipped something new: a fresh case file or a book. No weekly blast; unsubscribe anytime.
      </p>
      <a class="capture-cta__btn" href="https://cassiancreed.beehiiv.com/subscribe?utm_source=website&utm_medium=court_calendar&utm_campaign=jury_chess_game_guide">
        Get the guide &amp; date updates
      </a>
    </div>
  </section>

  <section class="wrap cal-sec" aria-labelledby="upcoming-trials">
    <h2 id="upcoming-trials">Upcoming Trials</h2>
    {byGroup('trials').map((e) => (
      <div class="row">
        <p class="row__type">{e.proceeding}</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when"><time datetime={e.dateISO}>{e.dateText}</time> &middot; {e.court}</p>
        <p class="row__status">{e.status}</p>
        <p class="row__meta">Last verified: {LAST_VERIFIED} &middot; subject to change by the court &middot; Source: <a href={e.src} target="_blank" rel="noopener noreferrer">{e.srcLabel}</a></p>
        <p class="row__links"><a href={e.link}>{e.linkText} &rarr;</a> <a class="row__help" href="/support/">Victim &amp; Reader Resources</a></p>
      </div>
    ))}
  </section>

  <section class="wrap cal-sec" aria-labelledby="hearings">
    <h2 id="hearings">Hearings &amp; Pretrial</h2>
    {byGroup('hearings').map((e) => (
      <div class="row">
        <p class="row__type">{e.proceeding}</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when"><time datetime={e.dateISO}>{e.dateText}</time> &middot; {e.court}</p>
        <p class="row__status">{e.status}</p>
        <p class="row__meta">Last verified: {LAST_VERIFIED} &middot; subject to change by the court &middot; Source: <a href={e.src} target="_blank" rel="noopener noreferrer">{e.srcLabel}</a></p>
        <p class="row__links">
          {e.link ? <a href={e.link}>{e.linkText} &rarr;</a> : <span class="card__soon">Our case file on this is in progress.</span>}
          <a class="row__help" href="/support/">Victim &amp; Reader Resources</a>
        </p>
      </div>
    ))}
  </section>

  <section class="wrap cal-sec" aria-labelledby="sentencing">
    <h2 id="sentencing">Sentencing &amp; Appeals</h2>
    {byGroup('sentencing').map((e) => (
      <div class="row">
        <p class="row__type">{e.proceeding}</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when"><time datetime={e.dateISO}>{e.dateText}</time> &middot; {e.court}</p>
        <p class="row__status">{e.status}</p>
        <p class="row__meta">Last verified: {LAST_VERIFIED} &middot; subject to change by the court &middot; Source: <a href={e.src} target="_blank" rel="noopener noreferrer">{e.srcLabel}</a></p>
        <p class="row__links"><a href={e.link}>{e.linkText} &rarr;</a> <a class="row__help" href="/support/">Victim &amp; Reader Resources</a></p>
      </div>
    ))}
    {appeals.map((e) => (
      <div class="row">
        <p class="row__type">Post-conviction motions</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when">No hearing date publicly confirmed &middot; {e.where}</p>
        <p class="row__status">{e.status}</p>
        <p class="row__note">{e.note}</p>
        <p class="row__meta">Last verified: {LAST_VERIFIED} &middot; subject to change by the court &middot; Source: <a href={e.src} target="_blank" rel="noopener noreferrer">{e.srcLabel}</a> ({e.srcType})</p>
        <p class="row__links"><a href={e.link}>{e.linkText} &rarr;</a> <a class="row__help" href="/support/">Victim &amp; Reader Resources</a></p>
      </div>
    ))}
  </section>

  <section class="wrap cal-sec" aria-labelledby="unconfirmed">
    <h2 id="unconfirmed">Dates Not Yet Confirmed</h2>
    <p class="cal-sub">These cases are active, but no date is on a public calendar. We do not publish a date until we can point to where it came from.</p>
    {unconfirmed.map((e) => (
      <div class="row row--muted">
        <p class="row__type">No date set</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when">{e.where}</p>
        <p class="row__status">{e.status}</p>
        <p class="row__note">{e.note}</p>
        <p class="row__meta">Last verified: {LAST_VERIFIED} &middot; subject to change by the court &middot; Source: <a href={e.src} target="_blank" rel="noopener noreferrer">{e.srcLabel}</a> ({e.srcType})</p>
        <p class="row__links">
          {e.link ? <a href={e.link}>{e.linkText} &rarr;</a> : <span class="card__soon">Our case file on this is in progress.</span>}
          <a class="row__help" href="/support/">Victim &amp; Reader Resources</a>
        </p>
      </div>
    ))}
  </section>

  <section class="wrap cal-sec" aria-labelledby="completed">
    <h2 id="completed">Recently Completed</h2>
    {completed.map((e) => (
      <div class="row row--done">
        <p class="row__type">Concluded</p>
        <h3 class="row__case">{e.case}</h3>
        <p class="row__when">{e.where}</p>
        <p class="row__status">{e.status}</p>
        <p class="row__note">{e.note}</p>
        <p class="row__meta">Last verified: {LAST_VERIFIED} &middot; Source: <a href={e.src} target="_blank" rel="noopener noreferrer">{e.srcLabel}</a> ({e.srcType})</p>
        <p class="row__links"><a href={e.link}>{e.linkText} &rarr;</a> <a class="row__help" href="/support/">Victim &amp; Reader Resources</a></p>
      </div>
    ))}
  </section>

  <section class="wrap cal-sec" aria-labelledby="case-by-case">
    <h2 id="case-by-case">Case-by-Case Schedule</h2>
    <div class="cal-scroll">
      <table class="cal-table">
        <thead>
          <tr>
            <th scope="col">Case</th>
            <th scope="col">Proceeding</th>
            <th scope="col">Date</th>
            <th scope="col">Court</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {nextDates.map((e) => (
            <tr>
              <td class="t-case">{e.case}</td>
              <td>{e.proceeding}</td>
              <td><time datetime={e.dateISO}>{e.dateText}</time></td>
              <td>{e.court}</td>
              <td class="t-status">{e.status}</td>
            </tr>
          ))}
          {appeals.map((e) => (
            <tr>
              <td class="t-case">{e.case}</td>
              <td>Post-conviction motions</td>
              <td class="t-none">No date set</td>
              <td>{e.where}</td>
              <td class="t-status">{e.status}</td>
            </tr>
          ))}
          {unconfirmed.map((e) => (
            <tr>
              <td class="t-case">{e.case}</td>
              <td class="t-none">&mdash;</td>
              <td class="t-none">No date set</td>
              <td>{e.where}</td>
              <td class="t-status">{e.status}</td>
            </tr>
          ))}
          {completed.map((e) => (
            <tr>
              <td class="t-case">{e.case}</td>
              <td>Concluded</td>
              <td class="t-none">No upcoming date</td>
              <td>{e.where}</td>
              <td class="t-status">{e.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="cal-note evidence">Last verified: {LAST_VERIFIED}. All dates are subject to change by the court.</p>
  </section>

  <section class="wrap cal-sec" aria-labelledby="how-we-verify">
    <h2 id="how-we-verify">How We Verify Court Dates</h2>
    <div class="prose">
      <p>A wrong date is not a small mistake. It sends a victim's family to an empty courtroom, and it puts a scheduled proceeding in a defendant's name that may not exist. So we hold every line on this page to the same rule.</p>
      <ol>
        <li><strong>The source is never us.</strong> Each date traces to a court filing, a prosecutor's office, a state agency record, or a reporter who was in the room. We do not cite our own articles as the source for a date.</li>
        <li><strong>We name the source type.</strong> A district attorney's announcement and a news report are not the same thing, so we label which one you are looking at.</li>
        <li><strong>No date, no entry.</strong> If a case is active but nothing is scheduled, it goes in <a href="#unconfirmed">Dates Not Yet Confirmed</a> and stays there. We would rather say "we don't know" than guess.</li>
        <li><strong>We re-check before we publish, and we date the check.</strong> Every card carries the date it was last verified.</li>
        <li><strong>Legal status is stated exactly.</strong> Charged is not convicted. A plea is not a verdict. An appeal is not a retrial.</li>
      </ol>
      <p>Even so: courts continue courts. If you plan to attend, call the clerk's office first.</p>
      <p>Want to feel why seating twelve takes days? <a href="/voir-dire-simulator/">Play our free Voir Dire Simulator</a> &mdash; question the pool, argue cause, and try to survive a Batson challenge.</p>
    </div>
  </section>

  <section class="wrap cal-sec" aria-labelledby="faq">
    <h2 id="faq">FAQ</h2>
    <div class="prose faq">
      <h3>When does the Lindsay Clancy trial start?</h3>
      <p>Jury selection is scheduled to begin Monday, July 20, 2026, in Plymouth County Superior Court. The final pretrial hearing was held on July 13, where the judge denied jury sequestration, barred lay witnesses from testifying about their own experience with postpartum depression or psychosis, and set the panel at 18 jurors. She has pleaded not guilty and is presumed innocent.</p>

      <h3>What is the next court date for Dianne Curry Peck?</h3>
      <p>August 31, 2026, in Bristol County Superior Court in Fall River. She pleaded not guilty and was released on $10,000 cash bail. No trial date has been set.</p>

      <h3>Does Brooke George have a trial date?</h3>
      <p>No. There is no publicly verified court date. She is reported to be detained pending proceedings, but the details of the allegation come from an advocacy group rather than from UAE authorities or any court, and no charge has been confirmed on the public record.</p>

      <h3>Is Karmelo Anthony still facing an upcoming court date?</h3>
      <p>Not one that has been publicly scheduled. He was convicted and sentenced in June 2026, and new-trial and recusal motions were filed on July 7. No hearing date on those motions has been confirmed.</p>

      <h3>Is Rex Heuermann still going to trial?</h3>
      <p>No. That case is over. It concluded with a guilty plea in April 2026 and sentencing in June 2026. There is no upcoming court date.</p>

      <h3>Can these dates change?</h3>
      <p>Yes, and they often do. Hearings get continued, trials get pushed, and courts reschedule with little notice. Treat every date here as the best current information, not a promise.</p>

      <h3>How are these dates verified?</h3>
      <p>Each one traces to a court filing, a prosecutor's office, a state agency record, or courtroom reporting, and each card names its source and the date we last checked it. See <a href="#how-we-verify">How We Verify Court Dates</a>.</p>
    </div>
  </section>

