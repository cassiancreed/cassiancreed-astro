    src: 'https://www.bostonglobe.com/2026/06/30/metro/dianne-curry-newborn-mansfield-arraignment/',
    srcLabel: 'The Boston Globe, arraignment reporting (June 30, 2026)',
    srcType: 'Court reporting',
    link: '/post/baby-boy-doe-mansfield-1985/',
    linkText: 'Read the Baby Boy Doe case update',
    groups: ['next', 'hearings'],
