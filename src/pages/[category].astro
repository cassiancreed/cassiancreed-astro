---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return [
    { params: { category: 'case-files' }, props: { tag: 'Case Files', label: 'Case Files' } },
    { params: { category: 'explainers' }, props: { tag: 'Explainers', label: 'Explainers' } },
  ];
}
const { tag, label } = Astro.props;
const posts = (await getCollection('posts')).filter(p=>p.data.tag===tag).sort((a,b)=> b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const short=(t)=>t.split(':')[0];
---
<Base title={`${label} — Cassian Creed`}>
  <section class="hero wrap">
    <h1>{label}</h1>
    <p class="post__note">Also in the library: the <a href="/guides/">Resources &amp; Guides</a> &middot; the <a href="/glossary/">Glossary</a> &middot; the free <a href="/safety/">Stay Safe guide</a> &middot; <a href="/how-forensic-genetic-genealogy-works/">how forensic genetic genealogy works</a> &middot; the <a href="/court-calendar/">Court Calendar</a>.</p>
  </section>
  {tag === 'Case Files' && (<section class="wrap" aria-label="Subscribe free and get How to Read a Case Like the Court Does"><div style="margin:8px 0 24px;padding:24px 22px;background:var(--bg-3);border:1px solid rgba(95,174,126,.45);border-radius:10px;text-align:center"><p class="evidence evidence--accent">The free newsletter</p><h2 style="margin:4px 0 8px;font-size:24px">Subscribe free &mdash; get <em>How to Read a Case Like the Court Does</em></h2><p style="margin:0 0 14px">A charge isn&rsquo;t a conviction. A theory isn&rsquo;t proof. Subscribe and we&rsquo;ll send you <em>How to Read a Case Like the Court Does</em> &mdash; a plain-language framework for weighing evidence instead of guessing, the real difference between proof and speculation, and what a verdict actually settles (and what it doesn&rsquo;t). No weekly blast; unsubscribe anytime.</p><form action="https://cassiancreed.beehiiv.com/subscribe" method="get" aria-label="Subscribe free to the Cassian Creed newsletter" style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap"><input type="hidden" name="utm_source" value="website" /><input type="hidden" name="utm_medium" value="blog_cta" /><input type="hidden" name="utm_campaign" value="lm_case_how-to-read-a-case" /><input type="email" name="email" required autocomplete="email" placeholder="you@email.com" aria-label="Your email address" /><button class="btn" type="submit">Send me the free guide &rarr;</button></form><p style="margin:10px 0 0;font-size:13px;color:var(--ink-2)">No spam. Unsubscribe anytime.</p></div></section>)}
  <section class="wrap"><div class="grid">
    {tag === 'Case Files' && (<a class="card" href="https://cassiancreed.beehiiv.com/p/baby-boy-doe-mansfield-1985" target="_blank" rel="noopener"><div class="card__tile"><div class="tile__top"><span class="tile__no">New</span><span class="tile__tag">Case Files</span></div><h3 class="card__title">Baby Boy Doe — Mansfield, 1985</h3></div></a>)}
    {posts.map((p, i) => (<a class="card" href={`/post/${p.slug}/`}><div class="card__tile" style={p.data.cover ? `background-image:linear-gradient(rgba(10,14,26,.30),rgba(10,14,26,.78)),url(${p.data.cover});background-size:cover;background-position:center 32%` : undefined}><div class="tile__top"><span class="tile__no">Nº {String(i+1).padStart(2,'0')}</span><span class="tile__tag">{p.data.tag}</span></div><h3 class="card__title">{short(p.data.title)}</h3></div></a>))}
  </div></section>
</Base>
