---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return [
    { params: { category: 'case-files' }, props: { tag: 'Case Files', label: 'Case Files' } },
    { params: { category: 'explainers' }, props: { tag: 'Explainers', label: 'Explainers' } },
  ];
}
const { tag, label } = Astro.props;
const posts = (await getCollection('posts')).filter(p=>p.data.tag===tag).sort((a,b)=> b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const short=(t)=>t.split(':')[0];
---
<Base title={`${label} — Cassian Creed`}>
  <section class="hero wrap"><p class="evidence evidence--accent">{label}</p><h1>{label}</h1></section>
  <section class="wrap"><div class="grid">
    {posts.map((p, i) => (<a class="card" href={`/post/${p.slug}/`}><div class="card__tile"><div class="tile__top"><span class="tile__no">Nº {String(i+1).padStart(2,'0')}</span><span class="tile__tag">{p.data.tag}</span></div><h3 class="card__title">{short(p.data.title)}</h3></div></a>))}
  </div></section>
</Base>
