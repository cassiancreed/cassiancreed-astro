  </section>
</Base>

<style>
  .books-promo{padding:56px 0 48px;border-top:1px solid var(--line)}
  .books-promo__heading{font-family:var(--serif);font-weight:600;font-size:26px;margin:8px 0 28px}
  .books-promo__shelf{display:flex;gap:20px;flex-wrap:wrap;margin-bottom:20px}
  .books-promo__item img{display:block;border-radius:4px;box-shadow:0 4px 18px rgba(0,0,0,.55);transition:transform .15s}
  .books-promo__item:hover img{transform:translateY(-3px)}
  .books-promo__bundle{color:var(--ink-2);font-size:15px;margin:0 0 20px}
</style>
