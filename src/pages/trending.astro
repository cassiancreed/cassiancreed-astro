---
import Base from '../layouts/Base.astro';
import data from '../data/trending.json';
const trending = data.cases;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Trending True Crime Cases — Cassian Creed",
  "description": "The true-crime cases getting the most news coverage right now, ranked by coverage, not guilt, each linked to its sourced case file and court date.",
  "dateModified": data.updated,
  "url": "https://cassiancreed.com/trending/"
};
---
<Base title="Trending True Crime Cases — Cassian Creed" description="The true-crime cases getting the most news coverage right now, ranked by coverage, not guilt, each linked to its sourced case file and court date." jsonld={jsonld}>
  <section class="hero wrap">
    <p class="evidence evidence--accent">Trending Now</p>
    <h1>The cases everyone's following.</h1>
    <p class="trend-lede">The cases getting the most news coverage right now. <strong>Trending by coverage, not guilt:</strong> a case on this list is getting attention; that says nothing about who did what. Each one links to our sourced, victim-first case file and its next court date.</p>
    <p class="trend-stamp">Updated {data.updatedText}. {data.method}</p>
  </section>

  <section class="wrap">
    <ol class="trend-grid">
      {trending.map((c) => (
        <li class="trend-card">
          <span class="trend-card__status">#{c.rank} · {c.status}</span>
          <h2 class="trend-card__title"><a href={c.explainer}>{c.title}</a></h2>
          <p class="trend-card__why">{c.why}</p>
          <p class="trend-card__links"><a class="trend-card__cta" href={c.explainer}>Read the case file &rarr;</a> <a class="trend-card__cta" href={`/court-calendar/#${c.courtId}`}>Court date &rarr;</a></p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap trend-dossier">
    <div class="trend-dossier__inner">
      <span class="evidence evidence--accent">Free resource</span>
      <p>A charge isn&rsquo;t a conviction. A theory isn&rsquo;t proof. We&rsquo;ll send you <em>How to Read a Case Like the Court Does</em> &mdash; a plain-language framework for weighing evidence instead of guessing, the real difference between proof and speculation, and what a verdict actually settles (and what it doesn&rsquo;t). One email every Sunday. Unsubscribe anytime.</p>
    </div>
  </section>

  <section class="wrap trend-foot">
    <div class="trend-tracker">
      <p class="evidence evidence--accent">The full watchlist</p>
      <h2>Every court date we follow</h2>
      <p>Our court calendar tracks every upcoming hearing, trial and sentencing we follow, each with its source and the date we last checked it. <a href="/court-calendar/">Open the court calendar →</a></p>
      <p class="trend-sub">New to court words like "mistrial" or "motion to dismiss"? <a href="/glossary/">See our plain-English legal dictionary.</a></p>
      <p class="trend-sub">Want each week's biggest case in your inbox, written victim-first? <a href="/#free-guide">Get the free newsletter.</a></p>
    </div>
  </section>

  <style>
    .trend-lede{color:var(--ink-2);max-width:62ch;font-size:18px;margin:18px 0 0}
    .trend-grid{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:8px 0 28px}
    .trend-card{display:block;background:var(--bg-2);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;padding:20px 22px;transition:border-color .2s,transform .2s}
    .trend-card:hover{border-color:rgba(224,86,59,.55);transform:translateY(-2px)}
    .trend-card__status{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--accent)}
    .trend-card__title{font-family:var(--serif);font-weight:600;font-size:23px;margin:8px 0 8px;color:var(--ink)}
    .trend-card__why{color:var(--ink-2);font-size:15px;margin:0 0 12px}
    .trend-card__chip{display:block;margin:0 0 10px;font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--ink-2);background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:4px;padding:5px 9px;cursor:pointer;transition:background .15s,color .15s}
    .trend-card__chip:hover{background:rgba(224,86,59,.1);color:var(--accent)}
.trend-stamp{color:var(--ink-3);font-size:14px;max-width:70ch;margin:10px 0 0}
    .trend-card__title a{color:inherit}
    .trend-card__links{display:flex;gap:18px;flex-wrap:wrap;margin:0}
    .trend-card__cta{font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:var(--ink-3)}
    .trend-card:hover .trend-card__cta{color:var(--accent)}
    .trend-dossier{padding:4px 0 20px}
    .trend-dossier__inner{background:var(--bg-2);border:1px solid var(--line);border-radius:10px;padding:16px 22px;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
    .trend-dossier__inner p{color:var(--ink-2);font-size:15px;margin:0}
    .trend-dossier__inner a{color:var(--accent);text-decoration:underline}
    .trend-foot{padding:8px 0 40px}
    .trend-tracker{background:var(--bg-3);border:1px solid rgba(224,86,59,.25);border-radius:12px;padding:28px}
    .trend-tracker h2{font-family:var(--serif);font-weight:600;font-size:26px;margin:6px 0 10px}
    .trend-tracker p{color:var(--ink-2);max-width:60ch;margin:0 0 10px}
    .trend-tracker a{color:var(--accent);text-decoration:underline}
    .trend-sub{font-size:15px}
    @media(max-width:680px){.trend-grid{grid-template-columns:1fr}}
  </style>
</Base>
