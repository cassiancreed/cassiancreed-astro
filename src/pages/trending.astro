---
import Base from '../layouts/Base.astro';
import data from '../data/trending.json';
import trends from '../data/trends.json';
import CertaintyBadge from '../components/CertaintyBadge.astro';
import CertaintyLegend from '../components/CertaintyLegend.astro';
const trending = data.cases;
const phases = data.phases.map((ph) => ({ ...ph, cases: trending.filter((c) => c.phase === ph.key) })).filter((ph) => ph.cases.length);

const W = 560, H = 150, PL = 30, PR = 10, PT = 10, PB = 22;
const n = trends.days.length;
const px = (i) => PL + (i * (W - PL - PR)) / (n - 1);
const py = (v) => PT + (1 - v / 100) * (H - PT - PB);
const line = (vals) => vals.map((v, i) => `${i ? 'L' : 'M'}${px(i).toFixed(1)} ${py(v).toFixed(1)}`).join(' ');
// Weekly ticks from the first day; drop a weekly tick that would crowd the last day's label.
const ticks = [...[0, 7, 14, 21, 28].filter((t) => t < n - 1 - 4), n - 1];
// First label hangs right, last label hangs left, so neither is cut off at the chart edge.
const tickAnchor = (t) => (t === 0 ? 'start' : t === n - 1 ? 'end' : 'middle');
const lastWeekAvg = (vals) => Math.round(vals.slice(-7).reduce((a, b) => a + b, 0) / 7);
const peakDay = (vals) => trends.days[vals.indexOf(Math.max(...vals))];
// Order 1 (2026-11-27): the page stamp reads the newest data time on the page
// (chart or case cards), and says which part was checked when.
const chartIsNewer = String(trends.asOf) > String(data.updated);
const pageUpdatedText = chartIsNewer ? trends.asOfText : data.updatedText;
const pageUpdatedISO = chartIsNewer ? trends.asOf : data.updated;
const colors = ['#e0563b', '#6aa9ff', '#e6c04a', '#7bd88f', '#c792ea'];
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Trending True Crime Cases — Cassian Creed",
  "description": "True-crime cases getting attention right now, grouped by where each one is in its news cycle, each linked to its court date.",
  "dateModified": pageUpdatedISO,
  "url": "https://cassiancreed.com/trending/"
};
---
<Base title="Trending True Crime Cases — Cassian Creed" description="True-crime cases getting attention right now, grouped by where each one is in its news cycle, each linked to its court date." jsonld={jsonld}>
  <section class="hero wrap">
    <p class="evidence evidence--accent">Trending Now</p>
    <h1>The cases everyone's following.</h1>
    <p class="trend-lede">The cases getting attention right now, grouped by where each one is in its news cycle. <strong>Trending is not guilt:</strong> a case on this list is getting attention; that says nothing about who did what. Each one links to its court date, and to our victim-first case file where we have one.</p>
    <p class="trend-stamp">Updated {pageUpdatedText}.{chartIsNewer && <> The search chart uses that data; the case cards were last checked {data.updatedText}.</>} {data.method}</p>
  </section>


  <div class="wrap"><CertaintyLegend /></div>

  <section class="wrap trend-combo">
    <h2 class="trend-combo__title">Who is rising right now</h2>
    <p class="trend-chart__cap">Search interest, U.S., last 30 days (Google Trends, 100 = peak). Five cases with the most search interest in the past 7 days, on one shared scale. Data as of {trends.asOfText}. {trends.note}</p>
    <svg class="trend-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Line chart of Google Trends search interest in the U.S. over the last 30 days for five cases">
      {[0, 25, 50, 75, 100].map((g) => (<g><line x1={PL} x2={W - PR} y1={py(g)} y2={py(g)} class="trend-grid-line" /><text x={PL - 4} y={py(g) + 3} class="trend-axis" text-anchor="end">{g}</text></g>))}
      {ticks.map((t) => (<text x={px(t)} y={H - 6} class="trend-axis" text-anchor={tickAnchor(t)}>{trends.days[t]}</text>))}
      {trends.top5.map((k, i) => (<path d={line(trends.shared[k])} fill="none" stroke={colors[i]} stroke-width="2" stroke-linejoin="round" />))}
    </svg>
    <ul class="trend-legend">
      {trends.top5.map((k, i) => (<li><span class="trend-key" style={`background:${colors[i]}`}></span>{trends.caseNames[k]} <em>(7-day average {lastWeekAvg(trends.shared[k])})</em></li>))}
    </ul>
  </section>

  {phases.map((ph) => (
    <section class="wrap trend-phase">
      <h2 class={`trend-phase__title trend-phase__title--${ph.key}`}>{ph.label}</h2>
      <p class="trend-phase__blurb">{ph.blurb}</p>
      <ul class="trend-grid">
        {ph.cases.map((c) => (
          <li class="trend-card">
            {c.trendKey && trends.solo[c.trendKey] && (
              <figure class="trend-chart">
                <svg class="trend-svg trend-svg--sm" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Search interest in ${trends.caseNames[c.trendKey]}, U.S., last 30 days. Peak on ${peakDay(trends.solo[c.trendKey])}.`}>
                  {[0, 50, 100].map((g) => (<g><line x1={PL} x2={W - PR} y1={py(g)} y2={py(g)} class="trend-grid-line" /><text x={PL - 4} y={py(g) + 3} class="trend-axis" text-anchor="end">{g}</text></g>))}
                  {ticks.map((t) => (<text x={px(t)} y={H - 6} class="trend-axis" text-anchor={tickAnchor(t)}>{trends.days[t]}</text>))}
                  <path d={line(trends.solo[c.trendKey])} fill="none" stroke="#e0563b" stroke-width="2" stroke-linejoin="round" />
                </svg>
                <figcaption>Search interest, U.S., last 30 days (Google Trends; 100 = this case&rsquo;s own peak, {peakDay(trends.solo[c.trendKey])}). As of {trends.asOf}.</figcaption>
              </figure>
            )}
            <span class="trend-card__status">{c.status}</span> <CertaintyBadge level={c.certainty || 'unconfirmed'} checked={c.checked || 'Nov. 21'} />
            <h3 class="trend-card__title">{c.explainer ? <a href={c.explainer}>{c.title}</a> : c.title}</h3>
            <p class="trend-card__why">{c.why}</p>
            <p class="trend-card__links">{c.explainer && <a class="trend-card__cta" href={c.explainer}>Read the case file &rarr;</a>} <a class="trend-card__cta" href={`/court-calendar/#${c.courtId}`}>{c.linkLabel || "Court date"} &rarr;</a> {c.sourceUrl && <a class="trend-card__cta" href={c.sourceUrl} rel="noopener">{c.sourceLabel || "Official source"} &rarr;</a>}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="wrap trend-dossier">
    <div class="trend-dossier__inner">
      <span class="evidence evidence--accent">Free resource</span>
      <p>A charge isn&rsquo;t a conviction. A theory isn&rsquo;t proof. We&rsquo;ll send you <em>How to Read a Case Like the Court Does</em> &mdash; a plain-language framework for weighing evidence instead of guessing, the real difference between proof and speculation, and what a verdict actually settles (and what it doesn&rsquo;t). One email every Sunday. Unsubscribe anytime.</p>
    </div>
  </section>

  <section class="wrap trend-foot">
    <div class="trend-tracker">
      <p class="evidence evidence--accent">The full watchlist</p>
      <h2>Every court date we follow</h2>
      <p>Our court calendar tracks every upcoming hearing, trial and sentencing we follow, each with its source and the date we last checked it. <a href="/court-calendar/">Open the court calendar →</a></p>
      <p class="trend-sub">New to court words like "mistrial" or "motion to dismiss"? <a href="/glossary/">See our plain-English legal dictionary.</a></p>
      <p class="trend-sub">Want each week's biggest case in your inbox, written victim-first? <a href="/#free-guide">Get the free newsletter.</a></p>
    </div>
  </section>

  <style>
    .trend-combo{padding:10px 0 6px}
    .trend-combo__title{font-family:var(--serif);font-weight:600;font-size:26px;margin:14px 0 4px}
    .trend-chart__cap,.trend-chart figcaption{color:var(--ink-3);font-size:13px;margin:4px 0 8px;max-width:70ch}
    .trend-chart{margin:0 0 12px}
    .trend-svg{width:100%;height:auto;display:block;background:var(--bg-2);border:1px solid var(--line);border-radius:8px}
    .trend-grid-line{stroke:var(--line);stroke-width:1}
    .trend-axis{fill:var(--ink-3);font-size:9px;font-family:var(--mono)}
    .trend-legend{list-style:none;padding:0;margin:10px 0 0;display:flex;flex-wrap:wrap;gap:6px 18px;font-size:14px;color:var(--ink-2)}
    .trend-legend em{color:var(--ink-3);font-style:normal;font-size:12px}
    .trend-key{display:inline-block;width:12px;height:3px;margin-right:6px;vertical-align:middle}
    .trend-lede{color:var(--ink-2);max-width:62ch;font-size:18px;margin:18px 0 0}
    .trend-phase{padding-top:6px}
    .trend-phase__title{font-family:var(--serif);font-weight:600;font-size:26px;margin:22px 0 4px}
    .trend-phase__blurb{color:var(--ink-3);font-size:15px;max-width:68ch;margin:0 0 12px}
    .trend-grid{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:8px 0 28px}
    .trend-card{display:block;background:var(--bg-2);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;padding:20px 22px;transition:border-color .2s,transform .2s}
    .trend-card:hover{border-color:rgba(224,86,59,.55);transform:translateY(-2px)}
    .trend-card__status{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--accent)}
    .trend-card__title{font-family:var(--serif);font-weight:600;font-size:23px;margin:8px 0 8px;color:var(--ink)}
    .trend-card__why{color:var(--ink-2);font-size:15px;margin:0 0 12px}
    .trend-card__chip{display:block;margin:0 0 10px;font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--ink-2);background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:4px;padding:5px 9px;cursor:pointer;transition:background .15s,color .15s}
    .trend-card__chip:hover{background:rgba(224,86,59,.1);color:var(--accent)}
.trend-stamp{color:var(--ink-3);font-size:14px;max-width:70ch;margin:10px 0 0}
    .trend-card__title a{color:inherit}
    .trend-card__links{display:flex;gap:18px;flex-wrap:wrap;margin:0}
    .trend-card__cta{font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:var(--ink-3)}
    .trend-card:hover .trend-card__cta{color:var(--accent)}
    .trend-dossier{padding:4px 0 20px}
    .trend-dossier__inner{background:var(--bg-2);border:1px solid var(--line);border-radius:10px;padding:16px 22px;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
    .trend-dossier__inner p{color:var(--ink-2);font-size:15px;margin:0}
    .trend-dossier__inner a{color:var(--accent);text-decoration:underline}
    .trend-foot{padding:8px 0 40px}
    .trend-tracker{background:var(--bg-3);border:1px solid rgba(224,86,59,.25);border-radius:12px;padding:28px}
    .trend-tracker h2{font-family:var(--serif);font-weight:600;font-size:26px;margin:6px 0 10px}
    .trend-tracker p{color:var(--ink-2);max-width:60ch;margin:0 0 10px}
    .trend-tracker a{color:var(--accent);text-decoration:underline}
    .trend-sub{font-size:15px}
    @media(max-width:680px){.trend-grid{grid-template-columns:1fr}}
  </style>
</Base>
