---
import Base from '../layouts/Base.astro';
import { pageSchema } from '../utils/page-schema.mjs';
import CaptureBlock from '../components/CaptureBlock.astro';
import { getCollection } from 'astro:content';

// RESOURCES & GUIDES — the body-of-work page. Its job is to show depth at a
// glance: the guides, the tools, the glossary, the case-file library, the books.
// Counts are pulled live from the content collection so this page can never go
// stale as posts are added. Add a new guide by appending to `guides` below.

const posts = (await getCollection('posts')).filter(p => !p.data.archived);
const caseFiles = posts.filter(p => p.data.tag === 'Case Files');
const explainers = posts.filter(p => p.data.tag === 'Explainers');

const guides = [
  {
    href: '/genealogy/',
    kicker: 'Specialty',
    title: 'Investigative Genetic Genealogy',
    desc: 'The complete learning hub: DNA and inheritance, family-tree lead generation, restored identities, case studies, laboratory work, privacy, law, and the essential distinction between a lead and proof.',
  },
  {
    href: '/safety/',
    kicker: 'Guide',
    title: 'Stay Safe — And Know It’s Not On You',
    desc: 'A calm, practical personal-safety guide: coercive control signs, stalking warning signs, digital safety, de-escalation, and verified hotlines. No fear, no blame. Free and open — no email required.',
  },
  {
    href: '/how-dna-remembers/',
    kicker: 'Guide',
    title: 'How DNA Remembers: The Science Behind Your Family Tree',
    desc: 'The four-letter code, how you inherit it, how cousin-matching and centimorgans really work, how far back DNA can reach — and the remarkable thing this science can do. Plain language, accurate, free.',
  },
  {
    href: '/how-forensic-genetic-genealogy-works/',
    kicker: 'Explainer',
    title: 'How Forensic Genetic Genealogy Actually Works',
    desc: 'The technique that names the unknown, explained plainly — how investigative genetic genealogy solves cold cases, and why it produces leads, not proof.',
  },
  {
    href: '/glossary/',
    kicker: 'Reference',
    title: 'True-Crime & Courtroom Glossary',
    desc: 'Arraignment, indictment, voir dire, nolle prosequi, recusal, coercive control — the terms coverage gets wrong, defined plainly and linked to the cases where they mattered.',
  },
  {
    href: '/voir-dire-simulator/',
    kicker: 'Tool',
    title: 'The Voir Dire Simulator',
    desc: 'Sit in the chair. Pick the jury. See how attorneys really choose the twelve people who decide guilt or innocence — then watch what your choices do.',
  },
  {
    href: '/case-solver/',
    kicker: 'Tool',
    title: 'Case Solver',
    desc: 'Work a case the way an investigator does — evidence first, conclusions last.',
  },
  {
    href: '/forensic-tools/',
    kicker: 'Reference',
    title: 'Forensic Tools',
    desc: 'What the techniques actually do, what they can’t do, and how much weight each one really carries.',
  },
  {
    href: '/court-calendar/',
    kicker: 'Tracker',
    title: 'Court Calendar',
    desc: 'Upcoming hearings and trial dates in the cases we cover — every date tied to an outside source of record, verified daily.',
  },
  {
    href: '/creators/',
    kicker: 'For creators',
    title: 'Court Case Kits for Creators',
    desc: 'Sourced research kits for people who cover live trials on YouTube, TikTok or a podcast. Read the free Faith Hedgepeth sample.',
  },
];
const jsonld = pageSchema({
  "type": "WebPage",
  "title": "Resources & Guides — Safety Guide, Glossary, Forensic Explainers & Tools | Cassian Creed",
  "headline": "Resources & Guides",
  "description": "Free safety and courtroom guides, forensic explainers, interactive tools, a verified court calendar, case files, and Jury Chess.",
  "path": "/guides/",
  "source": "src/pages/guides.astro"
});
---
<Base jsonld={jsonld}
  title="Resources & Guides — Safety Guide, Glossary, Forensic Explainers & Tools | Cassian Creed"
  description="Free safety and courtroom guides, forensic explainers, interactive tools, a verified court calendar, case files, and Jury Chess."
>
  <section class="hero wrap">
    <p class="evidence evidence--accent">The Library</p>
    <h1>Resources &amp; Guides</h1>
    <p class="hero__lede">Everything we&rsquo;ve built, in one place &mdash; free, open, and sourced. {caseFiles.length} case files, {explainers.length} explainers, plus the guides, tools, and reference work below.</p>
  </section>

  <article class="post">
    <div class="post__content">
      <p>Neural Edge Publishing is not a single book. It is a body of work: sourced, victim-first case files; plain-language forensic explainers; practical guides that ask nothing of you in return; and tools that let you sit in the chair yourself. Everything here is free to read. Nothing here is gated.</p>
    </div>
  </article>

  {/* Site fix list v2, item 6: compact cards with the title and summary in one
      box, a heading that lines up with the grid, and the library links as three
      matching cards instead of a long column of buttons. */}
  <section class="wrap guides-sec" aria-labelledby="guides-and-tools">
    <h2 id="guides-and-tools" class="guides-sec__h">Guides, tools &amp; reference</h2>
    <div class="guides-grid">
      {guides.map(g => (
        <a class="guide-card" href={g.href}>
          <span class="guide-card__top"><span class="guide-card__kind">{g.kicker}</span><span class="guide-card__free">Free</span></span>
          <h3 class="guide-card__title">{g.title}</h3>
          <p class="guide-card__desc">{g.desc}</p>
          <span class="guide-card__go">Open <span aria-hidden="true">&rarr;</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap guides-sec" aria-labelledby="the-library">
    <h2 id="the-library" class="guides-sec__h">The library</h2>
    <div class="library-grid">
      <a class="library-card" id="the-case-files" href="/case-files/">
        <span class="library-card__count">{caseFiles.length}</span>
        <h3>Case files</h3>
        <p>Sourced, victim-first case files built on the public record: court filings, charging papers and courtroom reporting. Everyone charged is presumed innocent unless a court finds them guilty.</p>
        <span class="library-card__go">Browse all case files <span aria-hidden="true">&rarr;</span></span>
      </a>
      <a class="library-card" id="the-explainers" href="/explainers/">
        <span class="library-card__count">{explainers.length}</span>
        <h3>Explainers</h3>
        <p>Plain-language explainers on how the science and the system work: genetic genealogy, false confessions, coercive control, forensic evidence and the courtroom itself.</p>
        <span class="library-card__go">Browse all explainers <span aria-hidden="true">&rarr;</span></span>
      </a>
      <a class="library-card" id="jury-chess" href="/books/">
        <span class="library-card__count">Book</span>
        <h3>Jury Chess</h3>
        <p>The verified Cassian Creed courtroom guide explains how criminal jury trials work, from jury selection through verdict.</p>
        <span class="library-card__go">Explore Jury Chess <span aria-hidden="true">&rarr;</span></span>
      </a>
    </div>
    <p class="guides-sec__note">New here? <a href="/start-here/">Start Here</a> is the shortest path in. Or read our <a href="/mission/">mission</a> &mdash; victim-centered, evidence-first, and accountable.</p>
  </section>

  <div class="wrap"><section class="subscribe" id="free-guide">
    <CaptureBlock offer="case" content="guides" />
  </section></div>
</Base>

<style>
  .guides-sec { margin: 8px auto 36px; }
  .guides-sec__h { font-family: var(--serif); font-weight: 600; font-size: clamp(26px, 3.4vw, 34px); line-height: 1.15; margin: 0 0 16px; }
  .guides-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .guide-card, .library-card {
    display: flex; flex-direction: column; min-width: 0;
    background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; padding: 18px;
    color: var(--ink); text-decoration: none; transition: border-color .2s, transform .2s;
  }
  .guide-card:hover, .library-card:hover { border-color: rgba(224,86,59,.55); transform: translateY(-2px); }
  .guide-card__top { display: flex; justify-content: space-between; gap: 10px; font-family: var(--mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }
  .guide-card__kind { color: var(--accent); }
  .guide-card__free { color: var(--ink-3); }
  .guide-card__title { font-family: var(--serif); font-weight: 600; font-size: 21px; line-height: 1.2; margin: 10px 0 8px; }
  .guide-card__desc { color: var(--ink-2); font-size: 15px; line-height: 1.55; margin: 0 0 14px; }
  .guide-card__go, .library-card__go { margin-top: auto; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
  .guide-card:hover .guide-card__go, .library-card:hover .library-card__go { color: var(--accent); }
  .library-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .library-card { border-top: 3px solid var(--accent); }
  .library-card__count { font-family: var(--serif); font-size: 34px; line-height: 1; color: var(--accent); }
  .library-card h3 { font-family: var(--serif); font-weight: 600; font-size: 22px; margin: 8px 0 8px; }
  .library-card p { color: var(--ink-2); font-size: 15px; line-height: 1.55; margin: 0 0 14px; }
  .guides-sec__note { color: var(--ink-2); margin: 18px 0 0; }
  .guides-sec__note a { color: var(--accent); }
  @media (max-width: 900px) { .guides-grid, .library-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .guides-grid, .library-grid { grid-template-columns: 1fr; } }
</style>
