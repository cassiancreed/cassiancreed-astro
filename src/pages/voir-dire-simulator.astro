  }
  function log(t,cls){var li=document.createElement('li');if(cls)li.className=cls;li.textContent=t;var l=$('vds-log');l.appendChild(li);l.scrollTop=l.scrollHeight}
  function toast(t){var d=document.createElement('div');d.className='vds-toast';d.setAttribute('role','status');d.textContent=t;document.body.appendChild(d);setTimeout(function(){d.remove()},7000)}
  function reveal(j,k,text){if(j.revealed.indexOf(k)<0){j.revealed.push(k)}var li=document.createElement('li');li.textContent=text;var f=$('j-facts');if(f.querySelector('.vds-fact--none'))f.innerHTML='';f.appendChild(li)}
  function modal(kick,title,html,actions){
    $('m-kicker').textContent=kick;$('m-title').textContent=title;$('m-body').innerHTML=html;
    var box=$('m-actions');box.innerHTML='';
    actions.forEach(function(a){var b=document.createElement('button');b.type='button';b.className='vds-act';b.textContent=a[0];b.addEventListener('click',function(){$('vds-modal').hidden=true;a[1]()});box.appendChild(b)});
    $('vds-modal').hidden=false; setTimeout(function(){var b=box.querySelector('button');if(b)b.focus()},30);
  }
  function updateStatus(){
    $('st-side').textContent='You: '+S.side.toUpperCase();
    $('st-seated').textContent=S.seated.length;$('st-alt').textContent=S.alternates.length;
    $('st-mine').textContent=S.mine;$('st-theirs').textContent=S.theirs;
    $('st-pool').textContent='Pool remaining: '+(S.pool.length-S.idx);
    $('act-strike').disabled = S.mine<=0;
  }
  function showJuror(){
    if(S.seated.length>=12 && S.alternates.length>=2){return endGame()}
    if(S.idx>=S.pool.length){
      log('The venire is exhausted. The court summons ten more jurors — big pools exist for exactly this reason.','lg-judge');
      for(var i=0;i<10;i++){S.pool.push(makeJuror(S.pool.length+1,S.cfg))}
    }
    var j=S.cur=S.pool[S.idx];
    $('j-no').textContent='#'+j.no;$('j-name').textContent=j.name;
    $('j-age').textContent=j.age;$('j-gender').textContent=j.gender;$('j-race').textContent=j.race;$('j-occ').textContent=j.occ;
    $('j-facts').innerHTML='<li class="vds-fact--none">Nothing yet. Ask.</li>';
    $('j-qleft').textContent='(3 questions left)';
    document.querySelectorAll('.vds-q').forEach(function(b){b.disabled=false});
    $('cause-picker').hidden=true;
    updateStatus();
  }
  var QA={
    media:function(j){var t;if(j.facts.media==='none'){t='Hasn’t seen coverage of this case.'}else if(j.facts.media==='some'){t='Saw a headline or two; says it left no impression.'}else{t='Followed the coverage closely'+(j.facts.opinion?' — and admits they’ve “probably already got a view.”':' but insists they can set it aside.')}reveal(j,'media',t);return t},
    experience:function(j){var t=j.facts.exp?('Life experience: '+j.facts.exp+'.'):'No relevant personal history with robbery or the courts.';reveal(j,'experience',t);return t},
    police:function(j){var t=j.facts.police?('States plainly: '+j.facts.police+'.'):'Says they’d weigh an officer’s testimony like anyone else’s.';reveal(j,'police',t);return t},
    hardship:function(j){var t=j.facts.hardship?('Raises a hardship: '+j.facts.hardship+'.'):'No scheduling or hardship issues.';reveal(j,'hardship',t);return t},
    law:function(j){var t=j.facts.law?('On the law: '+j.facts.law+'.'):'Affirms they can presume innocence and hold the State to its burden.';reveal(j,'law',t);return t}
  };
  function causeSupported(j,basis){
    if(basis==='bias'){
      if(j.revealed.indexOf('media')>=0 && j.facts.opinion) return 'Juror admitted a formed opinion from coverage. Granted — that is demonstrated bias.';
      if(j.revealed.indexOf('police')>=0 && j.facts.police) return 'A stated inability to weigh testimony neutrally goes to bias. Granted.';
      if(j.revealed.indexOf('experience')>=0 && j.facts.exp==='robbery victim') return 'Given the juror’s own robbery, the court errs on the side of caution. Granted.';
      return null;
    }
    if(basis==='hardship'){ if(j.revealed.indexOf('hardship')>=0 && j.facts.hardship) return 'Hardship is on the record. Granted — the juror is excused with the court’s thanks.'; return null; }
    if(basis==='law'){ if(j.revealed.indexOf('law')>=0 && j.facts.law) return 'A juror who cannot apply the presumption or the burden cannot serve. Granted.'; return null; }
    return null;
  }
  function denialLine(j,basis){
    var hasHidden = (basis==='bias'&&(j.facts.opinion||j.facts.police||j.facts.exp==='robbery victim'))||(basis==='hardship'&&j.facts.hardship)||(basis==='law'&&j.facts.law);
