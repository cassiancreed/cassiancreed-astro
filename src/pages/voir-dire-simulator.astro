    if(basis==='hardship') return 'Denied. No hardship has been raised.';
    if(basis==='bias') return 'Denied. Occupation and demeanor alone are not cause — cause is argued from the record, not asserted.';
    return 'Denied. This juror has said nothing suggesting they cannot follow the law.';
  }
  function batsonScan(strikes){
    var byRace={},byGender={},i,s;
    for(i=0;i<strikes.length;i++){s=strikes[i];byRace[s.race]=(byRace[s.race]||0)+1;byGender[s.gender]=(byGender[s.gender]||0)+1}
    var n=strikes.length,k;
    for(k in byRace){if(byRace[k]>=3&&byRace[k]/n>=0.75)return{cls:'race/ethnicity',group:k}}
    for(k in byGender){if(byGender[k]>=4&&byGender[k]/n>=0.8)return{cls:'gender',group:k}}
    return null;
  }
  function nonProtectedToast(strikes){
    var older=strikes.filter(function(s){return s.age>=60}).length;
    if(older>=3&&!S.ageToasted){S.ageToasted=true;toast('Pattern noted: several older jurors struck. Age is NOT a Batson-protected class — that pattern is legal. Whether it’s wise is a different question.')}
    var occ={},i;for(i=0;i<strikes.length;i++){occ[strikes[i].occ]=(occ[strikes[i].occ]||0)+1;if(occ[strikes[i].occ]>=2&&!S.occToasted){S.occToasted=true;toast('You’ve struck the same occupation twice. Occupation is not a protected class either — lawyers strike by job all the time.')}}
  }
  function playerStrike(){
    if(S.mine<=0)return;
    var j=S.cur;
    var flagged = batsonScan(S.myStrikes.concat([j]));
    if(flagged && !S.batsonSpent[flagged.cls+flagged.group]){
      S.batsonSpent[flagged.cls+flagged.group]=true;
      var neutral=[];
      j.revealed.forEach(function(k){
        if(k==='media'&&j.facts.media!=='none')neutral.push(['“Heavy media exposure.” — a real, revealed, neutral reason',true]);
        if(k==='police'&&j.facts.police)neutral.push(['“Their stated view of police testimony.” — revealed and neutral',true]);
        if(k==='experience'&&j.facts.exp)neutral.push(['“Their life experience: '+j.facts.exp+'.” — revealed and neutral',true]);
        if(k==='hardship'&&j.facts.hardship)neutral.push(['“The hardship they raised.” — revealed and neutral',true]);
      });
      neutral.push(['“Gut feeling, Your Honor.”',false]);
      neutral.push(['“Honestly? The demographics.”',false]);
      var html='<p><strong>Opposing counsel rises: “Batson challenge, Your Honor.”</strong></p>'+
        '<p>Your peremptory strikes have fallen in a pattern against one '+flagged.cls+' group ('+flagged.group+'). <strong>Race, ethnicity, and gender are constitutionally protected from peremptory strikes</strong> — <em>Batson v. Kentucky</em> (1986) for race and ethnicity, <em>J.E.B. v. Alabama</em> (1994) for gender. Age and occupation are <em>not</em> protected classes.</p>'+
        '<p>The judge turns to you: <strong>“Counsel, I need a neutral reason for this strike.”</strong></p>';
      var acts=neutral.map(function(nr){
        return [nr[0],function(){
          if(nr[1]){S.batsonFlags++;log('BATSON: challenge survived — your reason was neutral on this record. The judge notes the pattern.','lg-batson');commitStrike(j,true)}
          else{S.batsonFlags++;S.batsonLost++;S.mine--;log('BATSON: pretext found. Strike disallowed — Juror #'+j.no+' will be seated. You lose that peremptory (remedies vary in real courts).','lg-batson');seat(j,'seated over a disallowed strike');advance()}
        }];
