  function aiTurn(j,cb){
    var d=S.side==='defense';
    var bad=0;
    if(j.facts.police==='distrusts police testimony') bad+= d?-2:3;
    if(j.facts.police==='gives police extra credence') bad+= d?3:-2;
    if(j.facts.exp==='robbery victim') bad+= d?3:-1;
    if(j.facts.exp==='law-enforcement family') bad+= d?2:-2;
    if(j.facts.opinion) bad+=2;
