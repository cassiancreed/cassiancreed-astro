  document.querySelectorAll('.vds-sidebtn').forEach(function(b){
    b.addEventListener('click',function(){
      document.querySelectorAll('.vds-sidebtn').forEach(function(x){x.setAttribute('aria-pressed','false')});
      b.setAttribute('aria-pressed','true');S.side=b.dataset.side;
      var st=$('vds-start');st.disabled=false;st.textContent='Begin voir dire →';
    });
  });
  $('sl-media').addEventListener('input',function(){$('out-media').textContent=this.value+'%'});
  $('sl-comm').addEventListener('input',function(){var v=+this.value;$('out-comm').textContent=v<35?'Police-skeptical':(v>65?'Tough on crime':'Balanced')});
  $('sl-pool').addEventListener('input',function(){$('out-pool').textContent=this.value+' jurors'});
  $('vds-start').addEventListener('click',start);
  $('vds-again').addEventListener('click',function(){$('vds-end').hidden=true;$('vds-setup').hidden=false});
  document.querySelectorAll('.vds-q').forEach(function(b){
    b.addEventListener('click',function(){
      var j=S.cur;if(j.qleft<=0)return;
      j.qleft--;S.questionsAsked++;
      var ans=QA[b.dataset.q](j);
      log('Q to #'+j.no+' ('+b.textContent.trim()+'): '+ans,'');
      b.disabled=true;
      $('j-qleft').textContent='('+j.qleft+' question'+(j.qleft===1?'':'s')+' left)';
      if(j.qleft===0)document.querySelectorAll('.vds-q').forEach(function(x){x.disabled=true});
    });
  });
  $('act-cause').addEventListener('click',function(){$('cause-picker').hidden=!$('cause-picker').hidden});
  document.querySelectorAll('.vds-cause').forEach(function(b){
    b.addEventListener('click',function(){
      $('cause-picker').hidden=true;
      var basis=b.dataset.basis;if(basis==='cancel')return;
      var j=S.cur, ok=causeSupported(j,basis);
      if(ok){S.causeWon++;log('THE COURT on your cause challenge (#'+j.no+', '+basis+'): '+ok,'lg-judge');advance()}
      else{S.causeLost++;log('THE COURT on your cause challenge (#'+j.no+', '+basis+'): '+denialLine(j,basis),'lg-judge')}
