  }
  function advance(){S.idx++;updateStatus();showJuror()}
  function endGame(){
    $('vds-game').hidden=true;$('vds-end').hidden=false;
    var sc='<p class="vds-k">Scorecard</p><table>'+
      '<tr><td>Your peremptories spent</td><td>'+(6-S.mine)+' / 6</td></tr>'+
      '<tr><td>Their peremptories spent</td><td>'+(6-S.theirs)+' / 6</td></tr>'+
      '<tr><td>Cause challenges — won / lost</td><td>'+S.causeWon+' / '+S.causeLost+'</td></tr>'+
      '<tr><td>Batson flags against you</td><td>'+S.batsonFlags+(S.batsonLost?' ('+S.batsonLost+' strike lost)':'')+'</td></tr>'+
      '<tr><td>Batson you raised — won / lost</td><td>'+S.batsonRaisedWon+' / '+S.batsonRaisedLost+'</td></tr>'+
      '<tr><td>Jurors questioned</td><td>'+S.questionsAsked+' questions</td></tr></table>';
    $('end-score').innerHTML=sc;
    var all=S.seated, avg=Math.round(all.reduce(function(a,j){return a+j.age},0)/all.length);
    var media=all.filter(function(j){return j.facts.media!=='none'}).length;
    var victims=all.filter(function(j){return j.facts.exp==='robbery victim'}).length;
    var skept=all.filter(function(j){return j.facts.police==='distrusts police testimony'}).length;
    $('end-profile').innerHTML='<p class="vds-k">Seated panel profile</p><p>Average age '+avg+'. '+media+' of 12 saw some coverage. '+victims+' robbery victim(s). '+skept+' police-skeptic(s). Two alternates behind them.</p>';
    var t=[];
    if(S.cfg.media>=70)t.push('Under heavy media saturation you burned strikes on exposure alone — exactly why high-publicity trials seat juries slowly.');
    if(S.batsonFlags>0)t.push('You drew a Batson flag: race, ethnicity, and gender are protected from peremptory strikes — age and occupation are not. That line is the whole lesson.');
    if(S.causeLost>S.causeWon)t.push('Most of your cause challenges died for lack of a record. Cause is argued from answers, not asserted from hunches — question first.');
    if(t.length<3)t.push('Every strike is a trade: remove one risk and you may seat a worse one you never questioned.');
    if(t.length<3)t.push('The judge granted cause only where the record supported it — the transcript, not instinct, is the currency of voir dire.');
