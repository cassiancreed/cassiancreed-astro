  function seat(j,why){
    if(S.seated.length<12){S.seated.push(j);log('Juror #'+j.no+' ('+j.occ+', '+j.age+') is SEATED'+(why?' — '+why:'')+'. ('+S.seated.length+'/12)','lg-seat')}
