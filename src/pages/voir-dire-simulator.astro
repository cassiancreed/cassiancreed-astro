  $('act-strike').addEventListener('click',playerStrike);
  $('act-accept').addEventListener('click',function(){
    var j=S.cur;
    log('You accept Juror #'+j.no+'.','');
    aiTurn(j,function(handled){ if(handled===null){seat(j,'accepted by both sides')} advance(); });
  });
  })();
  </script>
