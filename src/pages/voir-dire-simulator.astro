          '<p>Opposing counsel’s peremptories have clustered against one '+pat.cls+' group ('+pat.group+'). You may raise a <strong>Batson challenge</strong> and make them state a neutral reason.</p>',
          [['Raise Batson',function(){
            if(chance(.6)){S.batsonRaisedWon++;log('BATSON (yours): the judge finds pretext — their strike is disallowed and Juror #'+j.no+' is seated.','lg-batson');seat(j,'seated — opposing strike disallowed');cb(true);return}
