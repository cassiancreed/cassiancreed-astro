  }
  function start(){
    S.cfg={media:+$('sl-media').value,comm:+$('sl-comm').value,pool:+$('sl-pool').value};
    S.pool=[];for(var i=1;i<=S.cfg.pool;i++)S.pool.push(makeJuror(i,S.cfg));
    S.idx=0;S.seated=[];S.alternates=[];S.mine=6;S.theirs=6;S.myStrikes=[];S.theirStrikes=[];
    S.causeWon=0;S.causeLost=0;S.batsonFlags=0;S.batsonLost=0;S.batsonRaisedWon=0;S.batsonRaisedLost=0;
    S.batsonSpent={};S.aiBatsonDone=false;S.ageToasted=false;S.occToasted=false;S.questionsAsked=0;
    $('vds-setup').hidden=true;$('vds-end').hidden=true;$('vds-game').hidden=false;$('vds-log').innerHTML='';
