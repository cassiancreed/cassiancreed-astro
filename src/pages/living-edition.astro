---
import Base from '../layouts/Base.astro';
const updated = "June 26, 2026";
const cases = [
  { name:"The Delphi Murders", subject:"Richard Allen", status:"Convicted · under appeal", tone:"appeal", note:"Convicted on all counts; sentenced to 130 years. Appeal oral arguments are scheduled for Sept. 21, 2026.", book:"/books/#down-the-hill" },
  { name:"The Gilgo Beach Murders", subject:"Rex Heuermann", status:"Convicted · sentenced", tone:"closed", note:"Pleaded guilty in April 2026 to eight murders and was sentenced in June 2026 to life without parole.", book:null },
  { name:"The Murder of Rachel Morin", subject:"Victor Martinez-Hernandez", status:"Convicted · sentenced", tone:"closed", note:"Identified through forensic genetic genealogy; convicted and sentenced to life without parole.", book:"/books/#the-trail" },
  { name:"The Mackenzie Shirilla Story", subject:"Mackenzie Shirilla", status:"Convicted · appeals exhausted", tone:"closed", note:"Convicted of murder in 2023; the Ohio Supreme Court declined to hear a further appeal in June 2026.", book:"/books/#no-accident" },
  { name:"The Brendan Banfield Story", subject:"Brendan Banfield", status:"Convicted · sentenced", tone:"closed", note:"Convicted on all counts in early 2026; sentenced in June 2026 to life in prison.", book:"/books/#the-frame" },
  { name:"The Kouri Richins Story", subject:"Kouri Richins", status:"Convicted · sentenced", tone:"closed", note:"Convicted of aggravated murder in March 2026; sentenced in May 2026 to life without parole. She has stated she will appeal.", book:null },
  { name:"The Luigi Mangione Case", subject:"Luigi Mangione", status:"Charged · awaiting trial", tone:"open", note:"Charged and has pleaded not guilty. Trial is scheduled for September 2026. He is presumed innocent unless and until proven guilty.", book:null }
];
const log = [
  { date:"Jun 24, 2026", text:"Ohio Supreme Court declined to hear Mackenzie Shirilla's further appeal; her 2023 murder conviction stands." },
  { date:"Jun 17, 2026", text:"Rex Heuermann sentenced to life without parole in the Gilgo Beach murders, following his April 2026 guilty pleas." },
  { date:"Jun 5, 2026",  text:"Brendan Banfield sentenced to life in prison after his conviction earlier in the year." },
  { date:"May 13, 2026", text:"Kouri Richins sentenced to life without parole; she has said she intends to appeal." }
];
const jsonld = {
  "@context":"https://schema.org",
  "@type":"WebPage",
  "name":"The Living Edition — Case Tracker",
  "url":"https://cassiancreed.com/living-edition/",
  "description":"A maintained true-crime case tracker: legal status, verdict-change alerts, and cross-case pattern essays from Cassian Creed.",
  "isPartOf":{ "@id":"https://cassiancreed.com/#website" }
};
---
<Base title="The Living Edition — Case Tracker | Cassian Creed" description="A maintained true-crime case tracker: current legal status, verdict-change alerts, and cross-case pattern essays. Sourced from the public record." jsonld={jsonld}>

<section class="le-hero">
<p class="le-kicker">The Living Edition</p>
<h1>The Case Tracker</h1>
<p class="le-sub">Every case we publish stays open on our desk. This page tracks the current legal status of each subject, flags verdict changes as they happen, and links the patterns that run between cases. Sourced from the public record.</p>
<p class="le-updated">Last updated: {updated}</p>
</section>

<section class="le-block">
<h2>Verdict &amp; Status Log</h2>
<p class="le-note">The most recent changes to the record, newest first.</p>
<ol class="le-log">
{log.map((e) => (
<li><span class="le-date">{e.date}</span><span class="le-text">{e.text}</span></li>
))}
</ol>
</section>

<section class="le-block">
<h2>Cases We Track</h2>
<p class="le-note">Status labels follow the public record. Anyone not convicted is presumed innocent.</p>
<div class="le-grid">
{cases.map((c) => (
<article class={`le-card le-${c.tone}`}>
<div class="le-card-top">
<h3>{c.name}</h3>
<span class="le-badge">{c.status}</span>
</div>
<p class="le-subject">Subject: {c.subject}</p>
<p class="le-card-note">{c.note}</p>
{c.book && <a class="le-link" href={c.book}>Read the case file &rarr;</a>}
</article>
))}
</div>
</section>

<section class="le-block le-method">
<h2>How We Maintain This</h2>
<p>We monitor court dockets, official filings, and primary reporting. When a status changes — a plea, a verdict, a sentence, an appeal — we update the relevant case file and note it in the log above. We distinguish precisely between accused, charged, convicted, and acquitted, and we correct the record when the record changes.</p>
<p class="le-method-foot">Spot something out of date? <a href="/about/">Reach the desk.</a></p>
</section>

</Base>

<style>
.le-hero{max-width:780px;margin:0 auto;padding:3.5rem 1.25rem 1rem;text-align:center}
.le-kicker{text-transform:uppercase;letter-spacing:.18em;font-size:.78rem;color:#9a6a3a;margin:0 0 .5rem}
.le-hero h1{font-size:2.6rem;line-height:1.1;margin:0 0 1rem}
.le-sub{font-size:1.12rem;line-height:1.6;color:#444;margin:0 auto;max-width:620px}
.le-updated{margin-top:1.25rem;font-size:.85rem;color:#888;font-style:italic}
.le-block{max-width:880px;margin:0 auto;padding:2rem 1.25rem}
.le-block h2{font-size:1.6rem;margin:0 0 .35rem}
.le-note{color:#777;font-size:.95rem;margin:0 0 1.5rem}
.le-log{list-style:none;padding:0;margin:0;border-left:2px solid #e5ddd2}
.le-log li{display:flex;gap:1rem;padding:.85rem 0 .85rem 1.25rem;position:relative}
.le-log li::before{content:"";position:absolute;left:-7px;top:1.15rem;width:10px;height:10px;border-radius:50%;background:#9a6a3a}
.le-date{flex:0 0 92px;font-size:.82rem;color:#9a6a3a;font-weight:600;padding-top:.1rem}
.le-text{font-size:1rem;line-height:1.5;color:#333}
.le-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.1rem}
.le-card{border:1px solid #e7e0d6;border-radius:12px;padding:1.25rem;background:#fff;border-top:4px solid #c9c0b4}
.le-open{border-top-color:#c08a2d}
.le-appeal{border-top-color:#7a6fae}
.le-closed{border-top-color:#5b7a5b}
.le-card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem}
.le-card h3{font-size:1.12rem;margin:0;line-height:1.25}
.le-badge{flex:0 0 auto;font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;background:#f3eee6;color:#6b5d49;padding:.25rem .5rem;border-radius:999px;font-weight:600}
.le-subject{font-size:.88rem;color:#9a6a3a;margin:.6rem 0 .5rem;font-weight:600}
.le-card-note{font-size:.95rem;line-height:1.55;color:#444;margin:0 0 .75rem}
.le-link{font-size:.9rem;color:#9a6a3a;text-decoration:none;font-weight:600}
.le-link:hover{text-decoration:underline}
.le-method{background:#faf7f2;border-radius:14px;margin-top:1rem}
.le-method p{font-size:1rem;line-height:1.6;color:#3a3a3a}
.le-method-foot{font-size:.95rem;color:#666}
.le-method-foot a,.le-method a{color:#9a6a3a}
@media(max-width:560px){.le-hero h1{font-size:2rem}.le-date{flex-basis:78px}}
</style>
