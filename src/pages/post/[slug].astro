---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import CaptureBlock from '../../components/CaptureBlock.astro';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // Nancy Guthrie is excluded from related-content rails by standing order; the page itself stays live.
  const caseFiles = posts.filter(p => p.data.tag === 'Case Files' && p.slug !== 'nancy-guthrie-abduction-what-we-know');
  return posts.map(p => {
    const idx = caseFiles.findIndex(o => o.slug === p.slug);
    let rel = [];
    if (idx >= 0) { for (let k = 1; k <= 3; k++) rel.push(caseFiles[(idx + k) % caseFiles.length]); }
    else { rel = caseFiles.slice(0, 3); }
    rel = rel.filter(r => r && r.slug !== p.slug);
    return { params: { slug: p.slug }, props: { post: p, related: rel.map(r => ({ slug: r.slug, title: r.data.title })) } };
  });
}
const { post, related = [] } = Astro.props;
// Per-page lead-magnet matching (NEP-REV-CWK-0717AF): pick the offer that matches
// who lands on THIS post. Frontmatter `capture` wins; else classify by slug.
// DNA/genealogy -> dna guide; safety/coercive-control -> safety guide; else Jury Chess.
function pickOffer(p){
  const explicit = p.data.capture;
  if (explicit === 'dna' || explicit === 'safety' || explicit === 'jury') return explicit;
  const s = p.slug;
  if (/(dna|genetic-genealog|genealog|family-tree|othram|codis|-fgg-|fgg-|forensic-genetic)/.test(s)) return 'dna';
  if (/(coercive-control|warning-signs|stay-safe|safety)/.test(s)) return 'safety';
  return 'jury';
}
const captureOffer = pickOffer(post);
const { Content } = await post.render();
const isCase = post.data.tag === 'Case Files';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const mk = (m) => encodeURIComponent(pageUrl + '?utm_source=' + m + '&utm_medium=social_share');
const shareT = encodeURIComponent(post.data.title);
const articleNode = {
  "@type":"Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString().slice(0,10),
  "author":{"@type":"Organization","name":"Cassian Creed"},
  "publisher":{"@type":"Organization","name":"Neural Edge Publishing"},
  "mainEntityOfPage": new URL(Astro.url.pathname, Astro.site).href,
  "articleSection": post.data.tag,
"dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0,10)
};
// Auto-derive FAQPage from an on-page "Frequently Asked Questions"/"FAQ" section.
// Mirrors only visible Q&A text (Google structured-data guideline); emits nothing if absent.
function extractFaq(body) {
  const sec = body.match(/#{2,}\s*(?:Frequently Asked Questions|FAQ|Questions [Rr]eaders [Aa]sk)\s*\n([\s\S]*?)(?=\n#{2,}\s|\n---\s*\n|$)/i);
  if (!sec) return [];
  const out = [];
  const re = /\*\*(.+?)\*\*\s*\n*([^\n*][\s\S]*?)(?=\n\s*\n|\n\*\*|$)/g;
  let m;
  while ((m = re.exec(sec[1]))) {
    out.push({ q: m[1].trim(), a: m[2].replace(/\s+/g, ' ').trim() });
  }
  return out;
}
const faq = extractFaq(post.body);
const faqNode = faq.length ? {
  "@type":"FAQPage",
  "mainEntity": faq.map(f => ({ "@type":"Question", "name": f.q, "acceptedAnswer": { "@type":"Answer", "text": f.a } }))
} : null;
const jsonld = faqNode
  ? { "@context":"https://schema.org", "@graph": [articleNode, faqNode] }
  : { "@context":"https://schema.org", ...articleNode };
---
<Base title={post.data.seoTitle ?? post.data.title} description={post.data.description} jsonld={jsonld} ogImage={post.data.cover ?? `/og/${post.slug}.png`}>
  <article class="post">
    <p class="evidence evidence--accent">{post.data.tag}</p>
    <h1>{post.data.title}</h1>
<p class="post__dates"><time datetime={post.data.pubDate.toISOString().slice(0,10)}>Published {post.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time>{post.data.updatedDate && <> · <time datetime={post.data.updatedDate.toISOString().slice(0,10)}>Updated {post.data.updatedDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time></>}</p>
    {isCase && <p class="post__note">A note before you read: this is a true account of real people and a real crime. We tell it with care — centered on the victims, grounded in the record, and without gratuitous detail.</p>}
    {post.data.victim && (
      <aside class="case-facts">
        <p class="evidence evidence--accent">Case facts</p>
        <dl>
          <div><dt>Victim(s)</dt><dd>{post.data.victim}</dd></div>
          {post.data.incidentDate && <div><dt>Date</dt><dd>{post.data.incidentDate}</dd></div>}
          {post.data.location && <div><dt>Location</dt><dd>{post.data.location}</dd></div>}
          {post.data.jurisdiction && <div><dt>Jurisdiction</dt><dd>{post.data.jurisdiction}</dd></div>}
          {post.data.status && <div><dt>Legal status</dt><dd>{post.data.status}</dd></div>}
        </dl>
      </aside>
    )}
    <div class="post__content"><Content /></div>
    {post.data.buyUrl && (
      <aside class="buybox">
        <p class="buybox__k">The ebook edition</p>
        <p class="buybox__t">Prefer to read offline — or want to support independent, victim-first true crime? Get the complete case file as an ebook.</p>
        <a class="btn buybox__btn" href={post.data.buyUrl} target="_blank" rel="noopener noreferrer">{post.data.buyPrice ? ("Buy the ebook — " + post.data.buyPrice + " →") : "Buy the ebook →"}</a>
      </aside>
    )}
    {isCase && <p class="post__crisis"><strong>If you need support.</strong> 988 Suicide &amp; Crisis Lifeline (call or text 988) · National Domestic Violence Hotline 1-800-799-7233 (text START to 88788) · RAINN 1-800-656-HOPE (4673).</p>}
    <p class="post__resources"><a href="/support/">Victim &amp; Reader Resources</a> &mdash; free, confidential help for victims, families, and readers.</p>
  </article>

  <div class="wrap"><section class="convert" id="free-guide">
    <div class="convert__grid">
      <CaptureBlock offer={captureOffer} content={'post_' + post.slug} />
      {/* CONVERSION-FIRST RANK 1 (2026-07-28): the sitewide `.convert__book`
          aside sold The Trail at $1.99 from the foot of EVERY post. The title
          is held for worthiness review, so the aside was removed and the
          two-column grid collapsed to one column below — leaving the email
          capture as the single CTA instead of a half-empty row. Recoverable
          from git history; the .convert__book* rules are retained and unused. */}
    </div>
  </section></div>

  <div class="wrap"><nav class="share" aria-label="Share this case file">
    <span class="share__label">Share this case file</span>
    <a class="share__btn" href={`https://twitter.com/intent/tweet?text=${shareT}&url=${mk('x')}`} target="_blank" rel="noopener noreferrer">X / Twitter</a>
    <a class="share__btn" href={`https://www.facebook.com/sharer/sharer.php?u=${mk('facebook')}`} target="_blank" rel="noopener noreferrer">Facebook</a>
    <a class="share__btn" href={`https://www.pinterest.com/pin/create/button/?url=${mk('pinterest')}&description=${shareT}`} target="_blank" rel="noopener noreferrer">Pinterest</a>
    <a class="share__btn" href={`https://bsky.app/intent/compose?text=${shareT}%20${mk('bluesky')}`} target="_blank" rel="noopener noreferrer">Bluesky</a>
  </nav></div>

  {related.length > 0 && (
  <div class="wrap"><section class="related" aria-label="Related case files">
    <h2>Related case files</h2>
    <ul class="related__list">{related.map(r => <li><a href={`/post/${r.slug}/`}>{r.title}</a></li>)}</ul>
  </section></div>
  )}
</Base>

<style>
  .share{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin:8px 0 0}
  .share__label{font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-2)}
  .share__btn{font-size:13px;text-decoration:none;border:1px solid rgba(224,86,59,.4);border-radius:20px;padding:6px 13px;color:var(--ink);transition:background .15s}
  .share__btn:hover{background:rgba(224,86,59,.12)}
  .buybox{margin:28px 0 8px;padding:20px 22px;background:var(--bg-3);border:1px solid rgba(95,174,126,.45);border-radius:10px}
  .buybox__k{font-family:var(--mono,'JetBrains Mono',monospace);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#5fae7e;margin:0 0 6px}
  .buybox__t{margin:0 0 14px;font-size:16px}
  .buybox__btn{align-self:flex-start}
  .buybox__alt{display:inline-block;margin-top:10px;font-size:13px;text-decoration:none;color:var(--ink-2)}
  .buybox__alt:hover{color:var(--accent,#e0563b)}
  .related{border-top:1px solid var(--line);padding-top:24px;margin-top:8px}
  .related h2{font-family:var(--serif);font-weight:600;font-size:22px;margin:0 0 14px}
  .related__list{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .related__list a{color:var(--ink);text-decoration:none;border-left:2px solid var(--accent);padding-left:12px;display:inline-block;transition:color .15s}
  .related__list a:hover{color:var(--accent,#e0563b)}
  .convert{border-top:1px solid var(--line);padding-top:26px;margin-top:8px}
  /* Sticky header would otherwise cover the CTA heading on an anchor jump
     (NEP-CWK-IRASEMA-CONVERSION-RESCUE-0726). */
  #free-guide{scroll-margin-top:84px}
  /* Single column since the book aside was removed (RANK 1, 2026-07-28).
     Restore `1.6fr 1fr` if a second card ever returns to this block. */
  .convert__grid{display:grid;grid-template-columns:1fr;gap:26px;align-items:start}
  @media(max-width:720px){.convert__grid{grid-template-columns:1fr;gap:20px}}
  .convert__magnet{margin:14px 0 0;font-size:15px}
  .convert__magnet a{color:var(--accent,#e0563b);text-decoration:none;font-weight:600}
  .convert__magnet a:hover{text-decoration:underline}
  .convert__book{padding:18px 20px;background:var(--bg-3);border:1px solid rgba(95,174,126,.45);border-radius:10px}
  .convert__book-k{font-family:var(--mono,'JetBrains Mono',monospace);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#5fae7e;margin:0 0 6px}
  .convert__book-t{margin:0 0 14px;font-size:15px;line-height:1.45}
  .convert__book-btn{align-self:flex-start}
  .convert__book-alt{display:inline-block;margin-top:10px;font-size:13px;text-decoration:none;color:var(--ink-2)}
  .convert__book-alt:hover{color:var(--accent,#e0563b)}
  /* NEP-CWK-IRASEMA-CONVERSION-RESCUE-0726 — ONE PRIMARY ACTION ON MOBILE.
     On a phone the two-column convert grid collapses to a stack, which put the
     green "Buy The Trail" card directly beneath the email capture at equal
     visual weight: a filled button competing with the primary objective, and a
     paid ask aimed at a visitor who has not yet been given anything free.
     Demoted, not removed — the buy route still works for anyone who wants it,
     it just stops competing. Wording unchanged; visual weight only.
     MUST stay last in this block: same specificity as the base .convert__book
     rules above, so source order is what makes it win. */
  @media(max-width:720px){
    .convert__book{order:2;background:transparent;border:0;border-top:1px solid var(--line);padding:14px 0 0;border-radius:0}
    .convert__book-t{font-size:14px;color:var(--ink-2)}
    .convert__book-btn{background:transparent;color:var(--ink-2);border:1px solid var(--line);font-weight:500}
  }
</style>
