---
import Base from '../layouts/Base.astro';
// LEAD MAGNET — checklist-first optin page. Delivers:
//   (1) "The 7 Signs Investigators Look For at a Staged Scene" checklist
//   (2) the full Rachel Morin (The Trail) case-file dossier
// Both delivered via the Beehiiv welcome email — no on-page download link.
// Rachel Morin / Victor Martinez-Hernandez: convicted all four counts (Apr 2025);
// sentenced Aug 2025, two consecutive life terms w/o parole; stated intent to appeal;
// conviction stands.
// Beehiiv form mechanics and component patterns unchanged from free-dossier.astro.
const jsonld = {
  "@context":"https://schema.org","@type":"WebPage",
  "name":"The 7 Signs Investigators Look For at a Staged Scene — Free Checklist",
  "description":"A plain-language investigative checklist — what real investigators examine when a crime scene may have been staged — plus the full Rachel Morin case file. Free with the newsletter."
};
---
<Base title="The 7 Signs Investigators Look For at a Staged Scene — Free Checklist | Cassian Creed" description="Get a free plain-language checklist of what investigators look for at a staged crime scene — grounded in documented forensic practice — plus the full Rachel Morin case file. Free, with the newsletter." jsonld={jsonld}>
  <article class="lp">

    <section class="lp-hero" aria-labelledby="lp-h1">
      <p class="evidence evidence--accent">Free checklist + case file · sourced · victim-first</p>
      <h1 id="lp-h1">What investigators actually look for when a scene has been staged.</h1>
      <p class="lp-sub">A plain-language checklist of the 7 indicators real investigators examine — grounded in documented forensic practice, not TV. Enter your email and it's in your inbox in under a minute, along with the <strong>full Rachel Morin case file</strong>.</p>

      <form class="lp-capture" action="https://cassiancreed.beehiiv.com/subscribe" method="get" aria-label="Get the free checklist and case file">
        <label class="lp-capture__label" for="lp-email">Where should we send your checklist and case file?</label>
        <div class="lp-capture__row">
          <input id="lp-email" type="email" name="email" required autocomplete="email" placeholder="your email address" aria-label="Your email address" />
          <input type="hidden" name="utm_source" value="website" />
          <input type="hidden" name="utm_medium" value="lead_magnet_checklist" />
          <input type="hidden" name="utm_campaign" value="staged_scene_checklist" />
          <button class="btn" type="submit">Send me the checklist →</button>
        </div>
        <p class="lp-capture__fine">Your email goes to our list. We send case updates and new releases — no third parties, no daily emails, unsubscribe any time.</p>
      </form>

      <ul class="lp-bullets" aria-label="What you get">
        <li><strong>The 7 Signs checklist</strong> — plain language, grounded in documented investigative practice. What the indicators are, and what they actually mean.</li>
        <li><strong>The full Rachel Morin case file</strong> — the timeline, the DNA evidence, and how Investigative Genetic Genealogy (IGG) identified the suspect. Primary-source documented.</li>
        <li><strong>Victims named in life first</strong> — every case file leads with who they were, not how they died.</li>
        <li><strong>The free newsletter</strong> — new case files when we publish them, the documented record. No filler.</li>
      </ul>
    </section>

    <section class="lp-block" aria-labelledby="lp-checklist-h">
      <h2 id="lp-checklist-h">What's in the checklist</h2>
      <ul class="lp-list">
        <li><strong>Scene inconsistency</strong> — when the physical scene doesn't match the stated account, and what investigators do with that gap.</li>
        <li><strong>Wound patterns</strong> — how medical examiners compare injury characteristics against the described mechanics of an event.</li>
        <li><strong>Digital trails</strong> — phone location data, timestamps, and access records that create an independent timeline.</li>
        <li><strong>Placed vs. disturbed evidence</strong> — what the physics of a genuine scene look like, and how arranged evidence differs.</li>
        <li><strong>Account inconsistencies</strong> — the narrow distinction between trauma-driven memory gaps and tracking-new-information shifts.</li>
        <li><strong>Forensic cross-checks</strong> — why staging typically fails at the intersection of independent evidence streams.</li>
        <li><strong>Behavioral context</strong> — how documented behavioral evidence is used alongside physical and digital records, and what it cannot determine on its own.</li>
      </ul>
    </section>

    <section class="lp-block" aria-labelledby="lp-morin-h">
      <h2 id="lp-morin-h">The Rachel Morin case file — also in your inbox</h2>
      <aside class="lp-glance" aria-label="The case at a glance">
        <p class="lp-glance__k">The case, in 10 seconds</p>
        <dl>
          <div><dt>Victim</dt><dd>Rachel Morin — mother of five · Harford County, Maryland · Aug 5, 2023</dd></div>
          <div><dt>Identified</dt><dd>Victor Martinez-Hernandez — arrested June 2024 via DNA &amp; genetic genealogy</dd></div>
          <div><dt>Status</dt><dd>Convicted on all four counts (Apr 2025); sentenced Aug 2025 to two consecutive life terms without parole — he stated intent to appeal; the conviction stands</dd></div>
          <div><dt>How it turned</dt><dd>Crime-scene DNA → linked to an earlier assault → genealogy → a name</dd></div>
        </dl>
      </aside>
      <ul class="lp-list" style="margin-top:14px">
        <li><strong>The people first</strong> — Rachel Morin in life, a mother of five, before the man who harmed her.</li>
        <li><strong>A primary-source timeline</strong> — from the August 2023 disappearance on the Ma &amp; Pa Trail to the 2024 arrest, the 2025 conviction, and the life sentence.</li>
        <li><strong>The IGG method, documented</strong> — how Investigative Genetic Genealogy (IGG) took crime-scene DNA to a name with no prior connection to the victim.</li>
        <li><strong>A Stay-Safe sidebar</strong> — what the case teaches, and where to turn for help.</li>
      </ul>
    </section>

    <section class="lp-hero lp-repeat" aria-labelledby="lp-repeat-h">
      <h2 id="lp-repeat-h" class="lp-repeat__h">Get the checklist and case file — free.</h2>
      <form class="lp-capture" action="https://cassiancreed.beehiiv.com/subscribe" method="get" aria-label="Get the free checklist and case file — repeat form">
        <label class="lp-capture__label" for="lp-email-2">Your email address</label>
        <div class="lp-capture__row">
          <input id="lp-email-2" type="email" name="email" required autocomplete="email" placeholder="your email address" aria-label="Your email address" />
          <input type="hidden" name="utm_source" value="website" />
          <input type="hidden" name="utm_medium" value="lead_magnet_checklist" />
          <input type="hidden" name="utm_campaign" value="staged_scene_checklist" />
          <button class="btn" type="submit">Send me the checklist →</button>
        </div>
        <p class="lp-capture__fine">Your email goes to our list. We send case updates and new releases — no third parties, no daily emails, unsubscribe any time.</p>
      </form>
    </section>

    <section class="lp-buy" aria-labelledby="lp-buy-h">
      <h2 id="lp-buy-h">If you want the full-length case file</h2>
      <p class="lp-buy__lead">The book goes all the way — the complete timeline, the records, the people at the center.</p>
      <div class="lp-buy__cards">
        <div class="lp-buy__card">
          <p class="lp-buy__k">The Trail — ebook</p>
          <p class="lp-buy__price">$1.99</p>
          <a class="btn" href="https://cassiancreed.beehiiv.com/products/the-trail?utm_source=website&utm_medium=landing&utm_campaign=the_trail" target="_blank" rel="noopener noreferrer">Buy The Trail — $1.99 →</a>
        </div>
      </div>
    </section>

    <p class="lp-crisis"><strong>If you need support.</strong> 988 Suicide &amp; Crisis Lifeline (call or text 988) · RAINN 1-800-656-HOPE · National Domestic Violence Hotline 1-800-799-7233. Cassian Creed · Neural Edge Publishing · PO Box 1039.</p>

  </article>
</Base>

<style>
  .lp{max-width:740px;margin:0 auto}
  .lp h1,.lp h2{font-family:var(--serif)}
  #lp-h1{font-weight:600;font-size:clamp(28px,5vw,44px);line-height:1.1;margin:10px 0 14px;max-width:22ch}
  .lp-sub{color:var(--ink-2);font-size:17px;line-height:1.65;max-width:62ch;margin:0 0 18px}
  .lp-glance{background:var(--bg-2);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:0 10px 10px 0;padding:14px 18px;margin:0 0 18px}
  .lp-glance__k{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 8px}
  .lp-glance dl{margin:0;display:grid;gap:7px}
  .lp-glance dl div{display:grid;grid-template-columns:96px 1fr;gap:12px}
  .lp-glance dt{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);padding-top:2px}
  .lp-glance dd{margin:0;color:var(--ink);font-size:14px}
  .lp-capture{background:var(--bg-2);border:1px solid var(--line);border-radius:10px;padding:16px 18px;margin:0 0 20px}
  .lp-capture__label{display:block;color:var(--ink);font-size:15px;margin:0 0 10px}
  .lp-capture__row{display:flex;flex-wrap:wrap;gap:10px}
  .lp-capture input[type=email]{flex:1 1 220px;background:var(--bg);border:1px solid var(--line);border-radius:6px;color:var(--ink);padding:12px 14px;font-size:15px;min-height:48px}
  .lp-capture input[type=email]:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
  .lp-capture .btn{border:0;cursor:pointer;min-height:48px}
  .lp-capture__fine{color:var(--ink-3);font-size:12px;margin:10px 0 0}
  .lp-bullets{list-style:none;display:grid;gap:11px;padding:0;margin:0 0 4px}
  .lp-bullets li{color:var(--ink-2);line-height:1.6;border-left:2px solid var(--accent);padding-left:14px;max-width:64ch;font-size:15px}
  .lp-bullets strong{color:var(--ink)}
  .lp-block{padding:26px 0;border-top:1px solid var(--line)}
  .lp-block h2{font-weight:600;font-size:clamp(20px,3vw,28px);margin:0 0 14px}
  .lp-list{margin:0;padding:0;list-style:none;display:grid;gap:13px}
  .lp-list li{color:var(--ink-2);line-height:1.6;border-left:2px solid var(--accent);padding-left:14px;max-width:64ch}
  .lp-list strong{color:var(--ink)}
  .lp-repeat{border-top:1px solid var(--line);padding-top:26px}
  .lp-repeat__h{font-weight:600;font-size:clamp(20px,3vw,28px);margin:0 0 14px}
  .lp-buy{padding:26px 0;border-top:1px solid var(--line)}
  .lp-buy h2{font-weight:600;font-size:clamp(20px,3vw,28px);margin:0 0 14px}
  .lp-buy__lead{color:var(--ink-2);margin:0 0 16px}
  .lp-buy__cards{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .lp-buy__card{background:var(--bg-3);border:1px solid var(--line);border-radius:10px;padding:18px;display:flex;flex-direction:column;gap:7px}
  .lp-buy__card--bundle{border-color:rgba(224,86,59,.45)}
  .lp-buy__k{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin:0}
  .lp-buy__price{font-family:var(--serif);font-size:28px;font-weight:600;margin:0;color:var(--ink)}
  .lp-buy__was{font-size:15px;color:var(--ink-3);text-decoration:line-through;font-family:var(--sans);font-weight:400}
  .lp-buy__cardsub{color:var(--ink-2);font-size:13px;margin:0}
  .lp-buy .btn{align-self:flex-start;border:0;margin-top:4px}
  .lp-crisis{color:var(--ink-3);font-size:13px;line-height:1.6;margin-top:24px}
  .lp-crisis strong{color:var(--ink-2)}
  @media(max-width:600px){.lp-buy__cards{grid-template-columns:1fr}.lp-glance dl div{grid-template-columns:1fr}.lp-capture__row{flex-direction:column}.lp-capture .btn{width:100%}}
</style>
