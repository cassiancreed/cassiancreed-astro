---
import Base from '../layouts/Base.astro';
// /books/ store page — rebuilt 0721LS from books_page_copy_CERTIFIED_8.72.md.
// Copy is CERTIFIED text: do not paraphrase. Buy buttons use the exact live
// Beehiiv product URLs. Free guide CTA goes to the guide's own live $0 product
// checkout (delivery-matched); no anchor bounces on this page.
const jsonld = [
  // CONVERSION-FIRST RANK 1 (2026-07-28): the Book + Offer nodes for
  // "The Trail: The Murder of Rachel Morin" and "The Frame: The Murders of
  // Christine Banfield and Joseph Ryan" were removed here while both titles are
  // held for worthiness review. Nothing was deleted from source control — the
  // full nodes are recoverable from git history. Do not reinstate either node,
  // its Offer, or its product URL until Cassian approves the title's return.
  {
    "@context": "https://schema.org",
    "@type": "Book",
    "name": "Jury Chess: How Criminal Jury Trials Actually Work",
    "author": { "@id": "https://cassiancreed.com/#cassian-creed" },
    "publisher": { "@id": "https://cassiancreed.com/#org" },
    "bookFormat": "https://schema.org/EBook",
    "inLanguage": "en-US",
    "genre": ["Law", "Nonfiction"],
    "offers": [{ "@type": "Offer", "price": "3.99", "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://cassiancreed.beehiiv.com/products/jury-chess", "seller": { "@id": "https://cassiancreed.com/#org" } }]
  }
  // NEP-CWK-NO-ACCIDENT-WEBSITE-REMOVAL-0726: the third Book node
  // ("No Accident: The Mackenzie Shirilla Story") was removed with its catalog
  // card. Title withdrawn from the site by ruling — do not reinstate the node,
  // the Offer, or the product URL.
];
---
<Base title="Jury Chess: How Criminal Jury Trials Work" description="Jury Chess explains how criminal jury trials work—from jury selection and evidence rules through instructions, deliberations, and verdict." jsonld={jsonld}>
  <section class="bk-hero wrap">
    <h1 class="bk-hero__h">Jury Chess</h1>
    <p class="bk-hero__sub">How criminal jury trials actually work</p>
    <p class="bk-hero__p">The verified Cassian Creed book for readers who want to understand the courtroom process: what jurors may consider, how evidence reaches them, and how a criminal case moves from jury selection to verdict.</p>
  </section>

  <div class="wrap"><div class="shelf">

    {/* CONVERSION-FIRST RANK 1 (2026-07-28): the "The Trail: The Murder of
        Rachel Morin" (.bk--rust .bk--square) and "The Frame: The Murders of
        Christine Banfield and Joseph Ryan" (.bk--steel) shelf cards were
        removed here — cover block, hook, sales copy, price and buy CTA — while
        both titles are held for worthiness review. Beehiiv and PublishDrive
        were not touched by that change. Manuscripts, covers and copy are all
        intact; the cards themselves are recoverable from git history. The
        .bk--rust / .bk--steel / .bk--square theme rules are retained in the
        stylesheet below and are unused until a title reclaims them. Do not
        restore either card until Cassian approves the title's return. */}

    <div class="bk bk--ink" id="jury-chess">
      <div class="bk__cover bk__cover--art">
        <span class="bk__ribbon bk__ribbon--live">On sale</span>
        <img class="bk__img" src="/covers/jury-chess.jpg" alt="Book cover of Jury Chess: How Criminal Jury Trials Actually Work by Cassian Creed — a courtroom drawn in line art with a chessboard set in the jury box" width="600" height="900" loading="lazy" />
      </div>
      <div class="bk__meta">
        <h2 class="bk__title">Jury Chess: How Criminal Jury Trials Actually Work</h2>
        <p class="bk__hook">A criminal jury trial is not a television story or a public vote.</p>
        <p class="bk__desc">It is a controlled legal process shaped by burdens of proof, evidence rules, courtroom roles, jury instructions, and the limits of the admitted record. <em>Jury Chess</em> explains how that process works from jury selection through verdict—how to separate evidence from argument, follow objections and rulings, evaluate forensic claims carefully, and avoid treating allegations or public commentary as proof. Written for readers who follow criminal trials, with practical “Watch for This” exercises and 212 source notes. This book is for general education and is not legal advice.</p>
        <div class="bk__cta">
          <p class="bk__price">$3.99</p>
          <a class="btn bk__buy" href="https://cassiancreed.beehiiv.com/products/jury-chess" target="_blank" rel="noopener noreferrer">Get the book →</a>
        </div>
      </div>
    </div>

    {/* NEP-CWK-NO-ACCIDENT-WEBSITE-REMOVAL-0726: the third shelf card
        ("No Accident: The Mackenzie Shirilla Story") was removed here — card,
        cover block, sales copy, price and buy CTA. Title withdrawn from the
        site by ruling. The .bk--ink theme rules are retained in the stylesheet
        below and are unused until a future title claims them. */}

  </div></div>

  <div class="wrap"><section class="guide-offer" id="free-guide" aria-label="Free Voir Dire guide">
    <h2 class="guide-offer__h">Get the free Voir Dire guide</h2>
    <p class="bk__hook">Learn what lawyers are really doing before the first witness is called.</p>
    <p class="guide-offer__p">Voir dire can shape a criminal trial before opening statements begin. This free, plain-language guide explains challenges for cause, peremptory strikes, juror bias, and what to watch as both sides work to seat an impartial jury. Enter your email and the guide will be delivered to your inbox.</p>
    <div class="bk__cta">
      <p class="bk__price bk__price--free">Free</p>
      <a class="btn bk__buy" href="https://cassiancreed.beehiiv.com/products/voir-dire-the-free-guide" target="_blank" rel="noopener noreferrer">Get the free guide →</a>
    </div>
  </section></div>

  {/* JURY CHESS shipped 2026-07-26: the "Coming soon" block that stood here was
      replaced by a live shelf card above ($3.99, Beehiiv direct checkout). The
      .coming* theme rules are retained in the stylesheet below and are unused
      until a future title claims them. */}

  <section class="wrap bk-faq" aria-label="Frequently asked questions">
    <h2 class="bk-faq__h">Frequently Asked Questions</h2>
    <div class="bk-faq__item">
      <h3>How does delivery work?</h3>
      <p>Complete the purchase through the secure Stripe checkout. Your book is available as an instant download as soon as the purchase is complete.</p>
    </div>
    <div class="bk-faq__item">
      <h3>What format will I receive?</h3>
      <p><em>Jury Chess</em> is delivered as a PDF that opens on phones, tablets, and computers. The free Voir Dire guide is delivered by email.</p>
    </div>
    <div class="bk-faq__item">
      <h3>What if I need help or want to request a refund?</h3>
      <p>For a missing download, a refund request, or any other order question, email <a href="mailto:cassiancreed@cassiancreed.com">cassiancreed@cassiancreed.com</a>.</p>
    </div>
  </section>
</Base>

<style>
  .bk-hero{padding:8px 0 4px}
  .bk-hero__h{font-family:var(--serif);font-weight:600;font-size:clamp(30px,4.5vw,46px);line-height:1.08;margin:6px 0 4px}
  .bk-hero__sub{font-family:var(--mono,'JetBrains Mono',monospace);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent,#e0563b);margin:0 0 12px}
  .bk-hero__p{font-size:17px;line-height:1.5;color:var(--ink-1);max-width:62ch}
  .shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:26px;margin:8px 0}
  .bk{display:flex;flex-direction:column;background:var(--bg-2,#191512);border:1px solid var(--line,#2a2521);border-radius:14px;overflow:hidden;transition:transform .18s,box-shadow .18s}
  .bk:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(0,0,0,.45)}
  .bk__cover{position:relative;aspect-ratio:2/3;padding:22px 20px;display:flex;flex-direction:column;color:#f5efe8;isolation:isolate}
  .bk--square .bk__cover{aspect-ratio:1/1}
  .bk__cover--art{padding:0}
  .bk__img{display:block;width:100%;height:100%;object-fit:cover}
  .bk__cover::after{content:"";position:absolute;inset:0;z-index:-1;opacity:.9}
  .bk--rust .bk__cover{background:linear-gradient(150deg,#7a2417,#c9472b 55%,#e0563b)}
  .bk--steel .bk__cover{background:linear-gradient(150deg,#1f2b33,#33505f 60%,#4d7689)}
  .bk--ink .bk__cover{background:linear-gradient(150deg,#161616,#2c2c33 60%,#45454f)}
  .bk__cover{box-shadow:inset 14px 0 24px -16px rgba(0,0,0,.6)}
  .bk__ribbon{position:absolute;top:14px;right:0;font-family:var(--mono,'JetBrains Mono',monospace);font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:14px 0 0 14px;color:#fff;backdrop-filter:blur(2px)}
  .bk__ribbon--live{background:rgba(95,174,126,.95);color:#0f1a12}
  .bk__ctitle{font-family:var(--serif);font-weight:600;font-size:30px;line-height:1.05;margin-top:auto}
  .bk__csub{font-size:13.5px;opacity:.9;margin-top:8px;letter-spacing:.01em}
  .bk__meta{padding:18px 20px 22px;display:flex;flex-direction:column;gap:12px;flex:1}
  .bk__title{font-family:var(--serif);font-weight:600;font-size:20px;line-height:1.25;margin:0}
  .bk__hook{margin:0;font-size:14.5px;line-height:1.5;color:var(--ink-1);font-weight:600}
  .bk__desc{margin:0;font-size:14px;line-height:1.55;color:var(--ink-2)}
  .bk__cta{margin-top:auto;display:flex;gap:14px;align-items:center}
  .bk__price{margin:0;font-family:var(--mono,'JetBrains Mono',monospace);font-weight:700;font-size:20px;color:var(--ink)}
  .bk__price--free{color:#5fae7e}
  .guide-offer{background:var(--bg-3,#15110e);border:1px solid rgba(95,174,126,.5);border-radius:14px;padding:26px 28px;margin:30px 0 8px;display:flex;flex-direction:column;gap:10px}
  .guide-offer__h{font-family:var(--serif);font-weight:600;font-size:26px;margin:0}
  .guide-offer__p{margin:0;font-size:15px;line-height:1.55;color:var(--ink-2);max-width:70ch}
  .coming{border:1px dashed var(--line,#2a2521);border-radius:14px;padding:24px 28px;margin:22px 0 8px}
  .coming__badge{display:inline-block;font-family:var(--mono,'JetBrains Mono',monospace);font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:14px;background:rgba(0,0,0,.45);color:#fff;margin-bottom:10px}
  .coming__h{font-family:var(--serif);font-weight:600;font-size:24px;margin:0 0 2px}
  .coming__sub{font-size:14px;color:var(--ink-1);font-style:italic;margin:0 0 10px}
  .coming__p{margin:0;font-size:14.5px;line-height:1.55;color:var(--ink-2);max-width:70ch}
  .bk-faq{margin:26px auto 8px}
  .bk-faq__h{font-family:var(--serif);font-weight:600;font-size:26px;margin:0 0 14px}
  .bk-faq__item h3{font-size:16px;margin:14px 0 4px}
  .bk-faq__item p{margin:0;font-size:14.5px;line-height:1.55;color:var(--ink-2)}
  .bk-faq__item a{color:var(--accent,#e0563b)}
</style>
