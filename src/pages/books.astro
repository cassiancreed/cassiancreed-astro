---
import Base from '../layouts/Base.astro';
const books = [
  {
    title: "The Trail", series: "Case File 001", sub: "The Murder of Rachel Morin",
    hook: "A mother of five walked a familiar Maryland trail and never came home — and her killer sat in no database on earth. The complete account of the genetic-genealogy hunt that named him anyway.",
    status: "On sale", theme: "rust", price: "$1.99",
    cover: "/covers/the-trail.jpg",
    cardCover: "/covers/square-1x1.png",
    coverAlt: "Book cover of The Trail: The Murder of Rachel Morin by Cassian Creed — a wooded walking trail at twilight",
    buy: "https://cassiancreed.beehiiv.com/products/the-trail?utm_source=website&utm_medium=landing&utm_campaign=the_trail",
    buyAlt: null,
    sample: "/the-trail/",
    listen: "https://open.spotify.com/episode/6UJivvOBmuoYbMIJzqu67d"
  },
];
// Book schema for AI/search discoverability (Mantra rule 47). Offers only for live, buyable products.
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "Book",
    "@id": "https://cassiancreed.com/the-trail/#book",
    "name": "The Trail: The Murder of Rachel Morin",
    "alternateName": "Case File 001",
    "author": { "@id": "https://cassiancreed.com/#cassian-creed" },
    "publisher": { "@id": "https://cassiancreed.com/#org" },
    "url": "https://cassiancreed.com/the-trail/",
    "bookFormat": "https://schema.org/EBook",
    "inLanguage": "en-US",
    "genre": ["True Crime", "Nonfiction"],
    "abstract": "The full, sourced account of the August 2023 murder of Rachel Morin, a mother of five killed on the Ma & Pa Trail in Harford County, Maryland, and the international investigation that identified and convicted her killer. Rachel is named in life first; every claim is tied to the public record.",
    "offers": [
      { "@type": "Offer", "price": "1.99", "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://cassiancreed.beehiiv.com/products/the-trail", "seller": { "@id": "https://cassiancreed.com/#org" } }
    ]
  }
];
---
<Base title="True-Crime Ebooks — Real Cases, from $1.99 | Cassian Creed" description="Sourced, victim-first true-crime ebooks built on court records and verified reporting, each with a disclosed A.I. AL forensic analysis. From $1.99." jsonld={jsonld}>
  <section class="bk-hero wrap">
    <p class="evidence evidence--accent">The Book Library</p>
    <h1 class="bk-hero__h">The book runs the case through <span>A.I. AL</span>.</h1>
    <p class="bk-hero__p">The Cassian Creed book is a full-length, primary-source case file — the complete timeline, the records, and the people at the center, told victim-first and without gratuitous detail. It carries something the free web articles never will: an exclusive <strong>A.I. AL Case Analysis</strong>.</p>
  </section>

  <section class="wrap aial-strip" aria-label="What A.I. AL adds to the book">
    <div class="aial-strip__seal">A.I. AL</div>
    <div>
      <p class="aial-strip__k">Inside the book — and nowhere else</p>
      <p class="aial-strip__t">We run the case through the forensic <strong>X-modules</strong> — Timeline-X, Linkage-X, Evidence-X, Geo-X, Tip-Triage-X — then show, honestly, the insights an analytical lens could have surfaced and where it could have moved faster <em>alongside</em> investigators. It's a disclosed, human-overseen lens — never the narrator, never a claim it solved the case. <a href="/ai-al/">How A.I. AL works →</a></p>
    </div>
  </section>

  <div class="wrap"><div class="shelf">
    {books.map(b => (
      <div class={"bk bk--" + b.theme + (b.cardCover ? " bk--square" : "")}>
        {b.cover ? (
          <div class="bk__cover bk__cover--art">
            <span class={"bk__ribbon " + (b.price ? "bk__ribbon--live" : "bk__ribbon--soon")}>{b.status}</span>
          <img class="bk__img" src={b.cardCover || b.cover} alt={b.coverAlt} width="600" height={b.cardCover ? "600" : "900"} loading="lazy" />
          </div>
        ) : (
          <div class="bk__cover">
            <span class={"bk__ribbon " + (b.price ? "bk__ribbon--live" : "bk__ribbon--soon")}>{b.status}</span>
            <span class="bk__series">{b.series}</span>
            <span class="bk__ctitle">{b.title}</span>
            <span class="bk__csub">{b.sub}</span>
            <span class="bk__seal">A.I. AL<small>case analysis</small></span>
          </div>
        )}
        <div class="bk__meta">
          <p class="bk__hook">{b.hook}</p>
          <div class="bk__cta">
            {b.price && <a class="btn bk__buy" href={b.buy} target="_blank" rel="noopener noreferrer">Buy the ebook — {b.price} →</a>}
            {b.sample && <a class="bk__alt" href={b.sample}>Look inside (free sample) →</a>}
            {b.listen && <a class="bk__alt" href={b.listen} target="_blank" rel="noopener noreferrer">🎧 Listen to the companion episode →</a>}
            {!b.price && <a class="bk__alt bk__alt--soon" href="/#subscribe">Get notified when it drops →</a>}
          </div>
        </div>
      </div>
    ))}
  </div></div>

  <section class="wrap bk-trust">
    <p><strong>Why you can trust these.</strong> Written under the Cassian Creed byline for Neural Edge Publishing — every claim tied to a primary source, legal status re-verified before publish, and where a verdict is under appeal we say so. The analysis is A.I. AL: a disclosed, human-overseen lens, never the author or narrator. When we get something wrong, we correct it. <a href="/about/">Our standard &amp; corrections policy →</a></p>
  </section>

  <div class="wrap"><section class="subscribe" id="subscribe">
    <p class="evidence evidence--accent">The free newsletter</p>
    <h2>Subscribe free &mdash; get <em>How to Read a Case Like the Court Does</em></h2>
    <p>A charge isn&rsquo;t a conviction. A theory isn&rsquo;t proof. Subscribe and we&rsquo;ll send you <em>How to Read a Case Like the Court Does</em> &mdash; a plain-language framework for weighing evidence instead of guessing, the real difference between proof and speculation, and what a verdict actually settles (and what it doesn&rsquo;t). No weekly blast; unsubscribe anytime.</p>
    <form action="https://cassiancreed.beehiiv.com/subscribe" method="get" aria-label="Subscribe to the free Cassian Creed newsletter">
      <input type="email" name="email" required autocomplete="email" placeholder="you@email.com" aria-label="Your email address" />
      <input type="hidden" name="utm_source" value="website" />
      <input type="hidden" name="utm_medium" value="books_cta" />
      <input type="hidden" name="utm_campaign" value="lm_case_how-to-read-a-case" />
      <button class="btn" type="submit">Send me the free guide →</button>
    </form>
  </section></div>
</Base>

<style>
  .bk-hero{padding:8px 0 4px}
  .bk-hero__h{font-family:var(--serif);font-weight:600;font-size:clamp(28px,4.5vw,44px);line-height:1.08;margin:6px 0 12px}
  .bk-hero__h span{color:var(--accent,#e0563b)}
  .bk-hero__p{font-size:17px;line-height:1.5;color:var(--ink-1);max-width:62ch}
  .aial-strip{display:flex;gap:18px;align-items:center;margin:22px auto;padding:18px 22px;border:1px solid rgba(224,86,59,.35);border-radius:12px;background:linear-gradient(120deg,rgba(224,86,59,.10),rgba(224,86,59,.02))}
  .aial-strip__seal{flex:none;width:64px;height:64px;border-radius:50%;display:grid;place-items:center;font-family:var(--mono,'JetBrains Mono',monospace);font-weight:700;font-size:15px;letter-spacing:.04em;color:#fff;background:var(--accent,#e0563b);box-shadow:0 6px 18px rgba(224,86,59,.4)}
  .aial-strip__k{font-family:var(--mono,'JetBrains Mono',monospace);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent,#e0563b);margin:0 0 5px}
  .aial-strip__t{margin:0;font-size:15px;line-height:1.5}
  .aial-strip__t a{color:var(--accent,#e0563b);text-decoration:none;font-weight:600}
  .shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:26px;margin:8px 0}
  .bk{display:flex;flex-direction:column;background:var(--bg-2,#191512);border:1px solid var(--line,#2a2521);border-radius:14px;overflow:hidden;transition:transform .18s,box-shadow .18s}
  .bk:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(0,0,0,.45)}
  .bk__cover{position:relative;aspect-ratio:2/3;padding:22px 20px;display:flex;flex-direction:column;color:#f5efe8;isolation:isolate}
      .bk--square .bk__cover{aspect-ratio:1/1}
  .bk__cover--art{padding:0}
  .bk__img{display:block;width:100%;height:100%;object-fit:cover}
  .bk__cover::after{content:"";position:absolute;inset:0;z-index:-1;opacity:.9}
  .bk--rust .bk__cover{background:linear-gradient(150deg,#7a2417,#c9472b 55%,#e0563b)}
  .bk--steel .bk__cover{background:linear-gradient(150deg,#1f2b33,#33505f 60%,#4d7689)}
  .bk--ink .bk__cover{background:linear-gradient(150deg,#161616,#2c2c33 60%,#45454f)}
  .bk--moss .bk__cover{background:linear-gradient(150deg,#1c2a1f,#33503b 60%,#5fae7e)}
  .bk--slate .bk__cover{background:linear-gradient(150deg,#14171d,#2a3140 60%,#4a586b)}
  .bk__cover{box-shadow:inset 14px 0 24px -16px rgba(0,0,0,.6)}
  .bk__ribbon{position:absolute;top:14px;right:0;font-family:var(--mono,'JetBrains Mono',monospace);font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:14px 0 0 14px;color:#fff;backdrop-filter:blur(2px)}
  .bk__ribbon--live{background:rgba(95,174,126,.95);color:#0f1a12}
  .bk__ribbon--soon{background:rgba(0,0,0,.45)}
  .bk__series{font-family:var(--mono,'JetBrains Mono',monospace);font-size:11px;letter-spacing:.12em;text-transform:uppercase;opacity:.8}
  .bk__ctitle{font-family:var(--serif);font-weight:600;font-size:30px;line-height:1.05;margin-top:auto}
  .bk__csub{font-size:13.5px;opacity:.9;margin-top:8px;letter-spacing:.01em}
  .bk__seal{margin-top:16px;align-self:flex-start;display:flex;flex-direction:column;font-family:var(--mono,'JetBrains Mono',monospace);font-weight:700;font-size:13px;letter-spacing:.06em;padding:7px 11px;border:1px solid rgba(255,255,255,.55);border-radius:8px;line-height:1.1}
  .bk__seal small{font-weight:400;font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;opacity:.85;margin-top:3px}
  .bk__meta{padding:18px 20px 22px;display:flex;flex-direction:column;gap:14px;flex:1}
  .bk__hook{margin:0;font-size:14.5px;line-height:1.5;color:var(--ink-1)}
  .bk__cta{margin-top:auto;display:flex;flex-direction:column;gap:9px;align-items:flex-start}
  .bk__alt{font-size:13px;text-decoration:none;color:var(--ink-2)}
  .bk__alt:hover{color:var(--accent,#e0563b)}
  .bk__alt--soon{color:var(--accent,#e0563b);font-weight:600}
  .bk-bundle{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;margin:30px 0 8px;padding:22px 26px;border:1px solid rgba(95,174,126,.5);border-radius:14px;background:var(--bg-3,#15110e)}
  .bk-bundle__k{font-family:var(--mono,'JetBrains Mono',monospace);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#5fae7e;margin:0 0 4px}
  .bk-bundle__h{font-family:var(--serif);font-weight:600;font-size:24px;margin:0 0 6px}
  .bk-bundle__t{margin:0;font-size:15px;max-width:52ch}
  .bk-bundle__btn{flex:none}
  .bk-trust{margin:24px auto 8px}
  .bk-trust p{font-size:14px;line-height:1.55;color:var(--ink-2)}
  .bk-trust a{color:var(--accent,#e0563b);text-decoration:none}
</style>
