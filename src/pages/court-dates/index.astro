---
import Base from '../../layouts/Base.astro';
const pages = [
  ['/court-dates/luigi-mangione/', "When is Luigi Mangione's next court date?"],
  ['/court-dates/karen-read/', "When is Karen Read's next court date?"],
  ['/court-dates/tyler-robinson/', "When is Tyler Robinson's next court date?"],
  ['/court-dates/matthew-farwell/', "When is Matthew Farwell's sentencing?"],
  ['/court-dates/yella-beezy/', 'Was Yella Beezy sentenced in the MO3 case?'],
];
---
<Base title="Next Court Dates by Case | Court Calendar" description="One page per live case: the next court date, the court, the time if it is known, and the sources. Each page reads from our checked Court Calendar.">
  <div class="wrap" style="max-width:760px;padding-block:2rem 3rem">
    <h1>Next court dates by case</h1>
    <p>Each page answers one question about one case. Every date comes from the same checked record as the <a href="/court-calendar/">Court Calendar</a>.</p>
    <ul>{pages.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
  </div>
</Base>
