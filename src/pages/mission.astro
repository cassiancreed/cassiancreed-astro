---
import Base from '../layouts/Base.astro';
const principles = [
 { title:"Victims first, always", body:"Every case file leads with the people who were harmed — their names, their lives, and what was taken. We do not center perpetrators or trade in the spectacle of violence." },
 { title:"The record, not the rumor", body:"We build only on the public record: court filings, verdicts, official statements, and verified reporting. We separate what is proven from what is still disputed, and we say plainly when something is unknown." },
 { title:"Presumption of innocence", body:"Anyone who has not been convicted is presumed innocent. We use precise status labels — accused, charged, convicted, acquitted — and we never imply guilt the courts have not established." },
 { title:"Corrections in public", body:"When we get something wrong, we fix it and say so. The record changes as cases move; so does our work. Accuracy outranks being first." },
 { title:"Safety as the takeaway", body:"These cases are studied so readers understand what actually happened — and what helps people stay safe. Understanding, never voyeurism, is the goal." }
];
const jsonld = {
 "@context":"https://schema.org",
 "@type":"AboutPage",
 "name":"Our Mission — Cassian Creed",
 "url":"https://cassiancreed.com/mission/",
 "description":"Why Cassian Creed publishes true crime: victim-first, sourced from the public record, and committed to the presumption of innocence.",
 "isPartOf":{ "@id":"https://cassiancreed.com/#website" }
};
---
<Base title="Our Mission | Cassian Creed" description="Why we publish true crime: victim-first, sourced from the public record, presumption of innocence, and corrections in public. The principles behind every case file." jsonld={jsonld}>

<section class="ms-hero">
<p class="ms-kicker">Our Mission</p>
<h1>Why this work exists</h1>
<p class="ms-sub">True crime is too often told for the thrill of it. We tell it for the record — to name the people who were harmed, to trace what actually happened through the public record, and to leave readers with understanding instead of fear.</p>
</section>

<section class="ms-block">
<h2>What we stand for</h2>
<div class="ms-grid">
{principles.map((p, i) => (
<article class="ms-card">
<span class="ms-num">{String(i + 1).padStart(2, '0')}</span>
<h3>{p.title}</h3>
<p>{p.body}</p>
</article>
))}
</div>
</section>

<section class="ms-block ms-pledge">
<h2>The line we hold</h2>
<p>We are not the investigators, and we never pretend to be. The real work of justice belongs to detectives, forensic scientists, and the courts — and to the families who carry these cases long after the headlines fade. Our job is narrower and plainer: to read the public record carefully, tell it honestly, and keep the people at the center of each case in view.</p>
<p>If you have information about a crime, the right move is always to contact law enforcement directly — never us.</p>
<p class="ms-foot">Questions about our method or a correction? <a href="/about/">Read how the case files are made</a> or <a href="/living-edition/">see what we're tracking now</a>.</p>
</section>

</Base>

<style>
.ms-hero{max-width:760px;margin:0 auto;padding:3.5rem 1.25rem 1rem;text-align:center}
.ms-kicker{text-transform:uppercase;letter-spacing:.18em;font-size:.78rem;color:#9a6a3a;margin:0 0 .5rem}
.ms-hero h1{font-size:2.6rem;line-height:1.1;margin:0 0 1rem}
.ms-sub{font-size:1.14rem;line-height:1.6;color:#444;margin:0 auto;max-width:620px}
.ms-block{max-width:900px;margin:0 auto;padding:2.25rem 1.25rem}
.ms-block h2{font-size:1.7rem;margin:0 0 1.5rem;text-align:center}
.ms-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.1rem}
.ms-card{border:1px solid #e7e0d6;border-radius:12px;padding:1.4rem;background:#fff;position:relative}
.ms-num{display:block;font-size:.95rem;font-weight:700;color:#c9b79a;letter-spacing:.05em;margin-bottom:.4rem}
.ms-card h3{font-size:1.12rem;margin:0 0 .55rem;line-height:1.25}
.ms-card p{font-size:.96rem;line-height:1.55;color:#444;margin:0}
.ms-pledge{background:#faf7f2;border-radius:14px;max-width:820px}
.ms-pledge h2{text-align:left}
.ms-pledge p{font-size:1.04rem;line-height:1.65;color:#3a3a3a;margin:0 0 1rem}
.ms-foot{font-size:.95rem;color:#666}
.ms-foot a,.ms-pledge a{color:#9a6a3a}
@media(max-width:560px){.ms-hero h1{font-size:2rem}}
</style>
