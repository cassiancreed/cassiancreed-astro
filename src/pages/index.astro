---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import CaptureBlock from '../components/CaptureBlock.astro';
import HomeCourtCalendar from '../components/HomeCourtCalendar.astro';
const posts = (await getCollection('posts')).filter(p => !p.data.archived).sort((a,b)=> b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.find(p=>p.data.featured) || posts[0];
const rest = posts.filter(p=> featured && p.slug!==featured.slug && p.slug!=='nancy-guthrie-abduction-what-we-know').slice(0,8);
const cfCount = posts.filter(p=>p.data.tag==='Case Files').length;
const short = (t)=> t.split(':')[0];
const HOME_FORM_ID = '4d0df7d0-f274-4901-a457-091f80cecef0';
const HOME_OFFER_ID = 'case_how_to_read_a_case_v1';
// NEP-FIX-0824: normalized to the /v3/forms/ endpoint used by every other embed
// on the site (CaptureBlock, HomeCourtCalendar). The bare /<id> path is the
// legacy v2 alias; both resolve 200 but only one path should be in use.
const HOME_HERO_BASE = `https://subscribe-forms.beehiiv.com/v3/forms/${HOME_FORM_ID}?utm_source=website&utm_medium=hero&utm_campaign=lm_case_how-to-read-a-case`;
// CONVERSION-FIRST RANK 1 (2026-07-28): the home shelf held exactly one entry,
// "The Trail", and the whole shop section below was written around it (its
// price, its cover, its "under $2" benefit copy). The title is held for
// worthiness review, so the entry and the section it fed were removed rather
// than left as an empty shelf. Recoverable from git history. /books/ is still
// reachable from the header nav and from the case-mechanics section.
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://cassiancreed.com/#website", "url": "https://cassiancreed.com/", "name": "Cassian Creed", "inLanguage": "en-US", "publisher": { "@id": "https://cassiancreed.com/#nep" } },
    { "@type": "Organization", "@id": "https://cassiancreed.com/#nep", "name": "Neural Edge Publishing", "url": "https://cassiancreed.com/", "brand": "Cassian Creed", "description": "An independent true-crime imprint publishing sourced, victim-first case files.", "sameAs": ["https://x.com/CassianCreed", "https://cassiancreed.beehiiv.com/"] },
    { "@type": "Book", "name": "Jury Chess: How Criminal Jury Trials Actually Work", "author": { "@id": "https://cassiancreed.com/#cassian-creed" }, "publisher": { "@id": "https://cassiancreed.com/#org" }, "bookFormat": "https://schema.org/EBook", "offers": { "@type": "Offer", "price": "5.99", "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://cassiancreed.beehiiv.com/products/jury-chess" } }
  ]
};
---
<Base title="Cassian Creed | Evidence-First, Victim-First True Crime" description="Read evidence-first case files built from court records and verified reporting—victims named in life first, disputed claims labeled, no gore or filler." jsonld={jsonld}>
  {/* CONVERSION-FIRST RANK 1 (2026-07-28): the orange "The Trail is $1.99"
      announcement bar that stood here was removed with the title. */}
  <section class="hero">
    <div class="wrap">
      <div class="hero__copy">
        <p class="evidence evidence--accent">Sourced true crime &middot; victim-first</p>
        <h1>True crime that respects the victims&mdash;and follows the record.</h1>
        <p class="hero__lede">Source-led case files and a court calendar updated as proceedings change. We name victims in life first, distinguish the record from analysis, and explain practical lessons only when the evidence supports them.</p>
        {/* SUPPORTED BEEHIIV EMBED (NEP-FIX-CWK-0718R). subscribe-forms.beehiiv.com
            is the v2 form-builder endpoint and renders the DASHBOARD styling
            (verified live: #A8503A button, "Get the free guide."). The native POST
            to /create shipped in 0718L returned 403 for real humans and captured
            ZERO subscribers — do not reinstate it. */}
        <p class="hero__offer">Get the free guide &mdash; we&rsquo;ll send you <strong><em>How to Read a Case Like the Court Does</em></strong> &mdash; a plain-language framework for weighing evidence instead of guessing.</p>
        <div class="hero__capture">
          <iframe
            class="hero__embed"
            src={HOME_HERO_BASE}
            data-nep-base-src={HOME_HERO_BASE}
            data-nep-campaign="lm_case_how-to-read-a-case"
            data-nep-conversion-page="/"
            data-nep-cta-id="home_hero"
            data-nep-form-id={HOME_FORM_ID}
            data-nep-offer-id={HOME_OFFER_ID}
            title="Get the free guide"
            loading="eager"
            scrolling="no"
            frameborder="0"
          ></iframe>
          <noscript><a class="btn" href={HOME_HERO_BASE}>Get the free guide &rarr;</a></noscript>
        </div>
        <p class="hero__fallback">Form not loading? <a href={HOME_HERO_BASE} target="_blank" rel="noopener noreferrer">Get the free guide &rarr;</a></p>
        <script is:inline>
          (function(){
            var iframe=document.querySelector('iframe.hero__embed'); if(!iframe)return;
            var o=window.NEP_ORIGIN||null;
            try{
              var u=new URL(iframe.getAttribute('data-nep-base-src'));
              if(o&&o.s){
                [['utm_source','s'],['utm_medium','m'],['utm_campaign','c'],['utm_content','u'],['utm_term','k']].forEach(function(pair){
                  var value=o[pair[1]]||'';
                  if(value){u.searchParams.set(pair[0],value);}else{u.searchParams.delete(pair[0]);}
                });
              }
              iframe.src=u.toString();
            }catch(e){iframe.src=iframe.getAttribute('data-nep-base-src');}

            function fire(name){
              if(typeof window.gtag!=='function')return;
              var a=window.NEP_ORIGIN||{};
              window.gtag('event',name,{
                page_path:location.pathname,
                origin_source:a.s||'(direct)',
                origin_medium:a.m||'(none)',
                origin_campaign:a.c||'(none)',
                origin_content:a.u||'(none)',
                origin_term:a.k||'(none)',
                origin_landing_page:a.p||'(unknown)',
                conversion_page:iframe.dataset.nepConversionPage,
                cta_id:iframe.dataset.nepCtaId,
                form_id:iframe.dataset.nepFormId,
                offer_id:iframe.dataset.nepOfferId
              });
            }
            fire('capture_view');
            var engaged=false;
            window.addEventListener('blur',function(){
              if(!engaged&&document.activeElement===iframe){engaged=true;fire('capture_form_engage');}
            });
            iframe.addEventListener('load',function(){
              var href=''; try{href=iframe.contentWindow.location.href;}catch(e){return;}
              if(href.indexOf('subscribed=1')!==-1){fire('capture_success');}
            });
          })();
        </script>
        <p class="hero__trust">Free forever &middot; unsubscribe anytime &middot; <a href="/start-here/">new here? start here &rarr;</a></p>
        <ul class="hero__chips" aria-label="What makes these case files different">
          <li>Sourced from the public record</li>
          <li>Victims named in life first</li>
          <li>Our A.I. AL forensic lens</li>
          <li>No gore, no filler</li>
        </ul>
      </div>
      <div class="hero__art" aria-hidden="true">
        <div class="dossier">
          <div class="dossier__card"><span class="dossier__k">Case File</span></div>
          <div class="dossier__card"><span class="dossier__k">Case File</span></div>
          <div class="dossier__card">
            <span class="dossier__k">Case File &middot; N&ordm; 001</span>
            <span class="dossier__stamp">Public Record</span>
            <p class="dossier__title">Sourced. Victim-first.</p>
            <div class="dossier__lines"><span></span><span></span><span></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <HomeCourtCalendar />

  <section class="genealogy-home wrap" aria-labelledby="genealogy-home-title">
    <div class="genealogy-home__signal" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="genealogy-home__copy">
      <p class="evidence evidence--accent">A Cassian Creed specialty</p>
      <h2 id="genealogy-home-title">When DNA finds a family tree</h2>
      <p>Investigative genetic genealogy can restore a name, reopen a cold case, or point investigators toward someone who was never in a criminal database. Learn the science, follow the cases, and understand why the result is a lead—not a verdict.</p>
      <div class="genealogy-home__actions">
        <a class="btn" href="/genealogy/">Explore Genetic Genealogy →</a>
        <a class="genealogy-home__alt" href="/the-names-genetic-genealogy-gave-back/">The names it gave back →</a>
      </div>
    </div>
  </section>

  <section class="nmv wrap" aria-labelledby="record-without-blame">
    <h2 class="nmv__h" id="record-without-blame">What the record can teach us&mdash;without blaming the victim.</h2>
    <p class="nmv__copy">We do not publish cases as entertainment. When the public record supports a practical lesson, we explain the documented pattern and its limits. No case predicts another, and responsibility always belongs to the person who causes harm.</p>
    <p class="nmv__cta">
      <a class="btn nmv__btn" href="/safety/">Read Stay Safe &rarr;</a>
      <a class="nmv__alt" href="/safety/#immediate-help">Need help now? Real resources &rarr;</a>
    </p>
  </section>

  <section class="mission wrap" aria-label="Our mission">
    <p class="evidence">Why we do this</p>
    <p class="mission__line">We tell these stories to help the victims &mdash; and never to create new ones by helping send an innocent person to prison or ruin a life. That single rule shapes every case file: presumption of innocence, sources you can check, and people remembered as more than how they died.</p>
  </section>

  {featured && (
  <section class="wrap" aria-label="Featured case file">
    <a class="feature" href={`/post/${featured.slug}/`}>
      <div>
        <p class="evidence evidence--accent">Featured case file</p>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <span class="btn btn--ghost">Read the case &rarr;</span>
      </div>
      <div class="feature__cover"><span>{short(featured.data.title)}</span></div>
    </a>
  </section>
  )}

  <section class="wrap jury-home" aria-labelledby="jury-chess-title">
    <div class="jury-home__card">
      <a class="jury-home__cover" href="/books/#jury-chess" aria-label="Read about Jury Chess">
        <img src="/covers/jury-chess.jpg" alt="Cover of Jury Chess: How Criminal Jury Trials Actually Work by Cassian Creed" width="600" height="900" loading="lazy" decoding="async" />
      </a>
      <div class="jury-home__copy">
        <p class="evidence evidence--accent">The verified Cassian Creed book</p>
        <h2 id="jury-chess-title">Follow the evidence. Understand the verdict.</h2>
        <p class="jury-home__title"><em>Jury Chess: How Criminal Jury Trials Actually Work</em></p>
        <p>A plain-language guide to burdens of proof, evidence rules, objections, jury instructions, deliberations, and the limits of the admitted record. Includes practical “Watch for This” exercises and 212 source notes.</p>
        <ul class="jury-home__proof" aria-label="What Jury Chess covers">
          <li>Separate evidence from argument</li>
          <li>Understand courtroom rulings</li>
          <li>Evaluate forensic claims carefully</li>
        </ul>
        <div class="jury-home__actions">
          <a class="btn" href="https://cassiancreed.beehiiv.com/products/jury-chess?utm_source=website&utm_medium=homepage&utm_campaign=jury_chess" target="_blank" rel="noopener noreferrer" data-book-key="jury-chess" data-cta-placement="homepage">Get <em>Jury Chess</em> — $5.99 &rarr;</a>
          <a class="btn btn--ghost" href="/books/#jury-chess">Book details &rarr;</a>
        </div>
        <p class="jury-home__trust">Secure checkout &middot; PDF download &middot; educational, not legal advice</p>
      </div>
    </div>
  </section>

  {/* CONVERSION-FIRST RANK 1 (2026-07-28): the home "Case Files Library" shop
      section stood here — section title, "The Trail is $1.99" lede, the
      six "Why buy the books" benefit tiles (including the "Under $2" price
      claim) and the one-card shelf that sold The Trail. The title is held
      for worthiness review, so the whole section was removed rather than
      left as an empty shelf or a price claim no live book meets. Fully
      recoverable from git history. */}

    <section class="wrap mechanics" id="case-mechanics" aria-label="Case mechanics">
      <div class="section-title">
        <span>Case mechanics</span>
        <span class="evidence">How the analysis works</span>
      </div>
      <p class="mechanics__lede">Every case file separates what the record proves from what is still open — and labels our own reading as analysis, never verdict. Here is the structure behind each one.</p>
      <div class="mechanics__grid">
        <div class="mechx mechx--known">
          <span class="mechx__tag">What we know</span>
          <p>Facts tied to the public record: court filings, verdicts, charging documents, and contemporaneous reporting — each one checkable.</p>
        </div>
        <div class="mechx mechx--open">
          <span class="mechx__tag">What we don't know</span>
          <p>Open questions and disputed points are named plainly. We show our confidence honestly instead of dressing a guess as a fact.</p>
        </div>
        <div class="mechx mechx--lens">
          <span class="mechx__tag">The A.I. AL lens</span>
          <p>A disclosed, human-overseen analytical read of timeline and evidence — built only from public sources. A lens for understanding, never a claim a case was solved.</p>
        </div>
      </div>
      <div class="matrix" role="table" aria-label="Sample evidence matrix">
        <div class="matrix__row matrix__row--head" role="row"><span role="columnheader">Evidence</span><span role="columnheader">Status</span><span role="columnheader">Weight</span></div>
        <div class="matrix__row" role="row"><span role="cell">Forensic genealogy ID</span><span role="cell" class="is-known">Court record</span><span role="cell">High</span></div>
        <div class="matrix__row" role="row"><span role="cell">Timeline reconstruction</span><span role="cell" class="is-known">Public filing</span><span role="cell">High</span></div>
        <div class="matrix__row" role="row"><span role="cell">Motive interpretation</span><span role="cell" class="is-open">Analysis</span><span role="cell">Contextual</span></div>
      </div>
      {/* CONVERSION-FIRST RANK 1 (2026-07-28): the sentence "The full evidence
          matrix and forensic walkthrough live inside each book's A.I. AL Case
          Analysis." was removed from the note below. With The Trail and The
          Frame held for worthiness review, "each book" resolves to the one
          live title, which carries no A.I. AL Case Analysis — the claim would
          have been false. No replacement wording was invented. */}
      <p class="mechanics__note">Sample structure shown for illustration. <a href="/about/">How our analysis works and its limits &rarr;</a></p>
      <a class="btn" href="/books/#jury-chess">See the courtroom framework in <em>Jury Chess</em> &rarr;</a>
    </section>

  <section class="wrap" aria-label="Free case files">
    <div class="section-title">
      <span>Read free first</span>
      <span class="evidence">{cfCount} case files</span>
    </div>
    <div class="grid">
      <a class="card" href="/post/baby-boy-doe-mansfield-1985/"><div class="card__tile"><div class="tile__top"><span class="tile__no">New</span><span class="tile__tag">Case Files</span></div><h3 class="card__title">Baby Boy Doe — Mansfield, 1985</h3></div></a>
      {rest.map((p, i) => (
      <a class="card" href={`/post/${p.slug}/`}>
        <div class="card__tile">
          <div class="tile__top">
            <span class="tile__no">N&ordm; {String(i+1).padStart(2,'0')}</span>
            <span class="tile__tag">{p.data.tag}</span>
          </div>
          <h3 class="card__title">{short(p.data.title)}</h3>
        </div>
      </a>
      ))}
    </div>
  </section>

  <section class="wrap" aria-label="Try the voir dire simulator">
    <div class="subscribe">
      <p class="evidence evidence--accent">Interactive</p>
      <h2>Think you could seat a jury?</h2>
      <p>Question fictional jurors, argue challenges for cause, spend your peremptories &mdash; and try not to draw a Batson challenge. Our free Voir Dire Simulator turns jury selection into a five-minute education.</p>
      <p><a class="btn" href="/voir-dire-simulator/">Try the Voir Dire Simulator &rarr;</a></p>
    </div>
  </section>

    <section class="wrap author" aria-label="About the author">
      <div class="author__card">
        <p class="evidence evidence--accent">Who's behind the case files</p>
        <h2 class="author__name">Cassian Creed</h2>
        <p class="author__role">Author and independent case analyst, Neural Edge Publishing</p>
        <p class="author__bio">Cassian Creed writes victim-first true crime grounded in court records, official sources, and verified reporting. The work separates what is proven from what is disputed, names the people at the center in life first, and corrects what it gets wrong. A.I. AL is a disclosed, human-overseen analytical framework—not law enforcement, a forensic laboratory, or a substitute for the record.</p>
        <a class="btn btn--ghost" href="/about/">Read the method, sourcing &amp; corrections policy &rarr;</a>
      </div>
    </section>

  <section class="wrap" id="free-guide">
    <CaptureBlock offer="jury" content="home_footer" />
  </section>
</Base>

<style>
  .genealogy-home{position:relative;display:grid;grid-template-columns:minmax(220px,.68fr) 1.32fr;gap:42px;align-items:center;margin-top:34px;margin-bottom:18px;padding:38px;background:linear-gradient(135deg,#211713,#14110f 68%);border:1px solid rgba(224,86,59,.3);border-radius:14px;overflow:hidden}
  .genealogy-home::after{content:"";position:absolute;right:-90px;top:-110px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(224,86,59,.12),transparent 68%);pointer-events:none}
  .genealogy-home__signal{display:grid;gap:16px;padding:20px 0}
  .genealogy-home__signal span{display:block;height:2px;background:linear-gradient(90deg,transparent,var(--accent) 25%,rgba(224,86,59,.2));transform-origin:left}
  .genealogy-home__signal span:nth-child(1){width:72%}
  .genealogy-home__signal span:nth-child(2){width:94%;margin-left:6%}
  .genealogy-home__signal span:nth-child(3){width:80%;margin-left:18%}
  .genealogy-home__signal span:nth-child(4){width:100%}
  .genealogy-home__signal span:nth-child(5){width:66%;margin-left:28%}
  .genealogy-home__copy{position:relative;z-index:1}
  .genealogy-home h2{font-family:var(--serif);font-size:clamp(34px,4.5vw,52px);line-height:1;margin:8px 0 14px}
  .genealogy-home__copy>p:not(.evidence){max-width:64ch;color:var(--ink-2);margin:0 0 22px}
  .genealogy-home__actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center}
  .genealogy-home__alt{font-size:14px;color:var(--ink-2);border-bottom:1px solid var(--line)}
  .genealogy-home__alt:hover{color:var(--accent)}
  @media(max-width:720px){.genealogy-home{grid-template-columns:1fr;padding:26px;gap:12px}.genealogy-home__signal{max-width:260px;padding:0}.genealogy-home__actions .btn{width:100%;text-align:center}}

  .nmv{margin:34px auto 8px;padding:26px 28px;background:var(--bg-2);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:12px}
  .nmv__h{font-family:var(--serif);font-size:30px;font-weight:700;letter-spacing:.01em;text-transform:uppercase;margin:0 0 12px;color:var(--ink)}
  .nmv__copy{margin:0 0 18px;font-size:17px;line-height:1.6;color:var(--ink-2);max-width:70ch}
  .nmv__cta{display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin:0}
  .nmv__alt{color:var(--ink-2);font-size:15px;text-decoration:none;border-bottom:1px solid var(--line)}
  .nmv__alt:hover{color:var(--accent)}
  @media(max-width:640px){.nmv{padding:22px 20px}.nmv__h{font-size:25px}}

  .jury-home{padding-top:12px;padding-bottom:40px}
  .jury-home__card{display:grid;grid-template-columns:minmax(180px,280px) 1fr;gap:38px;align-items:center;padding:32px;background:linear-gradient(145deg,#211d20,#13100e 62%);border:1px solid rgba(232,93,61,.32);border-radius:14px;box-shadow:var(--shadow)}
  .jury-home__cover{display:block;border-radius:7px;overflow:hidden;box-shadow:0 26px 50px -22px rgba(0,0,0,.9);transition:transform .18s}
  .jury-home__cover:hover{transform:translateY(-4px)}
  .jury-home__cover img{display:block;width:100%;height:auto}
  .jury-home__copy h2{font-family:var(--serif);font-size:clamp(30px,4vw,44px);line-height:1.04;margin:8px 0 10px;max-width:15ch}
  .jury-home__title{font-size:17px;color:var(--ink);margin:0 0 12px}
  .jury-home__copy>p:not(.evidence):not(.jury-home__title):not(.jury-home__trust){color:var(--ink-2);max-width:62ch;margin:0 0 16px}
  .jury-home__proof{display:grid;gap:7px;list-style:none;margin:0 0 22px;padding:0;color:var(--ink-2);font-size:15px}
  .jury-home__proof li::before{content:"✓ ";color:var(--accent);font-weight:700}
  .jury-home__actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  .jury-home__trust{font-family:var(--mono);font-size:11px;letter-spacing:.04em;color:var(--ink-3);margin:14px 0 0}
  @media(max-width:700px){.jury-home__card{grid-template-columns:100px 1fr;gap:18px;padding:22px}.jury-home__copy h2{font-size:27px}.jury-home__cover{align-self:start}.jury-home__title,.jury-home__copy>p:not(.evidence):not(.jury-home__title):not(.jury-home__trust),.jury-home__proof,.jury-home__actions,.jury-home__trust{grid-column:1/-1}.jury-home__copy{display:contents}.jury-home__actions .btn{width:100%;text-align:center}}
  @media(prefers-reduced-motion:reduce){.jury-home__cover:hover{transform:none}}

  /* Native branded hero capture — replaces the Beehiiv iframe (no green button). */
</style>
