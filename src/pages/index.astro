---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).sort((a,b)=> b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.find(p=>p.data.featured) || posts[0];
const rest = posts.filter(p=> featured && p.slug!==featured.slug && p.slug!=='nancy-guthrie-abduction-what-we-know').slice(0,8);
const cfCount = posts.filter(p=>p.data.tag==='Case Files').length;
const short = (t)=> t.split(':')[0];
const books = [
  { title:"The Trail", series:"Case File 001", sub:"The Murder of Rachel Morin", theme:"rust", price:"$1.99", onsale:true, sample:"/the-trail/", cover:"/covers/the-trail.jpg", cardCover:"/covers/square-1x1.png", coverAlt:"Book cover of The Trail: The Murder of Rachel Morin", buy:"https://cassiancreed.beehiiv.com/products/the-trail?utm_source=website&utm_medium=home_shelf&utm_campaign=the_trail" },
];
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://cassiancreed.com/#website", "url": "https://cassiancreed.com/", "name": "Cassian Creed", "inLanguage": "en-US", "publisher": { "@id": "https://cassiancreed.com/#nep" } },
    { "@type": "Organization", "@id": "https://cassiancreed.com/#nep", "name": "Neural Edge Publishing", "url": "https://cassiancreed.com/", "brand": "Cassian Creed", "description": "An independent true-crime imprint publishing sourced, victim-first case files.", "sameAs": ["https://x.com/CassianCreed", "https://cassiancreed.beehiiv.com/"] }
  ]
};
---
<Base title="The Case Files of Cassian Creed" jsonld={jsonld}>
  <div class="trail-sale-bar" style="background:#e0563b;color:#fff;text-align:center;padding:10px 16px;font-size:15px;line-height:1.4" role="note">
The Trail is $1.99 — Rachel Morin's story, told with care. <a href="https://cassiancreed.beehiiv.com/products/the-trail?utm_source=website&utm_medium=announcement_bar&utm_campaign=the_trail_sale" style="color:#fff;font-weight:600;text-decoration:underline" target="_blank" rel="noopener noreferrer">Read it here →</a>
</div>
  <section class="hero">
    <div class="wrap">
      <div class="hero__copy">
        <p class="evidence evidence--accent">Sourced true crime &middot; victim-first</p>
        <h1>True crime that respects the victims.</h1>
        <p class="hero__lede">Full, primary-source case files for readers who want to understand cases, not consume them. Every victim named in life first &mdash; and with each one, what it teaches about keeping the people you love safe.</p>
        <form class="hero__capture" action="https://cassiancreed.beehiiv.com/subscribe" method="get" aria-label="Subscribe free to the Cassian Creed newsletter">
          <input type="email" name="email" required autocomplete="email" placeholder="you@email.com" aria-label="Your email address" />
          <input type="hidden" name="utm_source" value="website" />
          <input type="hidden" name="utm_medium" value="hero" />
          <input type="hidden" name="utm_campaign" value="jury_chess_game_guide" />
          <button class="btn" type="submit">Get the free guide &rarr;</button>
        </form>
        <p class="hero__trust">Free forever &middot; unsubscribe anytime &middot; <a href="/start-here/">new here? start here &rarr;</a></p>
        <ul class="hero__chips" aria-label="What makes these case files different">
          <li>Sourced from the public record</li>
          <li>Victims named in life first</li>
          <li>Our A.I. AL forensic lens</li>
          <li>No gore, no filler</li>
        </ul>
      </div>
      <div class="hero__art" aria-hidden="true">
        <div class="dossier">
          <div class="dossier__card"><span class="dossier__k">Case File</span></div>
          <div class="dossier__card"><span class="dossier__k">Case File</span></div>
          <div class="dossier__card">
            <span class="dossier__k">Case File &middot; N&ordm; 001</span>
            <span class="dossier__stamp">Public Record</span>
            <p class="dossier__title">Sourced. Victim-first.</p>
            <div class="dossier__lines"><span></span><span></span><span></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mission wrap" aria-label="Our mission">
    <p class="evidence">Why we do this</p>
    <p class="mission__line">We tell these stories to help the victims &mdash; and never to create new ones by helping send an innocent person to prison or ruin a life. That single rule shapes every case file: presumption of innocence, sources you can check, and people remembered as more than how they died.</p>
  </section>

  {featured && (
  <section class="wrap" aria-label="Latest case file">
    <a class="feature" href={`/post/${featured.slug}/`}>
      <div>
        <p class="evidence evidence--accent">Latest case file</p>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <span class="btn btn--ghost">Read the case &rarr;</span>
      </div>
      <div class="feature__cover"><span>{short(featured.data.title)}</span></div>
    </a>
  </section>
  )}

  <section class="wrap shop" aria-label="Buy the books">
    <div class="section-title">
      <span>The Case Files Library</span>
      <a class="evidence evidence--accent" href="/books/">All books &rarr;</a>
    </div>
<p class="shop__lede">A full-length, primary-source case file &mdash; carrying an exclusive A.I. AL Case Analysis you won't find in the free articles. The Trail is $1.99.</p>

<ul class="benefits" aria-label="Why buy the books">
  <li class="benefit">
    <span class="benefit__k">Exclusive analysis</span>
    <p class="benefit__t">Every book runs the case through <strong>A.I. AL</strong> &mdash; the forensic X-modules that surface insights the free articles never include.</p>
  </li>
  <li class="benefit">
    <span class="benefit__k">The complete case</span>
    <p class="benefit__t">Full timeline, primary-source records, and the people at the center &mdash; not a thread, not a recap. The whole story, in one place.</p>
  </li>
  <li class="benefit">
    <span class="benefit__k">Sourced &amp; verified</span>
    <p class="benefit__t">Every claim tied to the public record and re-checked before publish. Where a verdict is under appeal, we say so &mdash; and we correct what we get wrong.</p>
  </li>
  <li class="benefit">
    <span class="benefit__k">Read it your way</span>
    <p class="benefit__t">Instant ebook download, yours to keep. Under $2 &mdash; less than a coffee.</p>
  </li>
  <li class="benefit">
    <span class="benefit__k">Victim-first, no filler</span>
    <p class="benefit__t">Victims named in life first and remembered as more than how they died. No gore, no padding, no true-crime exploitation.</p>
  </li>
  <li class="benefit">
    <span class="benefit__k">Support the work</span>
    <p class="benefit__t">Buying directly funds independent, sourced reporting from Neural Edge Publishing &mdash; and the next case file.</p>
  </li>
</ul>
        <div class="shop__shelf">
      {books.map(b => (
        <div class={`shopbk shopbk--${b.theme}${b.cardCover ? ' shopbk--square' : ''}`}>
        <div class="shopbk__cover">
{b.cover && <img class="shopbk__img" src={b.cardCover || b.cover} alt={b.coverAlt} loading="lazy" />}
          <span class="shopbk__series">{b.series}</span>
                      {!b.cover && <span class="shopbk__title">{b.title}</span>}
            {!b.cover && <span class="shopbk__sub">{b.sub}</span>}
          <span class="shopbk__seal">A.I. AL</span>
        </div>
        <a class="btn shopbk__buy" href={b.buy}>Buy the ebook &mdash; {b.price} &rarr;</a>
      </div>
      ))}
    </div>
  </section>

    <section class="wrap mechanics" id="case-mechanics" aria-label="Case mechanics">
      <div class="section-title">
        <span>Case mechanics</span>
        <span class="evidence">How the analysis works</span>
      </div>
      <p class="mechanics__lede">Every case file separates what the record proves from what is still open — and labels our own reading as analysis, never verdict. Here is the structure behind each one.</p>
      <div class="mechanics__grid">
        <div class="mechx mechx--known">
          <span class="mechx__tag">What we know</span>
          <p>Facts tied to the public record: court filings, verdicts, charging documents, and contemporaneous reporting — each one checkable.</p>
        </div>
        <div class="mechx mechx--open">
          <span class="mechx__tag">What we don't know</span>
          <p>Open questions and disputed points are named plainly. We show our confidence honestly instead of dressing a guess as a fact.</p>
        </div>
        <div class="mechx mechx--lens">
          <span class="mechx__tag">The A.I. AL lens</span>
          <p>A disclosed, human-overseen analytical read of timeline and evidence — built only from public sources. A lens for understanding, never a claim a case was solved.</p>
        </div>
      </div>
      <div class="matrix" role="table" aria-label="Sample evidence matrix">
        <div class="matrix__row matrix__row--head" role="row"><span role="columnheader">Evidence</span><span role="columnheader">Status</span><span role="columnheader">Weight</span></div>
        <div class="matrix__row" role="row"><span role="cell">Forensic genealogy ID</span><span role="cell" class="is-known">Court record</span><span role="cell">High</span></div>
        <div class="matrix__row" role="row"><span role="cell">Timeline reconstruction</span><span role="cell" class="is-known">Public filing</span><span role="cell">High</span></div>
        <div class="matrix__row" role="row"><span role="cell">Motive interpretation</span><span role="cell" class="is-open">Analysis</span><span role="cell">Contextual</span></div>
      </div>
      <p class="mechanics__note">Sample structure shown for illustration. The full evidence matrix and forensic walkthrough live inside each book's A.I. AL Case Analysis. <a href="/about/">How our analysis works and its limits &rarr;</a></p>
      <a class="btn" href="/books/?utm_source=website&utm_medium=mechanics&utm_campaign=case_mechanics">See the depth in the books &rarr;</a>
    </section>

  <section class="wrap" aria-label="Free case files">
    <div class="section-title">
      <span>Read free first</span>
      <span class="evidence">{cfCount} case files</span>
    </div>
    <div class="grid">
      <a class="card" href="https://cassiancreed.beehiiv.com/p/baby-boy-doe-mansfield-1985" target="_blank" rel="noopener"><div class="card__tile"><div class="tile__top"><span class="tile__no">New</span><span class="tile__tag">Case Files</span></div><h3 class="card__title">Baby Boy Doe — Mansfield, 1985</h3></div></a>
      {rest.map((p, i) => (
      <a class="card" href={`/post/${p.slug}/`}>
        <div class="card__tile">
          <div class="tile__top">
            <span class="tile__no">N&ordm; {String(i+1).padStart(2,'0')}</span>
            <span class="tile__tag">{p.data.tag}</span>
          </div>
          <h3 class="card__title">{short(p.data.title)}</h3>
        </div>
      </a>
      ))}
    </div>
  </section>

    <section class="wrap author" aria-label="About the author">
      <div class="author__card">
        <p class="evidence evidence--accent">Who's behind the case files</p>
        <h2 class="author__name">Cassian Creed</h2>
        <p class="author__role">Author and independent case analyst, Neural Edge Publishing</p>
        <p class="author__bio">Cassian Creed writes victim-first true crime built entirely on the public record — court filings, verdicts, and verified reporting. The work separates what is proven from what is disputed, names the people at the center in life first, and corrects what it gets wrong. The analytical reads are produced with A.I. AL, a disclosed, human-overseen method that is not affiliated with law enforcement and never asserts the guilt of anyone not convicted.</p>
        <a class="btn btn--ghost" href="/about/">Read the method, sourcing &amp; corrections policy &rarr;</a>
      </div>
    </section>

  <section class="wrap" id="subscribe">
    <div class="subscribe">
      <p class="evidence evidence--accent">The free newsletter</p>
      <h2>Subscribe free &mdash; get <em>The Jury Chess Game</em></h2>
      <p>Subscribe and we&rsquo;ll send you <em>The Jury Chess Game</em> &mdash; our free field guide to how lawyers really pick the twelve people who decide guilt or innocence. After that, we only email when we&rsquo;ve shipped something new: a fresh case file or a book. No weekly blast; unsubscribe anytime.</p>
      <form action="https://cassiancreed.beehiiv.com/subscribe" method="get" aria-label="Subscribe free to the Cassian Creed newsletter">
        <input type="email" name="email" required autocomplete="email" placeholder="you@email.com" aria-label="Your email address" />
        <input type="hidden" name="utm_source" value="website" />
        <input type="hidden" name="utm_medium" value="home_cta" />
        <input type="hidden" name="utm_campaign" value="jury_chess_game_guide" />
        <button class="btn" type="submit">Send me the free guide &rarr;</button>
      </form>
    </div>
  </section>
</Base>
