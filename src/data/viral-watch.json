    ],
    "post_skip_patterns": ["dismember", "decapitat", "behead", "mutilat", "disembowel", "\\bgore\\b", "\\bgory\\b", "autopsy (photo|picture|image)s?", "crime scene (photo|picture|image)s?", "graphic (video|footage|image|photo)", "\\btortur", "\\brape", "sexual(ly)? (assault|abuse)", "molest", "burned alive", "\\bnsfw\\b"],
    "draft_block_patterns": ["\\bkillers?\\b", "\\bmurderers?\\b", "\\bmonsters?\\b", "\\bevil\\b", "\\btwisted\\b", "\\bsick(o|ening)?\\b", "\\bpsycho", "\\bsavage\\b", "\\bbutcher", "\\bslaughter", "rot in", "burn in hell", "deserves? (to die|death|the chair)", "\\bshocking\\b", "\\bhorrific\\b", "\\bgruesome\\b", "\\bbloody\\b", "\\bblood\\b", "stabbed", "strangled", "bludgeon", "dismember", "decapitat", "\\bgore\\b", "autopsy", "\\btortur"],
    "bait_patterns": ["\\bRT\\b", "\\bretweet", "\\brepost (this|if)", "like if", "\\blike this\\b", "\\bfollow (us|me|for|along)\\b", "\\bshare (this|if)\\b", "\\bthoughts\\?", "\\bagree\\?", "what do you think", "comment below", "drop a", "you won'?t believe", "must[- ]see", "link in bio", "\\bDM\\b", "check out", "\\bsubscribe\\b", "\\bclick\\b"],
    "_guilt_note": "Checked only when the calendar row does not record a conviction. Exact negatives such as \"pleaded not guilty\" or \"has not been convicted\" are removed before this check.",
    "guilt_patterns_unless_convicted": ["\\bguilty\\b", "\\bguilt\\b", "\\bconvicted\\b", "\\bconvictions?\\b", "\\bperpetrator\\b", "\\bculprit\\b"],
    "_block_list_note": "Block list, checked on the source post (skip) and on every draft (no alert). Whole-word, case-insensitive. block_words are plain words and phrases (graphic violence and sexual words); tune freely, but do not add words that are ordinary in court news (murder, killed, shot, body) or common surnames. block_word_hashes are SHA-256 hashes of lowercase single words, so this public repo never spells out slurs. The seed list covers common English racial and ethnic, anti-LGBTQ, ableist and misogynist slurs, singular and plural; words that are also common surnames (for example Dyke, as in Van Dyke, or Coon) are left out so a real case is never silenced. Add one with: node -e \"console.log(require('crypto').createHash('sha256').update('word'.toLowerCase()).digest('hex'))\"",
