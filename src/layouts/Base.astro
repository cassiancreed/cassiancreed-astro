---
import '../styles/global.css';
export interface Props { title: string; description?: string; jsonld?: object; ogImage?: string; }
const { title, description = 'Sourced, victim-centered true-crime case files — what happened, and what it teaches about staying safe.', jsonld, ogImage = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImg = new URL(ogImage, Astro.site).href;
// Sitewide Organization + Person JSON-LD (AI discoverability, Mantra rule 47).
// @id anchors are referenced by Book/Article schema on individual pages.
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://cassiancreed.com/#org",
  "name": "Neural Edge Publishing",
  "alternateName": "NEP",
  "url": "https://cassiancreed.com/",
  "logo": "https://cassiancreed.com/favicon.svg",
  "description": "Independent publisher of sourced, victim-centered true-crime case files and plain-language forensic explainers under the Cassian Creed byline. Every account is built on the public record; the presumption of innocence is absolute.",
  "founder": { "@id": "https://cassiancreed.com/#cassian-creed" },
  "publishingPrinciples": "https://cassiancreed.com/about/",
  "correctionsPolicy": "https://cassiancreed.com/about/",
  "sameAs": [
    "https://x.com/CassianCreed",
    "https://cassiancreed.beehiiv.com",
    "https://creedcaster5.gumroad.com"
  ]
};
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://cassiancreed.com/#cassian-creed",
  "name": "Cassian Creed",
  "url": "https://cassiancreed.com/about/",
  "jobTitle": "Author and Independent Case Analyst",
  "worksFor": { "@id": "https://cassiancreed.com/#org" },
  "description": "True-crime author writing victim-first case files built on court records and verified reporting. Creator of the Case Files ebook series and The Living Edition newsletter. His work uses A.I. AL, a disclosed human-overseen analytical method, and never asserts the guilt of anyone not convicted.",
  "knowsAbout": [
    "true crime reporting",
    "forensic evidence analysis",
    "criminal trial coverage",
    "investigative timelines",
    "victim-centered storytelling"
  ],
  "sameAs": [ "https://x.com/CassianCreed" ]
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Cassian Creed" />
  <meta property="og:image" content={ogImg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@CassianCreed" />
  <meta name="twitter:image" content={ogImg} />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="alternate" type="application/rss+xml" title="Cassian Creed" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <!-- Google Analytics 4 (property: Neural Edge Publishing) -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-5D0DX6WFW4"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-5D0DX6WFW4');
  </script>
</head>
<body>
  <header class="site-head"><div class="site-head__inner">
    <a class="brand" href="/">Cassian<br/>Creed</a>
    <nav class="nav">
      <a href="/start-here/">Start Here</a>
              <a href="/case-files/">BLOG</a>
      <a href="/books/">Books</a>
                      <a href="/living-edition/">Living Edition</a>
<a href="/safety/">Stay Safe</a>
        <a href="/about/">About</a>
      <a href="/#subscribe">Subscribe</a>
    </nav>
  </div></header>
  <main><slot /></main>
  <footer class="site-foot"><div class="site-foot__inner">
    <span class="evidence">© 2026 Neural Edge Publishing</span>
    <span class="site-foot__note">Sourced · victim-centered · no gratuitous detail.</span>
            <span class="site-foot__social"><a href="/explainers/">Explainers</a> · <a href="/case-solver/">Case Solver</a> · <a href="/forensic-tools/">Forensic Tools</a> · <a href="/safety/">Stay Safe</a> · <a href="/support/">Support</a> · <a href="/mission/">Mission</a> · <a href="/about/">About</a> · <a href="https://x.com/CassianCreed">Follow on X</a> · <a href="https://cassiancreed.beehiiv.com/subscribe?utm_source=website&utm_medium=footer&utm_campaign=free_case_files">Free newsletter</a></span>
  </div></footer>
  <script is:inline>
  (function(){
    // Gumroad buy tracking — fires on any gumroad.com link click
    document.addEventListener('click',function(e){
      var a=e.target.closest('a');
      if(a&&a.href&&a.href.includes('gumroad.com')){
        if(typeof gtag!=='undefined'){
          gtag('event','buy_cta_click',{link_url:a.href});
          gtag('event','begin_checkout',{currency:'USD'});
        }
      }
    });
    // GA4 sign_up — fires when Beehiiv redirects to /?subscribed=1
    if(window.location.search.includes('subscribed=1')){
      function fs(){if(typeof gtag!=='undefined'){gtag('event','sign_up',{method:'beehiiv'});}}
      if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',fs);}else{fs();}
    }
  })();
  </script>
  <script is:inline>
  (function(){
    // Gumroad buy tracking
    document.addEventListener('click',function(e){
      var a=e.target.closest('a');
      if(a&&a.href&&a.href.includes('gumroad.com')){
        if(typeof gtag!=='undefined'){
          gtag('event','buy_cta_click',{link_url:a.href});
          gtag('event','begin_checkout',{currency:'USD'});
        }
      }
    });
    // GA4 sign_up — fires when Beehiiv redirects back with ?subscribed=1
    if(window.location.search.includes('subscribed=1')){
      function fs(){if(typeof gtag!=='undefined'){gtag('event','sign_up',{method:'beehiiv'});}}
      if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',fs);}else{fs();}
    }
  })();
  </script>
</body>
</html>
