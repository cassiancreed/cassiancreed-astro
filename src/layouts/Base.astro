---
import '../styles/global.css';
export interface Props { title: string; description?: string; jsonld?: object; ogImage?: string; }
const { title, description = 'Sourced, victim-centered true-crime case files — what happened, and what it teaches about staying safe.', jsonld, ogImage = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImg = new URL(ogImage, Astro.site).href;
// Sitewide Organization + Person JSON-LD (AI discoverability, Mantra rule 47).
// @id anchors are referenced by Book/Article schema on individual pages.
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://cassiancreed.com/#org",
  "name": "Neural Edge Publishing",
  "alternateName": "NEP",
  "url": "https://cassiancreed.com/",
  "logo": "https://cassiancreed.com/favicon.svg",
  "description": "Independent publisher of sourced, victim-centered true-crime case files and plain-language forensic explainers under the Cassian Creed byline. Every account is built on the public record; the presumption of innocence is absolute.",
  "founder": { "@id": "https://cassiancreed.com/#cassian-creed" },
  "publishingPrinciples": "https://cassiancreed.com/about/",
  "correctionsPolicy": "https://cassiancreed.com/about/",
  "sameAs": [
    "https://x.com/CassianCreed",
    "https://cassiancreed.beehiiv.com"
  ]
};
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://cassiancreed.com/#cassian-creed",
  "name": "Cassian Creed",
  "url": "https://cassiancreed.com/about/",
  "jobTitle": "Author and Independent Case Analyst",
  "worksFor": { "@id": "https://cassiancreed.com/#org" },
  "description": "True-crime author writing victim-first case files built on court records and verified reporting. Creator of the Case Files ebook series and its companion true-crime newsletter. His work uses A.I. AL, a disclosed human-overseen analytical method, and never asserts the guilt of anyone not convicted.",
  "knowsAbout": [
    "true crime reporting",
    "forensic evidence analysis",
    "criminal trial coverage",
    "investigative timelines",
    "victim-centered storytelling"
  ],
  "sameAs": [ "https://x.com/CassianCreed" ]
};

// Active-nav highlight (NEP-REV-CWK-0717AF): mark the current page's nav item so
// visitors always know where they are. .nav a.active styling already lives in global.css.
const navPath = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const navItems = [
  { href: '/',                      label: 'Home' },
  { href: '/start-here/',          label: 'Start Here' },
  { href: '/case-files/',          label: 'Case Files' },
  { href: '/guides/',              label: 'Guides' },
  { href: '/safety/',              label: 'Stay Safe' },
  { href: '/court-calendar/',      label: 'Court Calendar' },
  { href: '/voir-dire-simulator/', label: 'Jury Simulator' },
  { href: '/ai-al/',               label: 'A.I. AL' },
  // CONVERSION-FIRST RANK 1 (2026-07-28): the '/the-trail/' nav item was
  // removed with The Trail's landing page while the title is held for
  // worthiness review. /the-trail/ now 301s (see netlify.toml).
  { href: '/books/',               label: 'Books' },
  { href: '/about/',               label: 'About' },
  { href: '/books/#free-guide',     label: 'Free Guide' },
];
// NEP-CWK-IRASEMA-CONVERSION-RESCUE-0726 — CTA ROUTE REPAIR.
// On a post page the primary email CTA already lives on THIS page at
// `#free-guide` (see post/[slug].astro), but the nav item routed the visitor
// OFF the page to /books/#free-guide — i.e. the one always-visible, above-the-
// fold path to the primary conversion pushed people away from the case they
// came to read. On /post/* the item now targets the on-page anchor.
// No wording changed; link target only.
const isPostPage = navPath.startsWith('/post/');
const resolvedNav = navItems.map(i =>
  (isPostPage && i.href === '/books/#free-guide') ? { ...i, href: '#free-guide' } : i
);
// Standalone pages that are not themselves a nav item highlight their nav
// CATEGORY, so no page ever renders with zero highlighted nav item
// (NEP-FIX-CWK-0718L). Add new standalone pages here when they ship.
const NAV_CATEGORY = {
  // DNA / forensic-genealogy explainers + reference -> Guides
  '/how-dna-remembers':                    '/guides',
  '/how-forensic-genetic-genealogy-works': '/guides',
  '/how-othram-works-in-a-case':           '/guides',
  '/is-fgg-evidence-or-just-a-lead':       '/guides',
  '/is-forensic-genetic-genealogy-legal':  '/guides',
  '/codis-vs-forensic-genetic-genealogy':  '/guides',
  '/forensic-tools':                       '/guides',
  '/glossary':                             '/guides',
  '/checklist':                            '/guides',
  '/case-solver':                          '/guides',
  '/explainers':                           '/guides',
  // Individual case pages + roundups -> Case Files
  '/baby-jacob-round-lake-beach-genetic-genealogy': '/case-files',
  '/trending':                             '/case-files',
  // Org / identity pages -> About
  '/about-for-ai':                         '/about',
  '/mission':                              '/about',
  // Crisis + victim-support resources -> Stay Safe
  '/support':                              '/safety',
  // Post-signup thank-you: the reader is brand new -> Start Here
  '/subscribed':                           '/start-here',
};

// Homepage highlights the brand/home position instead of a nav item.
const homeActive = (navPath === '/');

function navActive(href){
  if (href.startsWith('/#') || href.startsWith('#')) return false; // in-page anchor, never "current page"
  const h = (href.replace(/\/+$/, '') || '/');   // '/' must survive the strip (AK5)
  if (navPath === h) return true;                    // exact page match
  if (h === '/case-files' && navPath.startsWith('/post/')) return true; // case/explainer posts live under Case Files
  if (NAV_CATEGORY[navPath] === h) return true;      // standalone page -> its category
  return false;
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Cassian Creed" />
  <meta property="og:image" content={ogImg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  <meta name="twitter:site" content="@CassianCreed" />
  <meta name="twitter:image" content={ogImg} />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="alternate" type="application/rss+xml" title="Cassian Creed" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" /></noscript>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <!-- Google Analytics 4 (property: Neural Edge Publishing) -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-5D0DX6WFW4"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-5D0DX6WFW4');
  </script>
  <!-- ───────────────────────────────────────────────────────────────────────
       ORIGIN CAPTURE — NEP-CWK-IRASEMA-CONVERSION-RESCUE-0726
       Problem this fixes: inbound campaign UTMs (e.g. a Spotify episode link
       carrying utm_source=spotify) were read by GA4 for the SESSION and then
       thrown away. They never reached the Beehiiv subscribe form, whose URL
       hard-codes utm_source=website — so a subscriber who arrived from Spotify
       was indistinguishable, inside Beehiiv, from one who arrived from anywhere
       else. And an inbound UTM was lost the moment the visitor clicked to a
       second page.
       What this does: stores FIRST-TOUCH origin for the session (first touch
       wins, so Spotify stays credited if the visitor wanders the site before
       subscribing), exposes it as window.NEP_ORIGIN for CaptureBlock to fold
       into the form's utm_content, and fires one explicit `origin_visit` event
       so campaign-origin visits are recoverable as an EVENT, not only as GA4
       session-source dimensions. No new analytics vendor; existing gtag only.
       ─────────────────────────────────────────────────────────────────────── -->
  <script is:inline>
  (function(){
    try{
      var q = new URLSearchParams(location.search);
      var inbound = {}, has = false;
      ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'].forEach(function(k){
        var v = q.get(k); if (v) { inbound[k] = v; has = true; }
      });
      var KEY = 'nep_origin', stored = null;
      try { stored = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch(e){}
      if (has && !stored) {
        stored = {
          s: inbound.utm_source   || '',
          m: inbound.utm_medium   || '',
          c: inbound.utm_campaign || '',
          p: location.pathname,
          t: Math.round(Date.now()/1000)
        };
        try { sessionStorage.setItem(KEY, JSON.stringify(stored)); } catch(e){}
      }
      window.NEP_ORIGIN = stored || null;
      if (has && typeof gtag === 'function') {
        gtag('event','origin_visit',{
          origin_source:   inbound.utm_source   || '(none)',
          origin_medium:   inbound.utm_medium   || '(none)',
          origin_campaign: inbound.utm_campaign || '(none)',
          page_path: location.pathname
        });
      }
    }catch(e){}
  })();
  </script>
</head>
<body>
  <header class="site-head"><div class="site-head__inner">
    <a class={homeActive ? "brand active" : "brand"} href="/" aria-current={homeActive ? "page" : undefined}>Cassian<br/>Creed</a>
    <nav class="nav" aria-label="Primary">
      {resolvedNav.map(i => (
        <a href={i.href} class={navActive(i.href) ? 'active' : undefined} aria-current={navActive(i.href) ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>
  </div></header>
  <main><slot /></main>
  <footer class="site-foot"><div class="site-foot__inner">
    <span class="evidence">© 2026 Neural Edge Publishing</span>
    <span class="site-foot__note">Sourced · victim-centered · no gratuitous detail.</span>
            <span class="site-foot__social"><a href="/explainers/">Explainers</a> · <a href="/guides/">Guides</a> · <a href="/glossary/">Glossary</a> · <a href="/case-solver/">Case Solver</a> · <a href="/forensic-tools/">Forensic Tools</a> · <a href="/safety/">Stay Safe</a> · <a href="/support/">Support</a> · <a href="/mission/">Mission</a> · <a href="/about/">About</a> · <a href="https://x.com/CassianCreed">Follow on X</a> · <a href="https://cassiancreed.beehiiv.com/subscribe?utm_source=website&utm_medium=footer&utm_campaign=lm_case_how-to-read-a-case">Free newsletter</a></span>
  </div></footer>
  <script is:inline>
  (function(){
// Beehiiv signup/subscribe outbound tracking (NEP-GA4FIX-CMT-0708A)
document.addEventListener('click',function(e){
var s=e.target.closest('a');
if(s&&s.href&&s.href.indexOf('cassiancreed.beehiiv.com')!==-1&&s.href.indexOf('/products/')===-1&&(s.href.indexOf('/subscribe')!==-1||s.href.indexOf('/signup')!==-1||s.href.indexOf('subscribed')!==-1)){
if(typeof gtag!=='undefined'){gtag('event','capture_outbound',{link_url:s.href,method:'beehiiv'});}
}
});
    // Beehiiv buy tracking — fires on any beehiiv.com product link click
    document.addEventListener('click',function(e){
      var a=e.target.closest('a');
      if(a&&a.href&&a.href.includes('cassiancreed.beehiiv.com/products/')){
        if(typeof gtag!=='undefined'){
          gtag('event','buy_cta_click',{link_url:a.href});
          gtag('event','begin_checkout',{currency:'USD'});
        }
      }
    });
    // GA4 sign_up — fires when Beehiiv redirects the top window to /?subscribed=1.
    // DG5 (NEP-OPS-CWK-0719SP): the SAME signal also reveals the styled
    // .capture__success panel and hides the now-redundant form + helper line,
    // so returning subscribers see "You're in." instead of Beehiiv's raw
    // in-iframe "Reference ID" text.
    if(window.location.search.includes('subscribed=1')){
      function fs(){
        if(typeof gtag!=='undefined'){gtag('event','sign_up',{method:'beehiiv'});}
        document.querySelectorAll('.capture__success').forEach(function(ok){
          ok.hidden=false;
          var cta=ok.closest('.capture-cta')||ok.parentNode;
          if(cta){cta.querySelectorAll('.capture__embed-window,.capture__embed,.capture__fallback,.capture__helper').forEach(function(el){el.hidden=true;});}
        });
      }
      if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',fs);}else{fs();}
    }
  })();
  </script>
<script>
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('.capture-cta a');
    if (a && typeof window.gtag === 'function') {
      window.gtag('event', 'subscribe_click', { link_url: a.href, page_path: location.pathname });
    }
  }, true);
</script>
</body>
</html>
