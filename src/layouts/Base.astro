---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  jsonld?: object;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  internalLinksOnly?: boolean;
}
const {
  title,
  description = 'Sourced, victim-centered true-crime case files — what happened, and what it teaches about staying safe.',
  jsonld,
  ogImage = '/og.png',
  ogType = 'website',
  noindex = false,
  internalLinksOnly = false,
} = Astro.props;
const BRAND = 'Cassian Creed';
const BRAND_SUFFIX = ` | ${BRAND}`;
// Page authors may pass an existing brand suffix while content is migrated.
// Normalize it, then spend the suffix only when the complete SERP title fits.
const baseTitle = title
  .trim()
  .replace(/\s*(?:\||—|-)\s*Cassian Creed$/i, '')
  .trim();
const titleAlreadyStartsWithBrand = /^Cassian Creed\b/i.test(baseTitle);
const proposedTitle = !titleAlreadyStartsWithBrand && baseTitle.length + BRAND_SUFFIX.length <= 60
  ? `${baseTitle}${BRAND_SUFFIX}`
  : baseTitle;
const shorten = (value: string, max: number) => {
  const clean = value.replace(/\s+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const candidate = clean.slice(0, max - 1);
  const boundary = candidate.lastIndexOf(' ');
  return `${candidate.slice(0, boundary > Math.floor(max * .65) ? boundary : max - 1).replace(/[,:;—\-\s]+$/, '')}…`;
};
// Search engines may rewrite title links, but concise, page-specific source
// titles are the strongest signal we control. Preserve the on-page H1 in full.
const renderedTitle = shorten(proposedTitle, 60);
const renderedDescription = shorten(description, 160);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImg = new URL(ogImage, Astro.site).href;
// Sitewide Organization + Person JSON-LD (AI discoverability, Mantra rule 47).
// @id anchors are referenced by Book/Article schema on individual pages.
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://cassiancreed.com/#org",
  "name": "Neural Edge Publishing",
  "alternateName": "NEP",
  "url": "https://cassiancreed.com/",
  "logo": "https://cassiancreed.com/favicon.svg",
  "description": "Independent publisher of source-led, victim-centered true-crime case files and plain-language forensic explainers under the Cassian Creed byline.",
  "founder": { "@id": "https://cassiancreed.com/#cassian-creed" },
  "publishingPrinciples": "https://cassiancreed.com/about/",
  "correctionsPolicy": "https://cassiancreed.com/about/",
  "sameAs": [
    "https://x.com/CassianCreed",
    "https://www.tiktok.com/@cassiancreed",
    "https://cassiancreed.beehiiv.com"
  ]
};
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://cassiancreed.com/#cassian-creed",
  "name": "Cassian Creed",
  "url": "https://cassiancreed.com/about/",
  "jobTitle": "Author and Independent Case Analyst",
  "worksFor": { "@id": "https://cassiancreed.com/#org" },
  "description": "True-crime author writing victim-first case files grounded in court records, official sources, and verified reporting. His work uses A.I. AL, a disclosed human-overseen analytical framework that separates evidence from inference.",
  "knowsAbout": [
    "true crime reporting",
    "forensic evidence analysis",
    "criminal trial coverage",
    "investigative timelines",
    "victim-centered storytelling"
  ],
  "sameAs": [
    "https://x.com/CassianCreed",
    "https://www.tiktok.com/@cassiancreed"
  ]
};

// Active-nav highlight (NEP-REV-CWK-0717AF): mark the current page's nav item so
// visitors always know where they are. .nav a.active styling already lives in global.css.
const navPath = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const navItems = [
  { href: '/',                      label: 'Home' },
  { href: '/court-calendar/',      label: 'Court Calendar' },
  { href: '/missing-persons/',     label: 'Missing Persons' },
  { href: '/genealogy/',           label: 'Genealogy' },
  { href: '/start-here/',          label: 'Start Here' },
  { href: '/case-files/',          label: 'Blog' },
  { href: '/guides/',              label: 'Guides' },
  { href: '/artwork/',             label: 'Artwork' },
  { href: '/safety/',              label: 'Stay Safe' },
  { href: '/voir-dire-simulator/', label: 'Jury Simulator' },
  { href: '/ai-al/',               label: 'A.I. AL' },
  // CONVERSION-FIRST RANK 1 (2026-07-28): the '/the-trail/' nav item was
  // removed with The Trail's landing page while the title is held for
  // worthiness review. /the-trail/ now 301s (see netlify.toml).
  { href: '/books/',               label: 'Jury Chess' },
  { href: '/about/',               label: 'About' },
  { href: '/#free-guide',           label: 'Court Updates', cta: true },
];
const desktopPrimary = [
  { href: '/court-calendar/', label: 'Court Calendar' },
  { href: '/missing-persons/', label: 'Missing Persons' },
  { href: '/genealogy/', label: 'Genealogy' },
  { href: '/case-files/', label: 'Case Files' },
  { href: '/books/', label: 'Jury Chess' },
  { href: '/#free-guide', label: 'Court Updates', cta: true },
];
const exploreItems = [
  { href: '/start-here/', label: 'Start Here' },
  { href: '/guides/', label: 'Guides' },
  { href: '/artwork/', label: 'Artwork Library' },
  { href: '/safety/', label: 'Stay Safe' },
  { href: '/voir-dire-simulator/', label: 'Jury Simulator' },
  { href: '/ai-al/', label: 'A.I. AL' },
  { href: '/about/', label: 'About' },
];
// NEP-CWK-IRASEMA-CONVERSION-RESCUE-0726 — CTA ROUTE REPAIR.
// On a post page the primary email CTA already lives on THIS page at
// `#free-guide` (see post/[slug].astro), but the nav item routed the visitor
// OFF the page to /books/#free-guide — i.e. the one always-visible, above-the-
// fold path to the primary conversion pushed people away from the case they
// came to read. On /post/* the item now targets the on-page anchor.
// No wording changed; link target only.
const isPostPage = navPath.startsWith('/post/');
const resolvedNav = navItems.map(i =>
  (isPostPage && i.href === '/#free-guide') ? { ...i, href: '#free-guide' } : i
);
const resolveItem = (i) =>
  (isPostPage && i.href === '/#free-guide') ? { ...i, href: '#free-guide' } : i;
const resolvedDesktopPrimary = desktopPrimary.map(resolveItem);
const resolvedExplore = exploreItems.map(resolveItem);
// Standalone pages that are not themselves a nav item highlight their nav
// CATEGORY, so no page ever renders with zero highlighted nav item
// (NEP-FIX-CWK-0718L). Add new standalone pages here when they ship.
const NAV_CATEGORY = {
  // DNA / forensic-genealogy explainers + reference -> Genealogy
  '/how-dna-remembers':                              '/genealogy',
  '/how-forensic-genetic-genealogy-works':           '/genealogy',
  '/the-five-steps-of-forensic-genetic-genealogy':   '/genealogy',
  '/the-names-genetic-genealogy-gave-back':          '/genealogy',
  '/how-othram-works-in-a-case':                     '/genealogy',
  '/is-fgg-evidence-or-just-a-lead':                 '/genealogy',
  '/is-forensic-genetic-genealogy-legal':            '/genealogy',
  '/codis-vs-forensic-genetic-genealogy':            '/genealogy',
  '/the-dna-privacy-checklist':                      '/genealogy',
  '/database-permission-comparison':                 '/genealogy',
  '/whose-consent-travels-across-borders':           '/genealogy',
  '/forensic-tools':                       '/guides',
  '/glossary':                             '/guides',
  '/checklist':                            '/guides',
  '/case-solver':                          '/guides',
  '/explainers':                           '/guides',
  // Individual case pages + roundups -> Case Files
  '/baby-jacob-round-lake-beach-genetic-genealogy': '/case-files',
  '/trending':                             '/case-files',
  // Org / identity pages -> About
  '/about-for-ai':                         '/about',
  '/mission':                              '/about',
  // Crisis + victim-support resources -> Stay Safe
  '/support':                              '/safety',
  // Post-signup thank-you: the reader is brand new -> Start Here
  '/subscribed':                           '/start-here',
};

// Homepage highlights the brand/home position instead of a nav item.
const homeActive = (navPath === '/');

function navActive(href){
  if (href.startsWith('/#') || href.startsWith('#')) return false; // in-page anchor, never "current page"
  const h = (href.replace(/\/+$/, '') || '/');   // '/' must survive the strip (AK5)
  if (navPath === h) return true;                    // exact page match
  if (h === '/case-files' && navPath.startsWith('/post/')) return true; // case/explainer posts live under Case Files
  if (NAV_CATEGORY[navPath] === h) return true;      // standalone page -> its category
  return false;
}
const exploreActive = resolvedExplore.some(i => navActive(i.href));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{renderedTitle}</title>
  <meta name="description" content={renderedDescription} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <meta name="theme-color" content="#14110f" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={renderedTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Cassian Creed" />
  <meta property="og:image" content={ogImg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={renderedTitle} />
  <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={renderedTitle} />
    <meta name="twitter:description" content={description} />
  <meta name="twitter:site" content="@CassianCreed" />
  <meta name="twitter:image" content={ogImg} />
  <meta name="twitter:image:alt" content={renderedTitle} />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="alternate" type="application/rss+xml" title="Cassian Creed" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" /></noscript>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <!-- Google Analytics 4 (property: Neural Edge Publishing) -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-5D0DX6WFW4"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-5D0DX6WFW4');
  </script>
  <!-- ───────────────────────────────────────────────────────────────────────
       ORIGIN CAPTURE — NEP-CWK-IRASEMA-CONVERSION-RESCUE-0726
       Problem this fixes: inbound campaign UTMs (e.g. a Spotify episode link
       carrying utm_source=spotify) were read by GA4 for the SESSION and then
       thrown away. They never reached the Beehiiv subscribe form, whose URL
       hard-codes utm_source=website — so a subscriber who arrived from Spotify
       was indistinguishable, inside Beehiiv, from one who arrived from anywhere
       else. And an inbound UTM was lost the moment the visitor clicked to a
       second page.
       What this does: stores FIRST-TOUCH acquisition for the session (first
       touch wins, so Spotify stays credited if the visitor wanders the site
       before subscribing), exposes it as window.NEP_ORIGIN for the homepage
       hero and CaptureBlock to forward without rewriting it as "website", and
       fires one explicit `origin_visit` event. Conversion page/CTA/form/offer
       identity is carried separately in data attributes and GA4 parameters.
       No new analytics vendor; existing gtag only.
       ─────────────────────────────────────────────────────────────────────── -->
  <script is:inline>
  (function(){
    try{
      var q = new URLSearchParams(location.search);
      var inbound = {}, has = false;
      ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'].forEach(function(k){
        var v = q.get(k); if (v) { inbound[k] = v; has = true; }
      });
      var KEY = 'nep_origin', stored = null;
      try { stored = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch(e){}
      if (has && !stored) {
        stored = {
          s: inbound.utm_source   || '',
          m: inbound.utm_medium   || '',
          c: inbound.utm_campaign || '',
          u: inbound.utm_content  || '',
          k: inbound.utm_term     || '',
          p: location.pathname,
          t: Math.round(Date.now()/1000)
        };
        try { sessionStorage.setItem(KEY, JSON.stringify(stored)); } catch(e){}
      }
      window.NEP_ORIGIN = stored || null;
      if (has && typeof gtag === 'function') {
        gtag('event','origin_visit',{
          origin_source:   inbound.utm_source   || '(none)',
          origin_medium:   inbound.utm_medium   || '(none)',
          origin_campaign: inbound.utm_campaign || '(none)',
          origin_content:  inbound.utm_content  || '(none)',
          origin_term:     inbound.utm_term     || '(none)',
          origin_landing_page: location.pathname,
          page_path: location.pathname
        });
      }
    }catch(e){}
  })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="site-head"><div class="site-head__inner">
    <a class={homeActive ? "brand active" : "brand"} href="/" aria-current={homeActive ? "page" : undefined}>Cassian<br/>Creed</a>
    <nav class="nav nav--desktop" aria-label="Primary">
      {resolvedDesktopPrimary.slice(0, 3).map(i => (
        <a href={i.href} class={navActive(i.href) ? 'active' : undefined} aria-current={navActive(i.href) ? 'page' : undefined}>{i.label}</a>
      ))}
      <details class="nav__explore">
        <summary class={exploreActive ? 'active' : undefined}>More</summary>
        <div class="nav__panel">
          {resolvedExplore.map(i => (
            <a href={i.href} class={navActive(i.href) ? 'active' : undefined} aria-current={navActive(i.href) ? 'page' : undefined}>{i.label}</a>
          ))}
        </div>
      </details>
      {resolvedDesktopPrimary.slice(3).map(i => (
        <a href={i.href} class:list={[navActive(i.href) && 'active', i.cta && 'nav__cta']} aria-current={navActive(i.href) ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>
    <details class="nav-menu">
      <summary>Menu</summary>
      <nav class="nav-menu__panel" aria-label="Mobile primary">
        {resolvedNav.map(i => (
          <a href={i.href} class:list={[navActive(i.href) && 'active', i.cta && 'nav__cta']} aria-current={navActive(i.href) ? 'page' : undefined}>{i.label === 'Books' ? 'Jury Chess' : i.label}</a>
        ))}
      </nav>
    </details>
  </div></header>
  <main id="main-content" tabindex="-1"><slot /></main>
  <footer class="site-foot"><div class="site-foot__inner">
    <span class="evidence">© 2026 Neural Edge Publishing</span>
    <span class="site-foot__note">Sourced · victim-centered · no gratuitous detail.</span>
            <span class="site-foot__social"><a href="/missing-persons/">Missing Persons</a> · <a href="/genealogy/">Genealogy</a> · <a href="/explainers/">Explainers</a> · <a href="/guides/">Guides</a> · <a href="/glossary/">Glossary</a> · <a href="/case-solver/">Case Solver</a> · <a href="/forensic-tools/">Forensic Tools</a> · <a href="/safety/">Stay Safe</a> · <a href="/support/">Support</a> · <a href="/mission/">Mission</a> · <a href="/about/">About</a>{internalLinksOnly ? <> · Follow on X · Follow on TikTok · Free newsletter</> : <> · <a href="https://x.com/CassianCreed">Follow on X</a> · <a href="https://www.tiktok.com/@cassiancreed">Follow on TikTok</a> · <a href="/#free-guide">Free newsletter</a></>}</span>
  </div></footer>
  <script is:inline>
  (function(){
    // Preserve CassianCreed.com whenever a visitor follows an external source,
    // social profile, Beehiiv subscription fallback, or book checkout. Internal
    // links keep normal same-tab navigation. This also protects future links.
    document.querySelectorAll('a[href]').forEach(function(a){
      try {
        var u = new URL(a.getAttribute('href'), location.href);
        if ((u.protocol === 'http:' || u.protocol === 'https:') && u.origin !== location.origin) {
          a.target = '_blank';
          var rel = new Set((a.getAttribute('rel') || '').split(/\s+/).filter(Boolean));
          rel.add('noopener');
          rel.add('noreferrer');
          a.setAttribute('rel', Array.from(rel).join(' '));
        }
      } catch(e) {}
    });
// Beehiiv signup/subscribe outbound tracking (NEP-GA4FIX-CMT-0708A)
document.addEventListener('click',function(e){
var s=e.target.closest('a');
if(s&&s.href&&s.href.indexOf('cassiancreed.beehiiv.com')!==-1&&s.href.indexOf('/products/')===-1&&(s.href.indexOf('/subscribe')!==-1||s.href.indexOf('/signup')!==-1||s.href.indexOf('subscribed')!==-1)){
if(typeof gtag!=='undefined'){gtag('event','capture_outbound',{link_url:s.href,method:'beehiiv'});}
}
});
    // Beehiiv buy tracking — fires on any beehiiv.com product link click
    document.addEventListener('click',function(e){
      var a=e.target.closest('a');
      if(a&&a.href&&a.href.includes('cassiancreed.beehiiv.com/products/')){
        if(typeof gtag!=='undefined'){
          gtag('event','buy_cta_click',{
            link_url:a.href,
            page_path:location.pathname,
            book_key:a.dataset.bookKey||'(not_set)',
            cta_placement:a.dataset.ctaPlacement||'(not_set)'
          });
          gtag('event','begin_checkout',{currency:'USD'});
        }
      }
    });
  })();
  </script>
<script>
  import { initBeehiivParentSignup } from '../scripts/beehiiv-parent-signup.mjs';
  initBeehiivParentSignup();
</script>
<script>
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('.capture-cta a');
    if (a && typeof window.gtag === 'function') {
      window.gtag('event', 'subscribe_click', { link_url: a.href, page_path: location.pathname });
    }
  }, true);
</script>
</body>
</html>
